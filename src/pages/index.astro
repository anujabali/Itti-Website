<script>
	/**
	 * The arc, driven by which slide you are on.
	 *
	 * Nothing here reads a scroll offset. An observer says which screen is in
	 * front of the reader; everything else is a fixed-duration CSS transition
	 * that starts when that answer changes. So the dissolve takes the same time
	 * whether the page was nudged or flung, which is what the old arc could not
	 * do — it welded the fade to the scroll position, and the rate it faded at
	 * was whatever rate the page happened to be moving.
	 *
	 * The pictures are stacked with the first on top and are all opaque. Fading
	 * one out reveals the one already behind it rather than opening a gap, which
	 * is why a hand-over never shows black.
	 */
	const slides = [...document.querySelectorAll<HTMLElement>('[data-arc-slide]')];
	const layers = [...document.querySelectorAll<HTMLElement>('[data-layer]')];

	// Decode every plate before the arc can need one. Fetching is not enough: a
	// picture that has arrived but not been decoded is decoded the first time it
	// is painted, and for these that moment is the middle of a dissolve.
	for (const img of document.querySelectorAll<HTMLImageElement>('.mv__plate img')) {
		img.decode?.().catch(() => {});
	}

	if (slides.length && layers.length) {
		let current = -1;

		const show = (index: number) => {
			if (index === current) return;
			current = index;
			const plate = Number(slides[index]!.dataset.plate ?? 0);

			slides.forEach((slide, i) => slide.toggleAttribute('data-on', i === index));

			layers.forEach((layer, i) => {
				// Everything before the wanted picture is faded out; the wanted one
				// is solid.
				layer.toggleAttribute('data-gone', i < plate);
				layer.toggleAttribute('data-on', i === plate);
				// Pictures still ahead are taken out of the paint entirely. Each
				// layer carries its own vignette, and three of those stacked
				// multiply into a nearly black frame even though the picture on top
				// is fully opaque.
				layer.toggleAttribute('data-ahead', i > plate);
				const label = layer.querySelector<HTMLElement>('[data-label]');
				if (label) {
					// A faded credit is still a tab stop and still read aloud, so it
					// leaves both while its picture is not the one on screen.
					label.inert = i !== plate;
				}
			});
		};

		// Whichever slide holds the middle of the screen is the one in front of
		// the reader. A band rather than a line, so a slide that is merely passing
		// cannot claim it.
		const watcher = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) show(slides.indexOf(entry.target as HTMLElement));
				}
			},
			{ rootMargin: '-45% 0px -45% 0px', threshold: 0 },
		);

		for (const slide of slides) watcher.observe(slide);

		// Whatever is under the middle when the page opens — which is the first
		// slide on a fresh load, and the right one after a reload part-way down.
		const settle = () => {
			const middle = window.innerHeight / 2;
			let found = 0;
			slides.forEach((slide, i) => {
				const r = slide.getBoundingClientRect();
				if (r.top <= middle && r.bottom > middle) found = i;
				else if (r.bottom <= middle) found = Math.max(found, i);
			});
			show(found);
		};
		settle();
		window.addEventListener('resize', settle);
		// The observer is the mechanism; this is the guarantee. Deciding which
		// slide holds the middle is four rectangle reads and no writes unless the
		// answer changed, so it is safe to ask on every scroll — and it means a
		// browser that throttles or coalesces observer callbacks still hands over
		// at the right moment. Nothing here is scroll-*linked*: the answer is a
		// slide number, and everything that follows from it is a fixed-duration
		// transition.
		document.addEventListener('scroll', settle, { passive: true });
	}
</script>
