<script>
	/** Sections arrive as they are reached, and each releases once. */
	const revealing = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (revealing.length > 0 && !still && 'IntersectionObserver' in window) {
		for (const el of revealing) el.classList.add('is-armed');

		const watcher = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					// Panels in the same row follow each other rather than landing
					// together, which reads as one movement instead of eight.
					const peers = [...(el.parentElement?.children ?? [])].filter(
						(n) => (n as HTMLElement).dataset?.reveal !== undefined,
					);
					const place = peers.indexOf(el);
					if (peers.length > 1 && place > 0) {
						el.style.setProperty('--delay', `${Math.min(place, 6) * 70}ms`);
					}
					el.classList.add('is-in');
					watcher.unobserve(el);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
		);

		for (const el of revealing) watcher.observe(el);
	}
</script>
