	/* ══ Arrival ══════════════════════════════════════════════════════════════ */

	/* The armed state is added by script, never by the stylesheet, so a reader
	   without JavaScript gets the whole page rather than a blank one. The
	   transition is declared here rather than on the arrival: an element that
	   gains its transition in the same class change that moves it is not
	   reliably animated. */
	[data-reveal].is-armed {
		opacity: 0;
		translate: 0 1.25rem;
		transition:
			opacity 700ms var(--ease),
			translate 700ms var(--ease);
		transition-delay: var(--delay, 0ms);
	}

	[data-reveal].is-armed.is-in {
		opacity: 1;
		translate: none;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-reveal].is-armed,
		[data-reveal].is-armed.is-in {
			opacity: 1;
			translate: none;
			transition: none;
		}

		.good__link,
		.good__link:hover,
		.btn,
		.btn:hover {
			transition: none;
			transform: none;
		}
	}
</style>

<script>
	/**
	 * Sections arrive as they are reached, and each releases once.
	 */
	const revealing = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (revealing.length > 0 && !still && 'IntersectionObserver' in window) {
		for (const el of revealing) el.classList.add('is-armed');

		const watcher = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					// Cards in the same row follow each other rather than landing
					// together, which reads as one movement instead of nine.
					const peers = [...(el.parentElement?.children ?? [])].filter(
						(n) => (n as HTMLElement).dataset?.reveal !== undefined,
					);
					const place = peers.indexOf(el);
					if (peers.length > 1 && place > 0) {
						el.style.setProperty('--delay', `${Math.min(place, 6) * 70}ms`);
					}
					el.classList.add('is-in');
					watcher.unobserve(el);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
		);

		for (const el of revealing) watcher.observe(el);
	}
</script>
