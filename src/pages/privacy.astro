---
import Doc from '../layouts/Doc.astro';

/**
 * What this page says about the system is taken from the system: the columns
 * are the columns `person` actually has, the third parties are the only hosts
 * the browser and the database actually talk to, and the retention rule for
 * the rate-limit table is the one in migration 0005.
 *
 * Everything the code cannot answer — how long registrations are kept, who
 * answers a privacy request — was settled with the Foundation and written in.
 * Nothing on the page is invented, and nothing is left unfinished; if a future
 * claim cannot be sourced the same way, mark it rather than guessing.
 */

const POLICY_VERSION = '1.0';
const LAST_UPDATED = '7 September 2026';

const collected = [
	{
		group: 'To reach you',
		items:
			'Your name; a phone number or an email address; your city; and, in India, your PIN code.',
	},
	{
		group: 'To point you the right way',
		items:
			'Whether you are seeking support, caring for someone, volunteering or joining us some other way; and which of our three areas you want to connect with.',
	},
	{
		group: 'Only if you offer them',
		items:
			'Your date of birth, gender and preferred language. None of the three is required.',
	},
	{
		group: 'What you agreed to',
		items:
			'Which ways we may contact you, recorded one by one, each with the version of this policy and the date you agreed.',
	},
	{
		group: 'How you got here',
		items:
			'How you heard of us, if you chose to tell us. Whether you did or not: any campaign tags in the link you followed, and the name of the site that linked you — not the page you came from.',
	},
];
---

<Doc
	title="Privacy — The Itti Foundation"
	description="What The Itti Foundation collects when you register, why, and what you can ask us to do about it."
	eyebrow="Privacy"
	heading="What we hold, and why."
	lede="What happens to the details you give us when you register."
	version={POLICY_VERSION}
	updated={LAST_UPDATED}
>
	<section class="doc__section">
		<h2 class="doc__h">Who we are</h2>
		<div class="doc__body">
			<p>
				The Itti Foundation is the data fiduciary for everything described here. We are
				registered as Itti&rsquo;s Skill School Foundation, a Section 8 not-for-profit.
			</p>
			<p>
				<strong>Anuja Bali</strong> answers privacy requests. Write to{' '}
				<a class="doc__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a>{' '}
				to see, correct or delete what we hold, or about anything else on this page.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">What we collect</h2>
		<div class="doc__body">
			<dl class="doc__list">
				{
					collected.map((c) => (
						<>
							<dt>{c.group}</dt>
							<dd>{c.items}</dd>
						</>
					))
				}
			</dl>
			<p>
				We ask nothing about your health beyond which area you want to connect with. No
				cookies, no analytics, no advertising, and nothing is kept about a visit that
				does not end in a registration.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Who else sees it</h2>
		<div class="doc__body">
			<p>
				<strong>Supabase</strong> stores the registry in their Mumbai region, which is within
				India.
			</p>
			<p>
				<strong>Netlify</strong> serves this site and sees ordinary request logs.
			</p>
			<p>
				<strong>India Post</strong> is sent a PIN code you enter, so we can fill in your district.
				Nothing else about you reaches them.
			</p>
			<p>We do not sell your details or pass them to anyone else.</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">How long we keep it</h2>
		<div class="doc__body">
			<p>
				We keep what you give us for as long as you are in touch with us. If three years
				pass with no contact either way, we delete it.
			</p>
			<p>
				If you ask us to stop contacting you, we keep only enough to honour that &mdash;
				your contact details and the fact that you asked &mdash; so we do not write to
				you again by mistake. Ask us to delete everything instead and we will.
			</p>
			<p>
				To stop the form being abused, we count registrations against a one-way hash of
				the internet address you connect from. The address itself is never stored, and
				the counts are deleted after a day.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">How we protect it</h2>
		<div class="doc__body">
			<p>
				The registry cannot be read through this website. Registration reaches it
				through a single function that only writes; no table can be read by anyone who
				is not signed in as the person it describes.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Under 18</h2>
		<div class="doc__body">
			<p>
				If your date of birth puts you under 18, we ask for a parent or guardian&rsquo;s
				phone number or email address and will not register you without one.
			</p>
			<p>
				We write to them the moment you register, and we do not act on the registration
				until they reply to say we may. If you gave a phone number rather than an email
				address, we call instead.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">What you can ask</h2>
		<div class="doc__body">
			<p>
				You can ask for a copy of what we hold, ask us to correct it, ask us to delete
				it, or withdraw a consent you gave. If you are unable to do these yourself, you
				may nominate someone to do them for you.
			</p>
			<p>
				Withdrawing a consent does not undo what was done while it stood. If we do not
				answer, you may complain to the Data Protection Board of India.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">If this changes</h2>
		<div class="doc__body">
			<p>
				Each consent is stored with the policy version in force when you gave it, so a
				change here cannot reinterpret it.
			</p>
		</div>
	</section>
</Doc>
