---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

/**
 * What this page says about the system is taken from the system: the columns
 * are the columns `person` actually has, the third parties are the only hosts
 * the browser and the database actually talk to, and the retention rule for
 * the rate-limit table is the one in migration 0005.
 *
 * Everything the code cannot answer — how long registrations are kept, who the
 * grievance officer is, what address to write to — is marked `TO CONFIRM` and
 * renders visibly as an unfinished line. None of it is invented.
 */

const POLICY_VERSION = 'v1.0';
const LAST_UPDATED = '6 September 2026';

const collected = [
	{
		group: 'To reach you',
		items: 'Your name; a phone number or an email address; your city, and in India your PIN code.',
	},
	{
		group: 'To route you',
		items: 'Whether you are seeking support, caring for someone, volunteering or otherwise; and which of our three areas you want.',
	},
	{
		group: 'If you offer them',
		items: 'Date of birth, gender, preferred language. None is required.',
	},
	{
		group: 'What you agreed to',
		items: 'Each contact permission separately, with the policy version and date.',
	},
	{
		group: 'How you got here',
		items: 'If you told us, how you heard of us. Either way: any campaign tags in the link you followed, and the site that linked you — its name only, not the page.',
	},
];
---

<Base
	title="Privacy — The Itti Foundation"
	description="What The Itti Foundation collects when you register, why, and what you can ask us to do about it."
>
	<div class="page">
		<article class="doc">
		<header class="doc__head">
			<p class="doc__eyebrow">Privacy</p>
			<h1 class="doc__title">What we hold, and why.</h1>
			<p class="doc__lede">What happens to what you give us when you register here.</p>
			<p class="doc__stamp">
				Version {POLICY_VERSION} &middot; Last updated {LAST_UPDATED}
			</p>
		</header>

		<section class="doc__section">
			<h2 class="doc__h">Who we are</h2>
			<div class="doc__body">
				<p class="doc__todo">
					TO CONFIRM &mdash; the registered name and address of the foundation, and the
					person who answers privacy requests. The DPDP Act requires both to be
					published.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">What we collect</h2>
			<div class="doc__body">
				<dl class="doc__list">
					{
						collected.map((c) => (
							<>
								<dt>{c.group}</dt>
								<dd>{c.items}</dd>
							</>
						))
					}
				</dl>
				<p>
					We ask nothing about your health beyond which area you want. No cookies, no
					analytics, no advertising, and nothing is kept about a visit that does not
					end in a registration.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">Who else holds it</h2>
			<div class="doc__body">
				<p>
					<strong>Supabase</strong> stores the registry, in their Seoul region &mdash;
					so outside India.
				</p>
				<p><strong>Netlify</strong> serves this site and sees ordinary request logs.</p>
				<p>
					<strong>India Post</strong> receives a PIN code you type, to name its
					district. Nothing else reaches them.
				</p>
				<p>We do not sell your details or pass them to anyone else.</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">How long</h2>
			<div class="doc__body">
				<p class="doc__todo">
					TO CONFIRM &mdash; how long a registration is kept, and what happens to it if
					you ask us to stop.
				</p>
				<p>
					Abuse counts are held against a one-way hash of your address, never the
					address, and deleted after a day.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">How it is held</h2>
			<div class="doc__body">
				<p>
					The registry cannot be read through this website. Registration reaches it
					through a single function that only writes; every table refuses to be read
					by anyone who is not signed in as the person concerned.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">Under 18</h2>
			<div class="doc__body">
				<p>
					If your date of birth puts you under 18, we ask for a parent or guardian's
					phone number or email address and will not register you without one.
				</p>
				<p class="doc__todo">
					TO CONFIRM &mdash; we contact them to confirm before acting on the
					registration. Someone has to be doing that.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">What you can ask</h2>
			<div class="doc__body">
				<p>
					For a copy of what we hold; that we correct it; that we delete it; that a
					consent be withdrawn. You may nominate someone to exercise these for you if
					you cannot.
				</p>
				<p>
					Withdrawing a consent does not undo what was done while it stood. If we do
					not answer, you may complain to the Data Protection Board of India.
				</p>
			</div>
		</section>

		<section class="doc__section">
			<h2 class="doc__h">If this changes</h2>
			<div class="doc__body">
				<p>
					Each consent is stored with the policy version in force when you gave it, so
					a change here cannot reinterpret it.
				</p>
			</div>
		</section>

		</article>

		<SiteFooter />
	</div>
</Base>

<style>
	/* The ground runs the width of the page, so the footer — which sets no
	   background of its own and whose ink assumes cream — has something to sit
	   on. Without it, it renders dark on dark. */
	.page {
		background: var(--cream);
	}

	.doc {
		max-width: 62rem;
		margin: 0 auto;
		padding: calc(var(--nav-h) + clamp(2.5rem, 7vh, 5rem)) var(--gutter)
			clamp(3rem, 8vh, 5rem);
	}

	.doc__head {
		display: grid;
		grid-template-columns: minmax(7rem, 22%) 1fr;
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
		padding-bottom: clamp(2.5rem, 6vh, 4rem);
	}

	.doc__eyebrow {
		grid-column: 1;
		padding-top: 0.65rem;
		font-family: var(--face-cinzel);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--teal);
	}

	.doc__title {
		grid-column: 2;
		font-family: var(--face-bodoni);
		font-size: clamp(2.25rem, 4.6vw, 3.25rem);
		font-weight: 450;
		line-height: 1.05;
		letter-spacing: -0.015em;
	}

	.doc__lede {
		grid-column: 2;
		margin-top: 1rem;
		font-size: 1.125rem;
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 34rem;
	}

	.doc__stamp {
		grid-column: 2;
		margin-top: 1.5rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.doc__section {
		display: grid;
		grid-template-columns: minmax(7rem, 22%) 1fr;
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
		border-top: 1px solid var(--rule);
		padding: 2.75rem 0 0;
		margin-bottom: 3rem;
	}

	.doc__h {
		grid-column: 1;
		margin: 0;
		font-family: var(--face-cinzel);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.35;
		text-transform: uppercase;
		color: var(--teal);
	}

	.doc__body {
		grid-column: 2;
		display: grid;
		gap: 1.15rem;
		max-width: 36rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.doc__body strong {
		font-weight: 600;
		color: var(--ink);
	}

	.doc__list {
		display: grid;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.doc__list dt {
		padding: 1rem 0 0.35rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.doc__list dd {
		margin: 0;
		padding: 0 0 1rem;
		border-bottom: 1px solid var(--rule);
		color: var(--ink-soft);
	}

	/* Deliberately conspicuous. These are the lines only the foundation can
	   write, and a privacy policy that ships with them still in it is worse
	   than one that is late. */
	.doc__todo {
		padding: 0.9rem 0 0.9rem 1rem;
		border-left: 2px solid var(--ochre);
		color: var(--ink);
		font-size: 1rem;
	}

	@media (max-width: 46rem) {
		.doc__head,
		.doc__section {
			grid-template-columns: 1fr;
		}

		.doc__eyebrow,
		.doc__title,
		.doc__lede,
		.doc__stamp,
		.doc__h,
		.doc__body {
			grid-column: 1;
		}

		.doc__eyebrow {
			padding-top: 0;
			margin-bottom: 0.65rem;
		}

		.doc__h {
			margin-bottom: 1.5rem;
		}
	}
</style>
