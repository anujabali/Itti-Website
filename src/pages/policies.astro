<script>
	/**
	 * The rail marks where you are, at both depths.
	 *
	 * Which document is current is decided by the topmost one whose head has
	 * passed the reading line — not by whichever section happens to intersect,
	 * because four documents of very different lengths are in view at once and
	 * the naive observer flickers between them on every scroll. The section is
	 * chosen the same way, among that document's own sections only, so the two
	 * marks can never disagree about which document is being read.
	 *
	 * The section lists ship open. Closing the three that are not being read is
	 * this script's job, which means a reader without scripting still gets the
	 * whole table of contents rather than four bare links.
	 *
	 * A click sets both marks at once and holds them while the browser scrolls,
	 * so the rail never argues with the reader about where they just asked to
	 * go.
	 */
	const railLinks = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
	const subLinks = [...document.querySelectorAll<HTMLElement>('[data-rail-section]')];
	const subLists = [...document.querySelectorAll<HTMLElement>('[data-rail-sub]')];
	const list = document.querySelector<HTMLElement>('[data-rail-list]');
	const now = document.querySelector<HTMLElement>('[data-rail-now]');

	const byId = (id: string | undefined) => (id ? document.getElementById(id) : null);
	const docs = railLinks.map((l) => byId(l.dataset.rail)).filter((e): e is HTMLElement => !!e);
	const sections = subLinks
		.map((l) => byId(l.dataset.railSection))
		.filter((e): e is HTMLElement => !!e);

	const topButton = document.querySelector<HTMLButtonElement>('[data-rail-top]');
	const title = document.querySelector<HTMLElement>('.pol__title');

	if (topButton) {
		topButton.addEventListener('click', () => {
			// The page has opted out of smooth scrolling, so this lands.
			window.scrollTo(0, 0);
			// Send the reading position with it, or somebody on a keyboard is
			// returned to the top of the page while their focus stays halfway down
			// the terms.
			if (title) {
				title.tabIndex = -1;
				title.focus({ preventScroll: true });
			}
		});
	}

	if (docs.length === railLinks.length && docs.length > 0) {

		/**
		 * The line above which a heading counts as read past.
		 *
		 * On the wide layout that is where the nav sits. On the narrow one the
		 * rail is a strip across the top, and a title that has slid under it is
		 * not on screen at all — measuring against the nav alone leaves the mark
		 * a whole document behind. The two layouts are told apart by the shape of
		 * the rail itself, so nothing here has to know the breakpoint.
		 */
		const lineOf = () => {
			const nav =
				parseFloat(
					getComputedStyle(document.documentElement).getPropertyValue('--nav-h'),
				) * 16;
			const box = list?.getBoundingClientRect();
			if (box && box.width > box.height) return box.bottom + 24;
			return nav + 48;
		};

		/** The last element whose top has crossed the line; the first, before any has. */
		const topmost = (els: HTMLElement[], line: number) => {
			let found = els[0];
			for (const el of els) if (el.getBoundingClientRect().top <= line) found = el;
			return found;
		};

		const mark = (docId: string, sectionId: string) => {
			for (const link of railLinks) {
				if (link.dataset.rail === docId) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}
			for (const sub of subLists) sub.hidden = sub.dataset.railSub !== docId;
			let label = '';
			for (const link of subLinks) {
				const on = link.dataset.railSection === sectionId;
				if (on) {
					link.setAttribute('aria-current', 'true');
					label = link.textContent?.trim() ?? '';
				} else link.removeAttribute('aria-current');
			}
			if (now) now.textContent = label;
		};

		const current = () => {
			const line = lineOf();
			// At the foot nothing scrolls past the last document, so it would never
			// claim the line on its own.
			const atEnd = window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
			const doc = atEnd ? docs[docs.length - 1]! : topmost(docs, line)!;
			const own = sections.filter((s) => s.id.startsWith(`${doc.id}-`));
			const section = atEnd ? own[own.length - 1] : topmost(own, line);
			mark(doc.id, section?.id ?? '');
			// Offered once the masthead has gone, and not before: at the top of the
			// page it would be a button that does nothing.
			if (topButton) topButton.hidden = window.scrollY < 320;
		};

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				current();
				ticking = false;
			});
		};

		// The jump itself is the browser's, and it is instant, so there is nothing
		// to hold the mark against — it is set here only so the rail answers on
		// the same frame as the click rather than on the scroll that follows.
		for (const link of [...railLinks, ...subLinks]) {
			link.addEventListener('click', () => {
				const id = link.dataset.rail ?? link.dataset.railSection ?? '';
				const docId = id.split('-')[0] ?? '';
				mark(docId, link.dataset.railSection ?? `${docId}-1`);
			});
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		current();
	}
</script>
