---
/**
 * The four standing documents, on one page.
 *
 * They used to be four routes. They are read the way a single book is read —
 * somebody checking what we hold about them almost always wants the erasure
 * clause in the terms next, and the grievance address after that — and four
 * separate pages made that three navigations instead of a scroll.
 *
 * The old routes still resolve: `_redirects` sends /privacy, /terms,
 * /accessibility and /contact to their anchors here, permanently. A privacy
 * notice is cited by URL, so those must not simply stop working.
 *
 * The rail is the table of contents and the position indicator at once. It
 * mirrors the four links in the footer exactly, because those are the four
 * doors people arrive through.
 */
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { POLICY_LABEL, POLICY_UPDATED } from '../lib/policy';

const TERMS_VERSION = '2.0';
const TERMS_UPDATED = '9 September 2026';
const LAST_REVIEWED = '9 September 2026';

/**
 * The rail, the footer and the redirects all describe the same four doors.
 *
 * The section lists are generated from the documents below them and are
 * rendered here rather than assembled by the script, so that the whole table
 * of contents works with scripting switched off. The script only decides
 * which part of it is lit.
 */
const DOCUMENTS = [
	{
		id: 'privacy',
		label: 'Privacy Policy',
		sections: [
			{ id: 'privacy-1', label: '1. Scope and controller' },
			{ id: 'privacy-2', label: '2. Personal data we collect' },
			{ id: 'privacy-3', label: '3. Purposes and lawful basis' },
			{ id: 'privacy-4', label: '4. Consent, and how to withdraw it' },
			{ id: 'privacy-5', label: '5. Children' },
			{ id: 'privacy-6', label: '6. Recipients and processors' },
			{ id: 'privacy-7', label: '7. Storage and transfers' },
			{ id: 'privacy-8', label: '8. Retention' },
			{ id: 'privacy-9', label: '9. Your rights' },
			{ id: 'privacy-10', label: '10. Security' },
			{ id: 'privacy-11', label: '11. Cookies and browser storage' },
			{ id: 'privacy-12', label: '12. Changes to this policy' },
			{ id: 'privacy-13', label: '13. Contact and grievances' },
		],
	},
	{
		id: 'terms',
		label: 'Terms of Use',
		sections: [
			{ id: 'terms-1', label: '1. Who we are, and your acceptance' },
			{ id: 'terms-2', label: '2. Registration' },
			{ id: 'terms-3', label: '3. Accounts and sign-in' },
			{ id: 'terms-4', label: '4. Content you provide' },
			{ id: 'terms-5', label: '5. Acceptable use' },
			{ id: 'terms-6', label: '6. No professional advice' },
			{ id: 'terms-7', label: '7. Intellectual property' },
			{ id: 'terms-8', label: '8. Third-party links' },
			{ id: 'terms-9', label: '9. Availability and disclaimers' },
			{ id: 'terms-10', label: '10. Limitation of liability' },
			{ id: 'terms-11', label: '11. Suspension' },
			{ id: 'terms-12', label: '12. Changes to these terms' },
			{ id: 'terms-13', label: '13. Governing law' },
			{ id: 'terms-14', label: '14. Contact' },
		],
	},
	{
		id: 'accessibility',
		label: 'Accessibility',
		sections: [
			{ id: 'accessibility-1', label: '1. Our commitment' },
			{ id: 'accessibility-2', label: '2. Conformance status' },
			{ id: 'accessibility-3', label: '3. Measures taken' },
			{ id: 'accessibility-4', label: '4. Technical specifications' },
			{ id: 'accessibility-5', label: '5. Assessment approach' },
			{ id: 'accessibility-6', label: '6. Known limitations' },
			{ id: 'accessibility-7', label: '7. Feedback' },
			{ id: 'accessibility-8', label: '8. Review' },
		],
	},
	{
		id: 'contact',
		label: 'Contact',
		sections: [
			{ id: 'contact-1', label: 'General enquiries' },
			{ id: 'contact-2', label: 'Response times' },
			{ id: 'contact-3', label: 'What to write about' },
			{ id: 'contact-4', label: 'Data protection' },
			{ id: 'contact-5', label: 'Accessibility' },
			{ id: 'contact-6', label: 'Social media' },
			{ id: 'contact-7', label: 'Urgent help' },
		],
	},
];
---

<Base
	title="Policies — The Itti Foundation"
	description="The standing documents of The Itti Foundation: privacy policy, terms of use, accessibility statement, and how to contact us."
>
	<script is:inline>
		/**
		 * Arriving at a fragment, without the page showing somewhere else first.
		 *
		 * Two things were wrong. The site sets `scroll-behavior: smooth` on the
		 * root, so a fragment inherited it and rode sixteen thousand pixels down;
		 * that is fixed by opting this page out of smooth scrolling entirely,
		 * since every journey on it is long enough for the animation to read as a
		 * lurch rather than as motion. A click in the rail is the same journey, so
		 * it lands too.
		 *
		 * The second was the one that actually showed. The browser paints the top
		 * of the document before it has parsed as far as the target, and the
		 * position is not even final then: the fonts load with `swap`, every
		 * height above the target changes, and the page corrects itself again. On
		 * a throttled load the reader saw the masthead for half a second, then a
		 * snap, then a second smaller snap.
		 *
		 * So the text is held back until it can be placed. The ground and the
		 * navigation paint immediately; only the document waits, until the fonts
		 * have settled and the target has been scrolled to for the last time.
		 * `visibility` rather than `display`, because the layout has to happen for
		 * the scroll position to be computable at all.
		 *
		 * The cap is there because a font that never arrives must not leave the
		 * page blank.
		 */
		document.documentElement.style.scrollBehavior = 'auto';

		if (location.hash) {
			(function () {
				var root = document.documentElement;
				var id = location.hash.slice(1);
				var done = false;

				root.setAttribute('data-locating', '');

				var reveal = function () {
					if (done) return;
					done = true;
					var target = document.getElementById(id);
					if (target) target.scrollIntoView();
					root.removeAttribute('data-locating');
				};

				var settle = function () {
					// One frame after the fonts, so the reflow they cause is in the
					// layout we measure rather than the one after it.
					requestAnimationFrame(reveal);
				};

				if (document.fonts && document.fonts.ready) document.fonts.ready.then(settle);
				else addEventListener('load', settle);
				addEventListener('load', settle);
				setTimeout(reveal, 1200);
			})();
		}
	</script>

	<div class="pol-page">
		<div class="pol">
			<header class="pol__masthead">
				<p class="pol__eyebrow">The Itti Foundation</p>
				<h1 class="pol__title">Policies</h1>
				<p class="pol__lede">
					Four standing documents: what we do with your data, the terms this site is
					offered on, how accessible it is, and how to reach us.
				</p>
			</header>

			<div class="pol__grid">
				<aside class="pol__rail">
					<nav class="pol__rail-inner" aria-label="Documents on this page">
						<div class="pol__rail-top">
							<p class="pol__rail-heading" id="pol-rail-heading">On this page</p>
							<button class="pol__top" type="button" data-rail-top hidden>
								<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
									<path
										d="M8 13.25V3.4M8 3.4 3.9 7.5M8 3.4l4.1 4.1"
										fill="none"
										stroke="currentColor"
										stroke-width="1.3"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								<span class="pol__top-label">Back to top</span>
							</button>
						</div>
						<ol class="pol__rail-list" data-rail-list aria-labelledby="pol-rail-heading">
							{
								DOCUMENTS.map((doc) => (
									<li class="pol__rail-item">
										<a class="pol__rail-link" href={`#${doc.id}`} data-rail={doc.id}>
											<span class="pol__rail-tick" aria-hidden="true" />
											{doc.label}
										</a>
										<ol class="pol__rail-sub" data-rail-sub={doc.id}>
											{doc.sections.map((section) => (
												<li>
													<a
														class="pol__rail-sublink"
														href={`#${section.id}`}
														data-rail-section={section.id}>
														{section.label}
													</a>
												</li>
											))}
										</ol>
									</li>
								))
							}
						</ol>
						<p class="pol__rail-now" data-rail-now aria-hidden="true"></p>
					</nav>
				</aside>

				<div class="pol__flow">
					<!-- ─────────────────────────────  PRIVACY  ───────────────────────────── -->
					<section class="pol__doc" id="privacy" aria-labelledby="privacy-title">
						<header class="pol__doc-head">
							<h2 class="pol__doc-title" id="privacy-title">Privacy Policy</h2>
							<p class="pol__doc-lede">
								What we collect, why we collect it, who else sees it, how long we keep
								it, and what you can require of us.
							</p>
							<p class="pol__stamp">
								Version {POLICY_LABEL} &middot; Last updated {POLICY_UPDATED}
							</p>
						</header>

						<section class="pol__section" id="privacy-1">
							<h3 class="pol__h">1. Scope and controller</h3>
							<div class="pol__body">
								<p>
									This policy applies to itti.org.in and to the registry behind it. The
									data fiduciary is <strong>Itti&rsquo;s Skill School Foundation</strong>,
									a Section 8 not-for-profit company incorporated in India and operating
									as The Itti Foundation.
								</p>
								<p>
									It is written under India&rsquo;s Digital Personal Data Protection Act,
									2023. Where that Act says <em>data principal</em>, this policy says{' '}
									<em>you</em>; where it says <em>data fiduciary</em>, it says <em>we</em>.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-2">
							<h3 class="pol__h">2. Personal data we collect</h3>
							<div class="pol__body">
								<p><strong>2.1 Information you provide when registering.</strong></p>
								<dl class="pol__list">
									<dt>Identity</dt>
									<dd>
										Full name; your stated role (patient or beneficiary, caregiver or
										family member, volunteer or supporter, member); date of birth, if
										given; gender, including a self-described value where you choose that
										option.
									</dd>
									<dt>Contact</dt>
									<dd>
										Email address and telephone number. At least one is required; both
										are optional individually. We record whether each has been verified.
									</dd>
									<dt>Location</dt>
									<dd>
										City and, if given, six-digit PIN code. We do not collect a street
										address.
									</dd>
									<dt>Preferences</dt>
									<dd>
										Preferred language; which of our three areas of work you wish to be
										connected with; and separate permissions for contact by WhatsApp, SMS
										and email.
									</dd>
									<dt>Guardian details</dt>
									<dd>
										Where the registrant is under 18: the name, and the email address or
										telephone number, of a parent or guardian.
									</dd>
									<dt>Source</dt>
									<dd>How you heard of us, and the name of a referrer where you supply one.</dd>
								</dl>

								<p><strong>2.2 Information you add to your account.</strong></p>
								<dl class="pol__list">
									<dt>Profile text</dt>
									<dd>
										A short biography in your own words, up to 600 characters. It is
										optional and is shown only to you, on your account page.
									</dd>
									<dt>Links</dt>
									<dd>
										Handles or addresses you choose to add for Instagram, Facebook,
										YouTube, LinkedIn, a website, or an additional email address. These
										are self-asserted: we do not verify that an account belongs to you,
										and we do not access any of them.
									</dd>
									<dt>Display preference</dt>
									<dd>The colour you select for your account page.</dd>
								</dl>

								<p><strong>2.3 Information generated by your use of the site.</strong></p>
								<dl class="pol__list">
									<dt>Authentication</dt>
									<dd>
										When you sign in we create an authentication record holding your email
										address and the times you signed in. We do not set, store or ask for a
										password.
									</dd>
									<dt>Campaign parameters</dt>
									<dd>
										If you arrive by a tagged link, the campaign parameters in that link
										(commonly{' '}
										<code>utm_source</code>, <code>utm_medium</code>,{' '}
										<code>utm_campaign</code>) are recorded with your registration.
									</dd>
									<dt>Consent records</dt>
									<dd>
										Each permission you grant or withdraw, with its date and the version
										of this policy in force at the time. These are append-only: a
										withdrawal is a new entry, never a deletion.
									</dd>
									<dt>Correspondence</dt>
									<dd>
										A record of the messages we have sent you, their delivery status, and
										the details included in them.
									</dd>
								</dl>

								<p><strong>2.4 What we do not collect.</strong></p>
								<p>
									We do not use analytics, advertising or tracking services. We do not
									profile you, and no decision affecting you is made by automated means. We
									do not collect health information through this website.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-3">
							<h3 class="pol__h">3. Purposes and lawful basis</h3>
							<div class="pol__body">
								<p>
									Under the DPDP Act we process personal data on the basis of your consent,
									given at registration and withdrawable at any time.
								</p>
								<dl class="pol__list">
									<dt>To reach you</dt>
									<dd>
										To acknowledge your registration and to contact you about the work you
										asked to be connected with, by the channels you permitted.
									</dd>
									<dt>To direct you correctly</dt>
									<dd>
										Your role, stated areas of interest and location determine which part
										of the Foundation responds to you.
									</dd>
									<dt>To obtain guardian consent</dt>
									<dd>
										Where a registrant is under 18, to notify the parent or guardian named
										and to obtain their agreement before acting on the registration.
									</dd>
									<dt>To operate your account</dt>
									<dd>To authenticate you and to display the record we hold about you.</dd>
									<dt>To understand our reach</dt>
									<dd>
										Aggregate counts by city, area of interest and referral source, used to
										plan where the Foundation works. This does not identify individuals.
									</dd>
									<dt>To meet legal obligations</dt>
									<dd>To retain consent records and to respond to lawful requests.</dd>
								</dl>
							</div>
						</section>

						<section class="pol__section" id="privacy-4">
							<h3 class="pol__h">4. Consent, and how to withdraw it</h3>
							<div class="pol__body">
								<p>
									Permission for WhatsApp, SMS and email is asked for separately and
									recorded separately. You may change any of them at any time on your
									account page, or by writing to us; the change takes effect on receipt and
									we record it.
								</p>
								<p>
									Withdrawing consent does not affect anything done while it was in force,
									and does not by itself erase your record. To have the record removed, see
									section 9.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-5">
							<h3 class="pol__h">5. Children</h3>
							<div class="pol__body">
								<p>
									The DPDP Act treats anyone under 18 as a child and requires verifiable
									consent from a parent or lawful guardian. A registration giving a date of
									birth under 18 cannot be completed without guardian details; the registry
									refuses it.
								</p>
								<p>
									We write to the guardian at the address given and do not act on the
									registration until they agree. We do not use a child&rsquo;s data for
									tracking, advertising or behavioural monitoring of any kind.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-6">
							<h3 class="pol__h">6. Recipients and processors</h3>
							<div class="pol__body">
								<p>
									We do not sell personal data, and we do not share it for anyone
									else&rsquo;s marketing. It is disclosed only to the service providers
									below, who process it on our instructions and for no purpose of their own.
								</p>
								<dl class="pol__list">
									<dt>Supabase</dt>
									<dd>
										Database, authentication and server functions. Your data is held in the
										Mumbai region.
									</dd>
									<dt>Cloudflare</dt>
									<dd>
										Hosting, content delivery and DNS for this website. Cloudflare
										processes the network requests your browser makes, including your IP
										address, in order to serve pages.
									</dd>
									<dt>Resend</dt>
									<dd>
										Delivery of automated email, including sign-in links and
										acknowledgements.
									</dd>
									<dt>Zoho</dt>
									<dd>
										Our own mailboxes. Correspondence you send to an @itti.org.in address
										is held there.
									</dd>
									<dt>India Post PIN directory</dt>
									<dd>
										If you enter a PIN code, your browser queries a public postal lookup
										(api.postalpincode.in) to name the district. Only the PIN code is sent,
										and it is not accompanied by anything identifying you.
									</dd>
								</dl>
								<p>
									We may also disclose personal data where required by law, or to establish
									or defend a legal claim.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-7">
							<h3 class="pol__h">7. Storage and transfers</h3>
							<div class="pol__body">
								<p>
									The registry is hosted in India, in Supabase&rsquo;s Mumbai region. Our
									email providers and content delivery network operate globally and may
									process data outside India in the course of delivering a message or a
									page. We use providers that offer contractual protections for such
									transfers.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-8">
							<h3 class="pol__h">8. Retention</h3>
							<div class="pol__body">
								<dl class="pol__list">
									<dt>Your registration and account</dt>
									<dd>
										Kept while you remain in contact with the Foundation, and erased on
										request.
									</dd>
									<dt>Consent records</dt>
									<dd>
										Kept for the life of the registration and for three years afterwards,
										because they are the evidence of what you agreed to and when.
									</dd>
									<dt>Correspondence records</dt>
									<dd>Kept for two years from the date of sending.</dd>
								</dl>
								<p>
									Where a retention period has passed, data is deleted or irreversibly
									aggregated so that it no longer identifies anyone.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-9">
							<h3 class="pol__h">9. Your rights</h3>
							<div class="pol__body">
								<p>Under the DPDP Act you have the right to:</p>
								<dl class="pol__list">
									<dt>Access</dt>
									<dd>
										Obtain confirmation of what we hold about you and a summary of how it
										is processed. Your account page shows this in full and at any time.
									</dd>
									<dt>Correction and completion</dt>
									<dd>
										Have inaccurate data corrected and incomplete data completed. Most
										fields can be edited directly on your account page.
									</dd>
									<dt>Erasure</dt>
									<dd>
										Require deletion of your personal data, except where we must retain it
										to meet a legal obligation.
									</dd>
									<dt>Grievance redressal</dt>
									<dd>Raise a complaint with us, and receive a response.</dd>
									<dt>Nomination</dt>
									<dd>
										Nominate another individual to exercise these rights on your behalf in
										the event of your death or incapacity.
									</dd>
								</dl>
								<p>
									To exercise any of these, write to{' '}
									<a class="pol__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a
									>. We respond within five working days and complete requests within thirty
									days.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-10">
							<h3 class="pol__h">10. Security</h3>
							<div class="pol__body">
								<p>
									Access to the registry is restricted at the database level: a signed-in
									person can read and amend their own record and no other. Staff access is
									limited to those who need it. The site is served only over HTTPS and
									enforces a content security policy.
								</p>
								<p>
									No system is immune to compromise. In the event of a personal data breach
									we will notify the Data Protection Board of India and every affected
									person, as the Act requires.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-11">
							<h3 class="pol__h">11. Cookies and browser storage</h3>
							<div class="pol__body">
								<p>
									<strong>We set no advertising or analytics cookies.</strong> The site uses
									browser storage for two strictly functional purposes:
								</p>
								<dl class="pol__list">
									<dt>Your session</dt>
									<dd>
										When you sign in, an authentication token is stored in your browser so
										that you remain signed in. Signing out removes it.
									</dd>
									<dt>Your display name and colour</dt>
									<dd>
										Your first name and chosen colour are stored locally so the site can
										show them without querying the registry on every page. They never leave
										your device.
									</dd>
								</dl>
								<p>Clearing your browser&rsquo;s site data removes both and signs you out.</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-12">
							<h3 class="pol__h">12. Changes to this policy</h3>
							<div class="pol__body">
								<p>
									This policy carries a version number and a date, both shown at the head of
									it. When it changes materially we update both and record the version in
									force against each consent we hold, so that it is always possible to
									establish which terms you agreed to.
								</p>
							</div>
						</section>

						<section class="pol__section" id="privacy-13">
							<h3 class="pol__h">13. Contact and grievances</h3>
							<div class="pol__body">
								<p>
									<strong>Grievance Officer:</strong> Anuja Bali, The Itti Foundation.<br />
									<strong>Email:</strong>{' '}
									<a class="pol__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a
									><br />
									<strong>Telephone:</strong>{' '}
									<a class="pol__link" href="tel:+918928263631">+91 89282 63631</a>
								</p>
								<p>
									If you are not satisfied with our response, you may complain to the Data
									Protection Board of India.
								</p>
							</div>
						</section>
					</section>

					<!-- ──────────────────────────────  TERMS  ─────────────────────────────- -->
					<section class="pol__doc" id="terms" aria-labelledby="terms-title">
						<header class="pol__doc-head">
							<h2 class="pol__doc-title" id="terms-title">Terms of Use</h2>
							<p class="pol__doc-lede">
								The terms on which this site is offered, what you may do with what is on
								it, and the limits of what it claims to be.
							</p>
							<p class="pol__stamp">
								Version {TERMS_VERSION} &middot; Last updated {TERMS_UPDATED}
							</p>
						</header>

						<section class="pol__section" id="terms-1">
							<h3 class="pol__h">1. Who we are, and your acceptance</h3>
							<div class="pol__body">
								<p>
