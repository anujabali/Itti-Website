---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
---

<Base
	title="Conservation — The Itti Foundation"
	description="Of land, air and water. The Earth gives us everything; now it is our turn to give back."
	navTheme="light"
	band="cream"
>
	<div class="conservation-page">
		<header class="hero">
			<span class="hero__label">Our Pillar</span>
			<h1 class="hero__title">Conservation</h1>
			<p class="hero__lede">Of land, air and water.</p>

			<div class="hero__passage">
				<p>The Earth gives us everything; now it is our turn to give back.</p>
				<p>
					Every drop saved, every breath protected and every patch of land restored
					matters. Small actions today can keep our planet alive for tomorrow.
				</p>
			</div>
		</header>

		<section class="communities-section">
			<div class="communities-header">
				<h2>Join Our Communities</h2>
				<p>
					Become a part of our grassroots initiatives. Connect, collaborate, and make a
					difference.
				</p>
			</div>

			<div class="groups-grid">
				{
					[
						{
							name: 'Pune Milk Bag Project',
							desc: 'A community initiative in Pune focused on collecting and recycling used milk bags.',
							url: 'https://chat.whatsapp.com/EPjMlapwEztK2Cq9NZwHxo?mode=gi_t',
						},
						{
							name: 'Kolkata Milk Bag Project',
							desc: 'Join hands in Kolkata to responsibly recycle milk bags and reduce our plastic footprint.',
							url: 'https://chat.whatsapp.com/CMac7YeWAkl4JR6CCVrpax?mode=gi_t',
						},
						{
							name: 'VrikshaRakshan',
							desc: 'Protecting our green cover through dedicated tree-planting and nurturing campaigns.',
							url: 'https://chat.whatsapp.com/JNAcVt9iIEcGJYkBRE1IXx?mode=gi_t',
						},
						{
							name: 'Rainwater Harvesting',
							desc: 'Empowering communities to conserve water for a sustainable and water-secure future.',
							url: 'https://chat.whatsapp.com/KvSqVBvoIsaJe0IlJYDo9T?mode=gi_t',
						},
						{
							name: 'Periods ki Pathshala',
							desc: 'Raising awareness, breaking taboos, and promoting safe, healthy menstrual practices.',
							url: 'https://chat.whatsapp.com/HY6bziCS69fK1y9sMyX8S8?mode=gi_t',
						},
					].map((group) => (
						<a
							href={group.url}
							class="group-card"
							target="_blank"
							rel="noopener noreferrer"
						>
							<div class="group-card__content">
								<h3>{group.name}</h3>
								<p>{group.desc}</p>
							</div>
							<span class="whatsapp-btn" title="Join WhatsApp Group">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
								</svg>
								Join Group
							</span>
						</a>
					))
				}
			</div>
		</section>
	</div>

	<div class="footer-wrap">
		<SiteFooter />
	</div>
</Base>

<style>
	.conservation-page {
		background: color-mix(in srgb, var(--cream) 80%, #fff);
		min-height: 100vh;
		padding-bottom: 8rem;
		color: var(--ink);
	}

	/* Hero Section */
	.hero {
		padding: 10rem 2rem 6rem;
		max-width: 50rem;
		margin: 0 auto;
		text-align: center;
	}

	.hero__label {
		display: inline-block;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sage);
		margin-bottom: 1rem;
	}

	.hero__title {
		font-family: var(--face-bodoni);
		font-size: clamp(3rem, 7vw, 4.5rem);
		font-weight: var(--display-weight);
		line-height: 1.1;
		color: var(--ink);
		margin-bottom: 0.5em;
	}

	.hero__lede {
		font-size: clamp(1.25rem, 3vw, 1.6rem);
		color: var(--ink-soft);
		margin-bottom: 2.5rem;
	}

	.hero__passage {
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink);
		max-width: 40rem;
		margin: 0 auto;
	}

	.hero__passage p {
		margin-bottom: 1em;
	}

	/* Communities Section */
	.communities-section {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.communities-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.communities-header h2 {
		font-family: var(--face-bodoni);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: var(--display-weight);
		color: var(--ink);
		margin-bottom: 0.75rem;
	}

	.communities-header p {
		font-size: 1.1rem;
		color: var(--ink-soft);
		max-width: 36rem;
		margin: 0 auto;
	}

	/* WhatsApp Groups Grid */
	.groups-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.group-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2.5rem 2rem;
		border-radius: 12px;
		background: #fff;
		border: 1px solid rgba(44, 39, 33, 0.08);
		color: inherit;
		text-decoration: none;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7) inset,
			0 2px 8px rgba(44, 39, 33, 0.04);
		transition:
			transform 300ms ease,
			box-shadow 300ms ease,
			border-color 300ms ease;
	}

	.group-card:hover {
		transform: translateY(-6px);
		border-color: color-mix(in srgb, var(--sage) 45%, transparent);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7) inset,
			0 16px 32px -12px rgba(44, 39, 33, 0.15);
	}

	.group-card__content h3 {
		font-family: var(--face-bodoni);
		font-size: 1.5rem;
		line-height: 1.2;
		margin-bottom: 0.75rem;
		color: var(--ink);
	}

	.group-card__content p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--ink-soft);
		margin-bottom: 2.5rem;
	}

	.whatsapp-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		padding: 0.6rem 1.2rem;
		border-radius: 40px;
		background-color: var(--teal);
		color: white;
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		transition:
			background-color 200ms ease,
			transform 200ms ease;
	}

	.group-card:hover .whatsapp-btn {
		background-color: color-mix(in srgb, var(--teal) 85%, #000);
		transform: scale(1.02);
	}

	/* Footer styling */
	.footer-wrap {
		position: relative;
		background: var(--ink-deep);

		--ink: var(--warm-white);
		--ink-soft: rgba(250, 247, 240, 0.72);
		--ink-faint: rgba(250, 247, 240, 0.55);
		--accent: var(--warm-white);
		--rule: rgba(250, 247, 240, 0.14);
	}
</style>
