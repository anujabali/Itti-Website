---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Form1Overlay from '../components/forms/form-1/Form1Overlay.astro';
---

<Base
	title="Join Us — The Itti Foundation"
	description="Tell us a little about yourself, and we will point you to the right part of the foundation."
>
	<!-- The form is the page. It keeps the look of a card lifted off a dark
	     ground — which is what made the overlay feel considered — without
	     landing on top of anything a visitor was in the middle of reading. -->
	<Form1Overlay />

	<!-- The footer sets no background of its own and its ink colours assume
	     cream, so it needs a ground to sit on. Without one it renders dark on
	     dark and cannot be read. The wrapper is here rather than in the footer
	     because an Astro scoped style never reaches a child component's root. -->
	<div class="join-footer">
		<SiteFooter />
	</div>
</Base>

<style>
	.join-footer {
		background: var(--cream);
	}
</style>
