---
/**
 * Your account — the registration, back in the hands of the person who made it.
 *
 * Not built on the document layout the privacy and terms pages share, which is
 * where this started and why it read like one. A policy is the foundation
 * addressing everybody; this is one person's own record, and it should open
 * with their name rather than with a heading about them.
 *
 * The facts are grouped the way somebody checking them would think — who you
 * are, where you are, how we reach you, what you are here for — rather than
 * poured out in one column of sixteen rows. Editing keeps the same groups in
 * the same places, so it reads as this page becoming editable rather than as a
 * form arriving to replace it.
 *
 * Every field is in the markup and filled by script, never created by it.
 * Elements made in JavaScript carry no scope attribute, so a scoped rule
 * written here would silently not reach them — which is also what lets the
 * design live in this file instead of leaking into a global stylesheet.
 *
 * With scripting off nothing here can work, so nothing here is shown: the
 * <noscript> block is the whole page in that case, and it points at a person.
 */
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Mark from '../components/brand/Mark.astro';

/**
 * Whether the sign-in email carries a six-digit code as well as a link.
 *
 * It does. Both templates were rewritten once the project was pointed at
 * Resend — custom SMTP is what lifts Supabase's refusal to edit them at all on
 * a free plan — and both now carry the link and the code together.
 *
 * If the code ever stops arriving, this is the switch: check that the template
 * still contains the token variable before blaming the page.
 */
const CODE_SIGNIN = true;

/** Kept in step with the registration form; these are the words it showed. */
const ROLES = [
	['patient', 'Patient / Beneficiary'],
	['caregiver', 'Caregiver / Family Member'],
	['volunteer', 'Volunteer / Supporter'],
	['other', 'Member'],
];

const GENDERS = [
	['', 'Select gender'],
	['woman', 'Female'],
	['man', 'Male'],
	['non_binary', 'Non-binary'],
	['self_described', 'Prefer to self-describe'],
	['undisclosed', 'Prefer not to say'],
];

const LANGUAGES = [
	['en', 'English'],
	['hi', 'Hindi'],
	['mr', 'Marathi'],
	['gu', 'Gujarati'],
	['bn', 'Bengali'],
	['ta', 'Tamil'],
	['te', 'Telugu'],
	['kn', 'Kannada'],
	['ml', 'Malayalam'],
	['pa', 'Punjabi'],
	['ur', 'Urdu'],
	['or', 'Odia'],
	['as', 'Assamese'],
];

/** The accents the three areas already carry on the home page. */
const PILLARS = [
	['neurodivergence', 'Neurodivergence', 'ochre'],
	['cancer_care', 'Cancer Care', 'rose'],
	['claw', 'CLAW', 'sage'],
	['not_sure', "I'm not sure yet", 'teal'],
];

/**
 * Where somebody can be found elsewhere.
 *
 * Self-asserted. A handle here is a claim the person makes, exactly like the
 * name they typed — the registry keeps a `verified_at` for the day a provider
 * confirms one, and nothing sets it yet.
 */
const LINKS = [
	['instagram', 'Instagram', 'instagram.com/'],
	['youtube', 'YouTube', 'youtube.com/@'],
	['facebook', 'Facebook', 'facebook.com/'],
	['linkedin', 'LinkedIn', 'linkedin.com/in/'],
	['website', 'Website', ''],
	['email', 'Another email', ''],
];

/** Read-only rows, and the groups they sit in. */
const FACTS = {
	you: [
		['fullName', 'Name'],
		['role', 'You are'],
		['dateOfBirth', 'Date of birth'],
		['gender', 'Gender'],
	],
	place: [
		['city', 'City'],
		['pincode', 'PIN code'],
		['preferredLanguage', 'Language'],
	],
	reach: [
		['email', 'Email'],
		['phone', 'Phone'],
		['channels', 'Contact by'],
	],
	guardian: [
		['guardianName', 'Name'],
		['guardianEmail', 'Email'],
		['guardianPhone', 'Phone'],
	],
	record: [
		['heardFrom', 'How you found us'],
		['registeredAt', 'With us since'],
	],
};
---

<Base
	title="Your account — The Itti Foundation"
	description="Sign in to see the details The Itti Foundation holds about you, and correct anything that is wrong."
>
	<div class="page">
		<main class="acct" id="main">
			<noscript>
				<header class="acct__mast">
					<p class="acct__eyebrow">Your account</p>
					<h1 class="acct__title">Scripting is off.</h1>
				</header>
				<div class="acct__prose">
					<p>
						This page reads your record from our registry as you open it, which it
						cannot do with scripting switched off. Every other page on this site works
						without it.
					</p>
					<p>
						Write to <a class="acct__link" href="mailto:hello@itti.org.in"
							>hello@itti.org.in</a
						> and we will send you what we hold, or change it, by hand. We answer within five
						working days.
					</p>
				</div>
			</noscript>

			<div data-account hidden>
				<!-- Opening the page, or coming back from the link with a token in
				     the address. Neither is instant, and a blank page reads as a
				     broken one. -->
				<section data-panel="loading">
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">One moment.</h1>
						<p class="acct__lede">Looking for your record.</p>
					</header>
				</section>

				<section data-panel="signin" hidden>
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">Welcome back.</h1>
						<p class="acct__lede">
							Give us the address you registered with and we will send a link that signs
							you in. There is no password to remember, and we never set one.
						</p>
					</header>
					<form class="acct__gate" data-signin-form novalidate>
						<div class="field">
							<label class="field__label" for="acct-email">Your email address</label>
							<input
								class="field__input"
								id="acct-email"
								name="email"
								type="email"
								autocomplete="email"
								inputmode="email"
								spellcheck="false"
								placeholder="you@example.com"
								required
							/>
						</div>
						<button class="btn" type="submit" data-signin-go>Send me a link</button>
					</form>
					<p class="acct__aside">
						Not registered yet? <a class="acct__link" href="/join">Start here</a>.
					</p>
				</section>

				<section data-panel="sent" hidden>
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">Check your email.</h1>
						<p class="acct__lede">
							If we have a registration for <strong data-sent-address></strong>, a
							sign-in link is on its way. It works once, and it stops working after an
							hour.
						</p>
					</header>
					<p class="acct__aside">
						Open it on any device &mdash; the link carries the sign-in with it, so it
						does not have to be the browser you asked from.
					</p>
					{
						CODE_SIGNIN && (
							<p class="acct__aside">
								The message carries a six-digit code as well. If you are reading it
								somewhere else, type the code here instead.
							</p>
						)
					}
					<form class="acct__gate" data-code-form novalidate hidden={!CODE_SIGNIN}>
						<div class="field">
							<label class="field__label" for="acct-code">Six-digit code</label>
							<input
								class="field__input field__input--code"
								id="acct-code"
								name="token"
								type="text"
								inputmode="numeric"
								autocomplete="one-time-code"
								maxlength="6"
								placeholder="000000"
								spellcheck="false"
							/>
						</div>
						<p class="note note--wrong" data-code-error role="alert" hidden></p>
						<button class="btn" type="submit" data-code-go>Sign me in</button>
					</form>
					<p class="acct__aside">
						Nothing arrived? Look in the spam folder, then{' '}
						<button class="linkish" type="button" data-signin-again
							>try a different address</button
						>.
					</p>
				</section>

				<section data-panel="none" hidden>
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">Nothing under that address.</h1>
						<p class="acct__lede">
							You are signed in as <strong data-none-address></strong>, and we hold no
							registration against it.
						</p>
					</header>
					<div class="acct__prose">
						<p>
							That usually means the registration was made with a different address. It
							can also mean you registered with a phone number and no email at all
							&mdash; we can only sign people in by email at the moment, so write to{
								' '
							}
							<a class="acct__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a
							> from the address you would like to use and we will attach it to your record.
						</p>
						<p>
							Otherwise <a class="acct__link" href="/join">register now</a>, or{' '}
							<button class="linkish" type="button" data-signout>sign out</button> and try
							another address.
						</p>
					</div>
				</section>

				<!-- Theirs, not ours. A profile first — a face, their own words, and
				     where else to find them — and only then the record we keep, which
				     is a different kind of thing and is allowed to look like one. -->
				<section data-panel="record" hidden>
					{
						/*
					  A designed band rather than a borrowed photograph: the brand's
					  own teal at depth, the grain the rest of the site is laid over,
					  and the mark bleeding off the edge as an ornament. It gives the
					  page the weight an opening deserves without putting somebody
					  else's picture behind a person's own name.
					*/
					}
					<div class="crown">
						{
							/*
						  Wrapped rather than styled directly. A component's root element
						  carries that component's scope and not this page's, so a scoped
						  rule here never reaches it — the ornament rendered at full
						  strength and swallowed the band. The wrapper is ours, so the
						  rule lands.
						*/
						}
						<span class="crown__ornament" aria-hidden="true">
							<Mark height="26rem" label="" />
						</span>
						<div class="crown__grain" aria-hidden="true"></div>
						<div class="crown__id">
							<p class="crown__eyebrow">Your account</p>
							<h1 class="crown__name" data-mast-name></h1>
							<p class="crown__meta" data-mast-meta></p>
						</div>
						<span class="crown__rule" data-crown-rule aria-hidden="true"></span>
					</div>

					<header class="profile">
						<p class="profile__bio" data-bio hidden></p>
						<p class="profile__invite" data-bio-empty hidden>
							You have not written anything about yourself yet.{' '}
							<button class="linkish" type="button" data-edit-open>Say something</button
							>.
						</p>

						<div class="profile__marks" data-mast-marks aria-hidden="true">
							{
								PILLARS.map(([id, label, accent]) => (
									<span class="mark" data-mark={id} data-accent={accent} hidden>
										{label}
									</span>
								))
							}
						</div>

						<ul class="elsewhere" data-links>
							{
								LINKS.map(([id, label]) => (
									<li data-link={id} hidden>
										<a class="elsewhere__a" data-link-a href="#">
											<span class="elsewhere__kind">{label}</span>
											<span class="elsewhere__at" data-link-text />
										</a>
									</li>
								))
							}
						</ul>

						<div class="acct__actions acct__actions--profile">
							<button class="btn" type="button" data-edit-open>Edit your profile</button
							>
							<button class="linkish" type="button" data-signout>Sign out</button>
						</div>
						<p class="note" data-saved role="status" hidden>Saved.</p>
					</header>

					<section class="held">
						<h2 class="held__title">What we hold</h2>
						<p class="held__note">
							Everything on our side of the record. If a line is wrong, change it
							&mdash; nobody has to approve it.
						</p>
						<div class="spread">
							{
								[
									['you', 'Who you are'],
									['place', 'Where you are'],
									['reach', 'How we reach you'],
									['guardian', 'Your parent or guardian'],
									['record', 'For the record'],
								].map(([key, title]) => (
									<section class="block" data-group={key} hidden>
										<h3 class="block__title">{title}</h3>
										<dl class="facts">
											{FACTS[key as keyof typeof FACTS].map(([id, label]) => (
												<div class="fact" data-fact={id} hidden>
													<dt class="fact__label">{label}</dt>
													<dd class="fact__value" data-value={id} />
												</div>
											))}
										</dl>
									</section>
								))
							}
						</div>
					</section>

					<footer class="acct__foot">
						<p>
							<strong>Your email address</strong> is what signs you in and where the receipt
							went, so it is not something this page will change under you. Write to <a
								class="acct__link"
								href="mailto:hello@itti.org.in">hello@itti.org.in</a
							> and we will move it.
						</p>
						<p>
							<strong>To be erased entirely</strong>, write to the same address and
							Anuja Bali will do it &mdash; not a button that cannot be undone. What we
							hold and why is set out in <a class="acct__link" href="/privacy"
								>What we hold, and why</a
							>.
						</p>
					</footer>
				</section>

				<!-- The same groups in the same order, now editable. -->
				<section data-panel="edit" hidden>
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">Change your details.</h1>
						<p class="acct__lede">
							Nobody has to approve any of this. It takes effect the moment you save.
						</p>
					</header>

					<form data-edit-form novalidate>
						<div class="spread">
							<section class="block block--wide">
								<h2 class="block__title">In your own words</h2>
								<div class="field">
									<label class="field__label" for="acct-bio">
										Anything you would like people here to know
									</label>
									<textarea
										class="field__input field__input--bio"
										id="acct-bio"
										name="bio"
										rows="4"
										maxlength="600"
										placeholder="What brings you here, what you care about, what you are working on."
									></textarea>
									<p class="note"><span data-bio-count>0</span> of 600</p>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
							</section>

							<section class="block">
								<h2 class="block__title">Who you are</h2>
								<div class="field">
									<label class="field__label" for="acct-name">Name</label>
									<input
										class="field__input"
										id="acct-name"
										name="fullName"
										type="text"
										maxlength="120"
										autocomplete="name"
										required
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field">
									<label class="field__label" for="acct-role">You are</label>
									<select class="field__input" id="acct-role" name="role" required>
										{ROLES.map(([v, l]) => <option value={v}>{l}</option>)}
									</select>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field">
									<label class="field__label" for="acct-dob">Date of birth</label>
									<input
										class="field__input"
										id="acct-dob"
										name="dateOfBirth"
										type="date"
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field">
									<label class="field__label" for="acct-gender">Gender</label>
									<select class="field__input" id="acct-gender" name="gender">
										{GENDERS.map(([v, l]) => <option value={v}>{l}</option>)}
									</select>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field" data-gender-other hidden>
									<label class="field__label" for="acct-gender-other"
										>In your own words</label
									>
									<input
										class="field__input"
										id="acct-gender-other"
										name="genderSelfDescribed"
										type="text"
										maxlength="60"
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
							</section>

							<section class="block">
								<h2 class="block__title">Where you are</h2>
								<div class="field">
									<label class="field__label" for="acct-city">City</label>
									<input
										class="field__input"
										id="acct-city"
										name="city"
										type="text"
										maxlength="100"
										autocomplete="address-level2"
										required
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field">
									<label class="field__label" for="acct-pincode">PIN code</label>
									<input
										class="field__input"
										id="acct-pincode"
										name="pincode"
										type="text"
										inputmode="numeric"
										maxlength="6"
										autocomplete="postal-code"
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field">
									<label class="field__label" for="acct-lang">Preferred language</label>
									<select class="field__input" id="acct-lang" name="language">
										<option value="">No preference</option>
										{LANGUAGES.map(([v, l]) => <option value={v}>{l}</option>)}
										<option value="other">Another language</option>
									</select>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<div class="field" data-lang-other hidden>
									<label class="field__label" for="acct-lang-other"
										>Which language</label
									>
									<input
										class="field__input"
										id="acct-lang-other"
										name="languageOther"
										type="text"
										maxlength="40"
									/>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
							</section>

							<section class="block">
								<h2 class="block__title">How we reach you</h2>
								<div class="field">
									<label class="field__label" for="acct-phone">Phone</label>
									<input
										class="field__input"
										id="acct-phone"
										name="phone"
										type="tel"
										autocomplete="tel"
										placeholder="+91 98765 43210"
									/>
									<p class="note">
										With the country code. Leave it empty if you would rather we only
										wrote.
									</p>
									<p class="note note--wrong" data-field-error hidden></p>
								</div>
								<fieldset class="set">
									<legend class="field__label">You are happy to hear from us by</legend>
									<label class="check">
										<input type="checkbox" name="consentWhatsapp" />
										<span>WhatsApp</span>
									</label>
									<label class="check">
										<input type="checkbox" name="consentSms" />
										<span>SMS</span>
									</label>
									<label class="check">
										<input type="checkbox" name="consentEmail" />
										<span>Email</span>
									</label>
								</fieldset>
							</section>

							<section class="block">
								<h2 class="block__title">What you are here for</h2>
								<fieldset class="set">
									<legend class="u-visually-hidden">The areas you want</legend>
									{
										PILLARS.map(([v, l, accent]) => (
											<label class="check check--area" data-accent={accent}>
												<input type="checkbox" name="interests" value={v} />
												<span>{l}</span>
											</label>
										))
									}
								</fieldset>
							</section>
						</div>

						<section class="block block--wide">
							<h2 class="block__title">Where else to find you</h2>
							<p class="held__note">
								Optional, and shown on your profile. A handle or a whole address &mdash;
								we will tidy it either way. Leave one empty to remove it.
							</p>
							<div class="linkfields">
								{
									LINKS.map(([id, label, prefix]) => (
										<div class="field" data-link-field={id}>
											<label class="field__label" for={`acct-link-${id}`}>
												{label}
											</label>
											<div class="linkfields__row">
												{prefix && <span class="linkfields__prefix">{prefix}</span>}
												<input
													class="field__input"
													id={`acct-link-${id}`}
													name={`link_${id}`}
													type="text"
													maxlength="200"
													autocomplete="off"
													spellcheck="false"
												/>
											</div>
											<p class="note note--wrong" data-field-error hidden />
										</div>
									))
								}
							</div>
						</section>

						<p class="note note--wrong" data-edit-error role="alert" hidden></p>

						<div class="acct__actions">
							<button class="btn" type="submit" data-edit-save>Save changes</button>
							<button class="linkish" type="button" data-edit-cancel>Cancel</button>
						</div>
					</form>
				</section>

				<section data-panel="fail" hidden>
					<header class="acct__mast">
						<p class="acct__eyebrow">Your account</p>
						<h1 class="acct__title">That did not work.</h1>
						<p class="acct__lede" data-fail-note>Something went wrong at our end.</p>
					</header>
					<div class="acct__prose">
						<p>
							Try again in a moment. If it keeps happening, write to{' '}
							<a class="acct__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a
							> and we will sort it out by hand.
						</p>
						<p><button class="linkish" type="button" data-retry>Start again</button></p>
					</div>
				</section>
			</div>
		</main>

		<SiteFooter />
	</div>
</Base>

<style>
	/* The ground reaches the bottom of the window even when the record is
	   short, so the footer never sits on the dark behind the page. */
	.page {
		/* A 100vw child is wider than the content box when a scrollbar is
		   present, and that surplus must be clipped rather than scrolled. */
		overflow-x: clip;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		background: var(--cream);
	}

	.acct {
		flex: 1 0 auto;
		width: 100%;
		max-width: 58rem;
		margin: 0 auto;
		/* Only the nav's height at the top: the crown carries its own space and
		   should meet the bar rather than float below it. Panels without a
		   crown add the breathing room back themselves. */
		padding: var(--nav-h) var(--gutter) clamp(3rem, 8vh, 5rem);
	}

	/* Every panel except the record opens with words, and words need air. */
	[data-panel]:not([data-panel='record']) .acct__mast,
	[data-panel]:not([data-panel='record']) > form:first-child {
		padding-top: clamp(2.5rem, 7vh, 4.5rem);
	}

	/* ── The masthead ────────────────────────────────────────────────────── */

	/* Their name, at the size the home page gives its own lines. A record that
	   opens with a heading about somebody reads as a file on them; one that
	   opens with their name reads as theirs. */
	.acct__mast {
		padding-bottom: clamp(2rem, 5vh, 3rem);
		border-bottom: 1px solid var(--rule);
		margin-bottom: clamp(2rem, 5vh, 3rem);
	}

	.acct__eyebrow {
		font-family: var(--face-cinzel);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--teal);
		margin: 0 0 1rem;
	}

	.acct__title {
		margin: 0;
		font-family: var(--face-bodoni);
		font-size: clamp(2.25rem, 5.2vw, 3.5rem);
		font-weight: 450;
		line-height: 1.02;
		letter-spacing: -0.02em;
		color: var(--ink);
