	/* ── The profile ─────────────────────────────────────────────────────── */

	/* No labels anywhere in this block. Labels are what make a page read as a
	   form, and none of this is a form: it is a face, a name, a sentence
	   somebody wrote, and where else to find them. */
	.profile {
