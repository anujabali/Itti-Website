<script>
	import { supabase } from '../lib/supabase';
	import type { MyRegistration } from '../types/database';

	const root = document.querySelector<HTMLElement>('[data-account]');
	if (root) {
		root.hidden = false;

		const panels = new Map<string, HTMLElement>();
		for (const el of root.querySelectorAll<HTMLElement>('[data-panel]')) {
			panels.set(el.dataset.panel!, el);
		}

		/**
		 * One panel at a time, except the footnote, which belongs beneath the
		 * two panels where a record is in play and nowhere else.
		 */
		const show = (name: string) => {
			for (const [key, el] of panels) el.hidden = key !== name;
			const foot = panels.get('footnote');
			if (foot) foot.hidden = !(name === 'record' || name === 'edit');
		};

		const fail = (note: string) => {
			const el = root.querySelector<HTMLElement>('[data-fail-note]');
			if (el) el.textContent = note;
			show('fail');
		};

		// ── the words, not the codes ───────────────────────────────────────────

		const ROLE: Record<string, string> = {
			patient: 'Patient / Beneficiary',
			caregiver: 'Caregiver / Family Member',
			volunteer: 'Volunteer / Supporter',
			other: 'Member',
		};

		const GENDER: Record<string, string> = {
			woman: 'Female',
			man: 'Male',
			non_binary: 'Non-binary',
			self_described: 'Prefer to self-describe',
			undisclosed: 'Prefer not to say',
		};

		const LANG: Record<string, string> = {
			en: 'English',
			hi: 'Hindi',
			mr: 'Marathi',
			gu: 'Gujarati',
			bn: 'Bengali',
			ta: 'Tamil',
			te: 'Telugu',
			kn: 'Kannada',
			ml: 'Malayalam',
			pa: 'Punjabi',
			ur: 'Urdu',
			or: 'Odia',
			as: 'Assamese',
		};

		const PILLAR: Record<string, string> = {
			neurodivergence: 'Neurodivergence',
			cancer_care: 'Cancer Care',
			claw: 'CLAW',
			not_sure: "I'm not sure yet",
			other: 'Other',
		};

		const HEARD: Record<string, string> = {
			friend_family: 'A friend or family member',
			doctor_hospital: 'A doctor or hospital',
			event: 'An event',
			podcast: 'A podcast',
			instagram: 'Instagram',
			youtube: 'YouTube',
			whatsapp_group: 'A WhatsApp group',
			search: 'A search engine',
			news: 'The news',
			volunteer_staff: 'Someone from the foundation',
			other: 'Somewhere else',
		};

		let current: MyRegistration | null = null;

		/**
		 * The one thing the nav needs, kept where the nav can read it without
		 * asking anybody. It is their own name, in their own browser, and it is
		 * written only once they have proved the address is theirs.
		 *
		 * Storage can throw outright — a private window, a browser set to refuse
		 * site data — and none of that is a reason for the page to stop working,
		 * so every touch of it is guarded. The nav simply stays signed out.
		 */
		const WHO = 'itti.who';
		const remember = (name: string) => {
			try {
				if (name) localStorage.setItem(WHO, name);
				else localStorage.removeItem(WHO);
			} catch {
				/* Nothing to do: the nav falls back to its signed-out state. */
			}
			// The nav decided who it was greeting before this page had signed
			// anybody in, so telling storage is not enough — it would still read
			// "Join Us" above a record with the person's own name on it until
			// they happened to load another page. The nav listens for this.
			document.dispatchEvent(new CustomEvent('itti:who', { detail: name }));
		};

		/** The address for a handle, per provider. */
		const linkHref = (kind: string, handle: string) => {
			if (kind === 'email') return `mailto:${handle}`;
			if (kind === 'website') return handle;
			const base: Record<string, string> = {
				instagram: 'https://instagram.com/',
				facebook: 'https://facebook.com/',
				youtube: 'https://youtube.com/@',
				linkedin: 'https://linkedin.com/in/',
			};
			return (base[kind] ?? 'https://') + handle;
		};

		/** A web address read as a person would say it, not as it is stored. */
		const tidyUrl = (url: string) =>
			url
				.replace(/^https?:\/\//i, '')
				.replace(/^www\./i, '')
				.replace(/\/$/, '');

		const asDate = (iso: string) => {
			if (!iso) return '';
			const d = new Date(`${iso}T00:00:00`);
			return Number.isNaN(d.getTime())
				? iso
				: d.toLocaleDateString('en-GB', {
						day: '2-digit',
						month: 'short',
						year: 'numeric',
					});
		};

		/** The same lines the receipt shows, in the same order. */
		/** Spoken, not joined: "A and B", "A, B and C". */
		const sentence = (parts: string[]): string => {
			if (parts.length === 0) return '';
			if (parts.length === 1) return parts[0]!;
			return `${parts.slice(0, -1).join(', ')} and ${parts[parts.length - 1]}`;
		};

		/**
		 * The record as text, keyed by the field each value belongs to.
		 *
		 * A blank is a question nobody answered rather than a value, and the row
		 * for it is hidden rather than shown empty — a record full of dashes reads
		 * as a form somebody failed.
		 */
		const values = (r: MyRegistration): Record<string, string> => {
			const channels = [
				r.consentWhatsapp ? 'WhatsApp' : '',
				r.consentSms ? 'SMS' : '',
				r.consentEmail ? 'Email' : '',
			].filter(Boolean);

			return {
				fullName: r.fullName ?? '',
				role: ROLE[r.role] ?? r.role ?? '',
				dateOfBirth: asDate(r.dateOfBirth ?? ''),
				gender: r.genderOther || (GENDER[r.gender] ?? r.gender ?? ''),
				city: r.city ?? '',
				pincode: r.pincode ?? '',
				preferredLanguage: LANG[r.preferredLanguage] ?? r.preferredLanguage ?? '',
				email: r.email ?? '',
				phone: r.phone ?? '',
				channels: sentence(channels),
				guardianName: r.guardianName ?? '',
				guardianEmail: r.guardianEmail ?? '',
				guardianPhone: r.guardianPhone ?? '',
				heardFrom: r.heardFromOther || (HEARD[r.heardFrom] ?? ''),
				registeredAt: r.registeredAt ?? '',
			};
		};

		/**
		 * Fills the fields that are already in the markup rather than building
		 * any. Elements made here would carry no scope attribute, so every rule
		 * written for this page would silently miss them.
		 */
		const paint = (r: MyRegistration) => {
			const v = values(r);

			const name = (r.fullName ?? '').trim();
			const mast = root.querySelector<HTMLElement>('[data-mast-name]');
			if (mast) mast.textContent = name ? `${name}.` : 'Your record.';

			// The band closes with a hairline in the colour of what they are here
			// for — the one place a person's own areas touch the page's chrome.
			const wants: string[] = Array.isArray(r.interests) ? r.interests : [];
			const accent =
				{ neurodivergence: 'ochre', cancer_care: 'rose', claw: 'sage' }[
					['neurodivergence', 'cancer_care', 'claw'].find((k) => wants.includes(k)) ??
						''
				] ?? 'teal';
			root
				.querySelector<HTMLElement>('[data-crown-rule]')
				?.setAttribute('data-accent', accent);

			const bio = (r.bio ?? '').trim();
			const bioEl = root.querySelector<HTMLElement>('[data-bio]');
			const bioEmpty = root.querySelector<HTMLElement>('[data-bio-empty]');
			if (bioEl) {
				bioEl.textContent = bio;
				bioEl.hidden = bio === '';
			}
			if (bioEmpty) bioEmpty.hidden = bio !== '';

			// Where else to find them. The stored value is a handle; the address
			// is built here so it is consistent wherever it is shown.
			const links = (r.links ?? {}) as Record<string, string>;
			for (const el of root.querySelectorAll<HTMLElement>('[data-link]')) {
				const kind = el.dataset.link!;
				const handle = (links[kind] ?? '').trim();
				el.hidden = handle === '';
				if (!handle) continue;
				const a = el.querySelector<HTMLAnchorElement>('[data-link-a]');
				const text = el.querySelector<HTMLElement>('[data-link-text]');
				if (text) text.textContent = kind === 'website' ? tidyUrl(handle) : handle;
				if (a) {
					a.href = linkHref(kind, handle);
					// An address on somebody's profile is a place we are sending a
					// visitor, not a page of ours.
					if (kind !== 'email') {
						a.rel = 'me noopener nofollow ugc';
						a.target = '_blank';
					} else {
						a.removeAttribute('target');
						a.rel = 'me';
					}
				}
			}

			// Who they said they are, and how long we have had them — the two
			// things worth reading before any single field.
			const meta = root.querySelector<HTMLElement>('[data-mast-meta]');
			if (meta) {
				const bits = [v.role, v.registeredAt ? `with us since ${v.registeredAt}` : '']
					.filter(Boolean)
					.join(' \u00b7 ');
				meta.textContent = bits;
				meta.hidden = bits === '';
			}

			for (const el of root.querySelectorAll<HTMLElement>('[data-fact]')) {
				const key = el.dataset.fact!;
				const slot = el.querySelector<HTMLElement>('[data-value]');
				const text = v[key] ?? '';
				if (slot) slot.textContent = text;
				el.hidden = text === '';
			}

			const interests: string[] = Array.isArray(r.interests) ? r.interests : [];
			for (const el of root.querySelectorAll<HTMLElement>('[data-area]')) {
				el.hidden = !interests.includes(el.dataset.area!);
			}
			for (const el of root.querySelectorAll<HTMLElement>('[data-mark]')) {
				el.hidden = !interests.includes(el.dataset.mark!);
			}

			// A group with nothing under it is a heading over a gap. The guardian
			// block in particular belongs only to the people who have one.
			for (const group of root.querySelectorAll<HTMLElement>('[data-group]')) {
				if (group.dataset.group === 'areas') {
					group.hidden = interests.length === 0;
					continue;
				}
				const shown = [...group.querySelectorAll<HTMLElement>('[data-fact]')].some(
					(f) => !f.hidden,
				);
				group.hidden = !shown;
			}
		};

		// ── the edit form ──────────────────────────────────────────────────────

		const form = root.querySelector<HTMLFormElement>('[data-edit-form]');
		const genderOtherField = root.querySelector<HTMLElement>('[data-gender-other]');
		const langOtherField = root.querySelector<HTMLElement>('[data-lang-other]');
		const editError = root.querySelector<HTMLElement>('[data-edit-error]');

		const revealConditionals = () => {
			if (!form) return;
			const gender = (form.elements.namedItem('gender') as HTMLSelectElement).value;
			if (genderOtherField) genderOtherField.hidden = gender !== 'self_described';
			const lang = (form.elements.namedItem('language') as HTMLSelectElement).value;
			if (langOtherField) langOtherField.hidden = lang !== 'other';
		};

		const fill = (r: MyRegistration) => {
			if (!form) return;
			const set = (name: string, value: string) => {
				const el = form.elements.namedItem(name) as
					HTMLInputElement | HTMLSelectElement;
				if (el) el.value = value;
			};

			set('fullName', r.fullName ?? '');
			set('role', r.role ?? 'other');
			set('phone', r.phone ?? '');
			set('city', r.city ?? '');
			set('pincode', r.pincode ?? '');
			set('dateOfBirth', r.dateOfBirth ?? '');
			set('gender', r.gender ?? '');
			set('genderSelfDescribed', r.genderOther ?? '');
			set('bio', r.bio ?? '');
			countBio();

			const have = (r.links ?? {}) as Record<string, string>;
			for (const el of form.querySelectorAll<HTMLElement>('[data-link-field]')) {
				const kind = el.dataset.linkField!;
				const input = form.elements.namedItem(
					`link_${kind}`,
				) as HTMLInputElement | null;
				// The prefix is printed beside the box, so the box holds the handle
				// alone — and a website keeps its address, minus the scheme nobody
				// wants to read.
				if (input)
					input.value =
						kind === 'website' ? tidyUrl(have[kind] ?? '') : (have[kind] ?? '');
			}

			// Registration stores a code for the languages it lists and the typed
			// words for anything else. Anything unrecognised is therefore an
			// answer, not a bad value: put it in the free-text half.
			const lang: string = r.preferredLanguage ?? '';
			if (lang && !(lang in LANG)) {
				set('language', 'other');
				set('languageOther', lang);
			} else {
				set('language', lang);
				set('languageOther', '');
			}

			const interests: string[] = Array.isArray(r.interests) ? r.interests : [];
			for (const box of form.querySelectorAll<HTMLInputElement>(
				'input[name="interests"]',
			)) {
				box.checked = interests.includes(box.value);
			}

			const consents = ['consentWhatsapp', 'consentSms', 'consentEmail'] as const;
			for (const name of consents) {
				const box = form.elements.namedItem(name) as HTMLInputElement;
				if (box) box.checked = r[name];
			}

			revealConditionals();
			for (const field of form.querySelectorAll<HTMLElement>('[data-wrong]')) {
				delete field.dataset.wrong;
			}
			if (editError) {
				editError.hidden = true;
				editError.textContent = '';
			}
		};

		// Six hundred characters is a limit somebody should see approaching, not
		// discover by being refused.
		const countBio = () => {
			const box = form?.elements.namedItem('bio') as HTMLTextAreaElement | null;
			const out = root.querySelector<HTMLElement>('[data-bio-count]');
			if (box && out) out.textContent = String(box.value.length);
		};
		form?.addEventListener('input', (event) => {
			if ((event.target as HTMLElement).getAttribute('name') === 'bio') countBio();
		});

		form?.addEventListener('change', (event) => {
			const name = (event.target as HTMLElement).getAttribute('name');
			if (name === 'gender' || name === 'language') revealConditionals();
		});

		// ── loading the record ─────────────────────────────────────────────────

		const load = async () => {
			const { data, error } = await supabase.rpc('my_registration');
			if (error) {
				fail('We could not read your record just now.');
				return;
			}
			if (!data) {
				const { data: session } = await supabase.auth.getUser();
				const address = root.querySelector<HTMLElement>('[data-none-address]');
				if (address) address.textContent = session.user?.email ?? 'this address';
				remember('');
				show('none');
				return;
			}
			current = data;
			remember(current.fullName ?? '');
			paint(current);
			show('record');
		};

		// Supabase announces a session more than once — an initial event, a
		// sign-in, a token refresh — and `start` looks for one as well. Left
		// unguarded that ran the claim four times and the read three for a
		// single sign-in: harmless, because claiming is idempotent by design,
		// but four writes and three reads to answer a question nobody asked
		// twice.
		let opening: Promise<void> | null = null;

		const afterSignIn = () => (opening ??= openRecord());

		const openRecord = async () => {
			const { data, error } = await supabase.rpc('claim_registration');
			if (error) {
				fail('We could not open your record just now.');
				return;
			}
			// `claim_registration` reports why it could not bind; every reason
			// other than a missing registration is ours, not theirs.
			if (data && data.ok === false && data.reason !== 'no_registration') {
				fail('Your sign-in did not complete. Please ask for a new link.');
				return;
			}
			await load();
		};

		/** Signing out, or starting again, has to let the next sign-in through. */
		const reopen = () => {
			opening = null;
		};

		// ── sign in ────────────────────────────────────────────────────────────

		const signinForm = root.querySelector<HTMLFormElement>('[data-signin-form]');
		const signinGo = root.querySelector<HTMLButtonElement>('[data-signin-go]');
		// Verifying a code needs the address it was sent to, and the person
		// typing it should not have to give it twice.
		//
		// It outlives the page, because the obvious way to use a code is to go
		// and fetch it: open the mail app, come back, and on plenty of phones
		// coming back means a reload. Held in a variable alone, that stranded
		// somebody holding a perfectly good code with nothing to check it
		// against. Session storage, not local: it belongs to this attempt.
		const SENT = 'itti.sent-to';
		const readSentTo = () => {
			try {
				return sessionStorage.getItem(SENT) ?? '';
			} catch {
				return '';
			}
		};
		let sentTo = readSentTo();
		const rememberSentTo = (address: string) => {
			sentTo = address;
			try {
				if (address) sessionStorage.setItem(SENT, address);
				else sessionStorage.removeItem(SENT);
			} catch {
				/* The code still works for as long as this page stays open. */
			}
		};

		signinForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const input = signinForm.elements.namedItem('email') as HTMLInputElement;
			const email = input.value.trim();
			if (!email || !input.checkValidity()) {
				input.focus();
				return;
			}

			if (signinGo) {
				signinGo.disabled = true;
				signinGo.textContent = 'Sending';
			}

			const { error } = await supabase.auth.signInWithOtp({
				email,
				options: { emailRedirectTo: `${window.location.origin}/account` },
			});

			if (signinGo) {
				signinGo.disabled = false;
				signinGo.textContent = 'Send me a link';
			}

			if (error) {
				// One message per address per minute. Somebody who presses the
				// button twice is not looking at a broken site, and telling them
				// so sends them away from a link already in their inbox.
				if (error.status === 429) {
					if (sentTo === email) {
						show('sent');
						(root.querySelector('#acct-code') as HTMLInputElement | null)?.focus();
					} else {
						fail(
							'We have already sent one to that address in the last minute. Check your email, or try again shortly.',
						);
					}
					return;
				}
				fail('We could not send that link just now.');
				return;
			}

			// The same words whether or not we hold a registration for it. Which
			// addresses are on our list is not something a stranger gets to
			// learn by typing them in one at a time.
			rememberSentTo(email);
			const shown = root.querySelector<HTMLElement>('[data-sent-address]');
			if (shown) shown.textContent = email;
			show('sent');
			(root.querySelector('#acct-code') as HTMLInputElement | null)?.focus();
		});

		// ── the code, for when the link is on the wrong device ─────────────────
		//
		// The same message carries both. A link is one tap where it opens in the
		// browser that asked for it, and useless where it does not — people read
		// email on whichever device is nearest. The code does not care.

		const codeForm = root.querySelector<HTMLFormElement>('[data-code-form]');
		const codeGo = root.querySelector<HTMLButtonElement>('[data-code-go]');
		const codeError = root.querySelector<HTMLElement>('[data-code-error]');

		const sayCode = (message: string) => {
			if (!codeError) return;
			codeError.textContent = message;
			codeError.hidden = false;
		};

		codeForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const input = codeForm.elements.namedItem('token') as HTMLInputElement;
			// People read a code off a screen and type it back with the spaces
			// they saw, so take the digits and ignore the rest.
			const token = input.value.replace(/\D/g, '');
			if (codeError) codeError.hidden = true;

			if (token.length !== 6) {
				sayCode('The code is six digits.');
				input.focus();
				return;
			}
			if (!sentTo) {
				sayCode('Give us your email address above first, and we will send you a code.');
				return;
			}

			if (codeGo) {
				codeGo.disabled = true;
				codeGo.textContent = 'Checking';
			}

			const { error } = await supabase.auth.verifyOtp({
				email: sentTo,
				token,
				type: 'email',
			});

			if (codeGo) {
				codeGo.disabled = false;
				codeGo.textContent = 'Sign me in';
			}

			if (error) {
				// Wrong, already used, or older than an hour. The page cannot tell
				// which, and guessing at it out loud would be worse than not.
				sayCode('That code did not work. It expires after an hour and works once.');
				input.select();
				return;
			}
			// A success fires SIGNED_IN, which is already wired to open the record.
		});

		root.querySelector('[data-signin-again]')?.addEventListener('click', () => {
			show('signin');
			(root.querySelector('#acct-email') as HTMLInputElement | null)?.focus();
		});

		for (const button of root.querySelectorAll('[data-signout]')) {
			button.addEventListener('click', async () => {
				await supabase.auth.signOut();
				current = null;
				remember('');
				rememberSentTo('');
				reopen();
				show('signin');
			});
		}

		root.querySelector('[data-retry]')?.addEventListener('click', () => {
			reopen();
			show('loading');
			void start();
		});

		// ── editing ────────────────────────────────────────────────────────────

		root.querySelector('[data-edit-open]')?.addEventListener('click', () => {
			if (!current) return;
			const saved = root.querySelector<HTMLElement>('[data-saved]');
			if (saved) saved.hidden = true;
			fill(current);
			show('edit');
			(root.querySelector('#acct-name') as HTMLInputElement | null)?.focus();
		});

		root.querySelector('[data-edit-cancel]')?.addEventListener('click', () => {
			show('record');
		});

		const save = root.querySelector<HTMLButtonElement>('[data-edit-save]');
		let savedFor = 0;

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!form) return;

			for (const field of form.querySelectorAll<HTMLElement>('[data-wrong]')) {
				delete field.dataset.wrong;
			}
			for (const slot of form.querySelectorAll<HTMLElement>('[data-field-error]')) {
				slot.textContent = '';
				slot.hidden = true;
			}
			for (const el of form.querySelectorAll('[aria-invalid]')) {
				el.removeAttribute('aria-invalid');
				el.removeAttribute('aria-describedby');
			}

			const value = (name: string) =>
				(
					(form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement)
						?.value ?? ''
				).trim();
			const checked = (name: string) =>
				Boolean((form.elements.namedItem(name) as HTMLInputElement)?.checked);

			const language = value('language');
			const payload = {
				fullName: value('fullName'),
				role: value('role'),
				// Spaces are how people write a phone number and not how E.164
				// stores one. Strip them here rather than refusing the number.
				phone: value('phone').replace(/[\s()-]/g, ''),
				city: value('city'),
				pincode: value('pincode'),
				dateOfBirth: value('dateOfBirth'),
				gender: value('gender'),
				genderSelfDescribed: value('genderSelfDescribed'),
				preferredLanguage: language === 'other' ? value('languageOther') : language,
				interests: [
					...form.querySelectorAll<HTMLInputElement>('input[name="interests"]:checked'),
				].map((b) => b.value),
				bio: value('bio'),
				// Every kind is sent, including the empty ones: an empty value is
				// how somebody removes a link, and a kind left out of the object
				// would simply be left alone.
				links: Object.fromEntries(
					[...form.querySelectorAll<HTMLElement>('[data-link-field]')].map((el) => [
						el.dataset.linkField!,
						value(`link_${el.dataset.linkField}`),
					]),
				),
				consentWhatsapp: checked('consentWhatsapp'),
				consentSms: checked('consentSms'),
				consentEmail: checked('consentEmail'),
			};

			if (save) {
				save.disabled = true;
				save.textContent = 'Saving';
			}

			const { data, error } = await supabase.rpc('update_my_registration', { payload });

			if (save) {
				save.disabled = false;
				save.textContent = 'Save changes';
			}

			if (error) {
				if (editError) {
					editError.textContent = 'We could not save that just now. Please try again.';
					editError.hidden = false;
				}
				return;
			}

			if (data && data.ok === false) {
				const message = data.message ?? 'Please check that and try again.';
				// `.field`, not `.acct__field`: the class was renamed when this page
				// stopped borrowing the document layout, and a selector that matches
				// nothing fails silently.
				// A refusal about a link names the kind — `instagram` — while the
				// input is called `link_instagram`, so both spellings are tried.
				const field = data.field
					? (form.querySelector<HTMLElement>(`.field:has([name="${data.field}"])`) ??
						form.querySelector<HTMLElement>(
							`.field:has([name="link_${data.field}"])`,
						) ??
						form.querySelector<HTMLElement>(
							`.field:has([name="link_${String(data.field).replace(/_link$/, '')}"])`,
						))
					: null;

				// The message goes under the line it is about. Focusing the field
				// scrolls to it, so a message anywhere else — the foot of the form,
				// say — is carried off the screen by the very act of pointing at it,
				// leaving a reddened rule and no reason for it.
				const slot = field?.querySelector<HTMLElement>('[data-field-error]');
				const control = field?.querySelector<HTMLInputElement | HTMLSelectElement>(
					'input, select',
				);
				if (field && slot && control) {
					field.dataset.wrong = '';
					slot.textContent = message;
					slot.hidden = false;
					// Named after the control it belongs to, so a screen reader reads
					// the reason with the field rather than as a loose announcement.
					slot.id ||= `${control.name}-wrong`;
					control.setAttribute('aria-invalid', 'true');
					control.setAttribute('aria-describedby', slot.id);
					control.focus();
					if (editError) editError.hidden = true;
				} else if (editError) {
					// Nothing to point at — a refusal about the form as a whole.
					editError.textContent = message;
					editError.hidden = false;
				}
				return;
			}

			await load();

			// Saving returns them to the record, where the change is its own
			// evidence — but only if they happen to be looking at the line they
			// changed. A live region says it once, for the people reading the
			// page and for anyone listening to it.
			const saved = root.querySelector<HTMLElement>('[data-saved]');
			if (saved) {
				saved.hidden = false;
				window.clearTimeout(savedFor);
				savedFor = window.setTimeout(() => {
					saved.hidden = true;
				}, 4000);
			}
		});

		// ── start ──────────────────────────────────────────────────────────────

		const start = async () => {
			const { data } = await supabase.auth.getSession();
			if (data.session) {
				await afterSignIn();
			} else if (sentTo) {
				// Came back with a code in hand. Landing them on the email form
				// again invites them to ask for a second one, which is throttled,
				// and to abandon a code that is still perfectly good.
				const shown = root.querySelector<HTMLElement>('[data-sent-address]');
				if (shown) shown.textContent = sentTo;
				show('sent');
				(root.querySelector('#acct-code') as HTMLInputElement | null)?.focus();
			} else {
				show('signin');
			}
		};

		// Arriving from the link, the session is set while the page is already
		// running. Waiting for the event rather than for getSession alone is
		// what makes the link land on the record instead of on the sign-in form.
		supabase.auth.onAuthStateChange((event) => {
			if (event === 'SIGNED_IN') void afterSignIn();
		});

		void start();
	}
</script>
