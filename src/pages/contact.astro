---
/**
 * Contact.
 *
 * One address, because one address is what exists and is answered. A page that
 * lists five routes and answers one is worse than a page that lists one; the
 * headings below route the enquiry rather than multiplying the destinations.
 *
 * Unlike privacy and terms, the sections here are not numbered — nothing
 * cross-references them, and numbering a contact page reads as bureaucracy.
 *
 * The phone number and the three accounts are the ones the Foundation
 * confirmed. Each was checked to resolve before it was linked; a dead account
 * on a contact page is worse than no account. If one is closed, remove it here
 * rather than leaving it to rot.
 */
import Doc from '../layouts/Doc.astro';
---

<Doc
	title="Contact — The Itti Foundation"
	description="How to reach The Itti Foundation: general enquiries, data protection, accessibility, media and partnerships, and our response times."
	eyebrow="Contact"
	heading="Contact"
	lede="One address, answered by people. Below is how to reach us and what to expect."
>
	<section class="doc__section">
		<h2 class="doc__h">General enquiries</h2>
		<div class="doc__body">
			<p>
				<strong>Email:</strong>{' '}
				<a class="doc__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a><br />
				<strong>Telephone:</strong>{' '}
				<a class="doc__link" href="tel:+918928263631">+91 89282 63631</a>
			</p>
			<p>
				The address is read by people at the Foundation, not by a ticketing system. You do
				not need to know which part of our work your question belongs to: send it and we
				will pass it to whoever should have it.
			</p>
			<p>
				The telephone is a working number rather than a staffed line. If nobody answers,
				please write instead and we will come back to you.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Response times</h2>
		<div class="doc__body">
			<p>
				We respond to email within <strong>five working days</strong>. Requests concerning
				your personal data are acknowledged within five working days and completed within
				thirty days, as set out in our{' '}
				<a class="doc__link" href="/privacy">Privacy Policy</a>.
			</p>
			<p>
				Messages sent through social media reach us, but more slowly than the address
				above.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">What to write about</h2>
		<div class="doc__body">
			<p>
				It helps to say roughly what your message concerns, because that determines who
				reads it next.
			</p>
			<dl class="doc__list">
				<dt>Taking part</dt>
				<dd>
					Whether as someone we can help, someone caring for another person, a volunteer
					or a partner. The quickest route is{' '}
					<a class="doc__link" href="/join">our registration form</a>, which asks the few
					things we need in order to reach you properly. An email is equally welcome.
				</dd>
				<dt>Your personal data</dt>
				<dd>
					To access, correct or erase what we hold about you, or to withdraw a permission
					you gave us. Most of this can be done directly on your{' '}
					<a class="doc__link" href="/account">account page</a>.
				</dd>
				<dt>Media and partnerships</dt>
				<dd>
					Press enquiries, and organisations proposing joint work. Please say what you
					have in mind and who you are.
				</dd>
			</dl>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Data protection</h2>
		<div class="doc__body">
			<p>
				<strong>Grievance Officer:</strong> Anuja Bali<br />
				<strong>Email:</strong>{' '}
				<a class="doc__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a>
			</p>
			<p>
				Please mark data protection requests clearly so they are routed correctly. What we
				hold, why, and the rights you have over it are set out in our{' '}
				<a class="doc__link" href="/privacy">Privacy Policy</a>.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Accessibility</h2>
		<div class="doc__body">
			<p>
				If any part of this site was difficult to read, could not be reached with a
				keyboard, or behaved unexpectedly, please tell us at the address above. Our{' '}
				<a class="doc__link" href="/accessibility">Accessibility Statement</a> records what
				we already know to be wrong.
			</p>
			<p>
				If something here prevents you from registering, say so and we will take your
				details by whatever means is easiest for you.
			</p>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Social media</h2>
		<div class="doc__body">
			<dl class="doc__list">
				<dt>Instagram</dt>
				<dd>
					<a
						class="doc__link"
						href="https://www.instagram.com/ittifoundation/"
						rel="me noopener">@ittifoundation</a
					>
				</dd>
				<dt>Facebook</dt>
				<dd>
					<a
						class="doc__link"
						href="https://www.facebook.com/ittifoundation"
						rel="me noopener">@ittifoundation</a
					>
				</dd>
				<dt>YouTube</dt>
				<dd>
					<a
						class="doc__link"
						href="https://www.youtube.com/@ittifoundation"
						rel="me noopener">@ittifoundation</a
					>
				</dd>
			</dl>
		</div>
	</section>

	<section class="doc__section">
		<h2 class="doc__h">Urgent help</h2>
		<div class="doc__body">
			<p>
				<strong>We are not a crisis service and not a medical service.</strong> None of the
				routes above is monitored overnight, and five working days is far too slow to be of
				use to someone in danger.
			</p>
			<p>
				If you or someone near you needs help now, please contact your local emergency
				services or a crisis helpline in your country rather than waiting on us.
			</p>
			<p>
				Nothing we write in reply constitutes medical, legal or financial advice. See our{' '}
				<a class="doc__link" href="/terms">Terms of Use</a>.
			</p>
		</div>
	</section>
</Doc>
