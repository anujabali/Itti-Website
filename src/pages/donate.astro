		const button = card.querySelector<HTMLButtonElement>('[data-give]');
		const state = card.querySelector<HTMLElement>('[data-state]');
		const interim = card.querySelector<HTMLElement>('[data-interim]');

		const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
		let amount = Number(chips[1]?.dataset.amount ?? 0);
		let working = false;

		const say = () => {
			if (!label) return;
			label.textContent = amount > 0 ? `Give ${rupees(amount)}` : 'Give';
		};

		const tell = (message: string) => {
			if (!state) return;
			state.textContent = message;
			state.hidden = !message;
		};

		/** The pressed amount is whichever preset the figure currently reads, and
		 *  `Other` whenever it reads something else. Derived from the figure
		 *  rather than tracked alongside it, so the two cannot disagree. */
		let typing = false;
		const press = () => {
			let matched = false;
			for (const chip of chips) {
				const is = !typing && Number(chip.dataset.amount) === amount;
				chip.setAttribute('aria-pressed', String(is));
				matched ||= is;
			}
			other?.setAttribute('aria-pressed', String(!matched));
		};

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				amount = Number(chip.dataset.amount);
				typing = false;
				if (own) own.value = amount.toLocaleString('en-IN');
				press();
				tell('');
				say();
			});
		}

		// Nothing to reveal: the figure is already the field, so `Other` empties
		// it and hands it over. Left showing the last preset it looked as though
		// the press had done nothing.
		other?.addEventListener('click', () => {
			typing = true;
			amount = 0;
			if (own) own.value = '';
			own?.focus();
			press();
			tell('');
			say();
		});

		own?.addEventListener('input', () => {
			// Digits only, and grouped the way the fixed amounts are, so a typed
			// number and a pressed one read as the same kind of number.
			const digits = own.value.replace(/\D/g, '').slice(0, 8);
			typing = true;
			amount = Number(digits) || 0;
			own.value = amount > 0 ? amount.toLocaleString('en-IN') : '';
			press();
			tell('');
			say();
		});

		/** Loaded once, on demand, and remembered. */
		let checkout: Promise<void> | null = null;
		const gateway = () => {
			checkout ??= new Promise<void>((resolve, reject) => {
				const tag = document.createElement('script');
				tag.src = CHECKOUT;
				tag.onload = () => resolve();
				tag.onerror = () => {
					checkout = null;
					reject(new Error('checkout script'));
				};
				document.head.append(tag);
			});
			return checkout;
		};

		const call = async (body: Record<string, unknown>) => {
			const res = await fetch(`${SUPABASE_URL}/functions/v1/donations`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					apikey: SUPABASE_KEY,
					Authorization: `Bearer ${SUPABASE_KEY}`,
				},
				body: JSON.stringify(body),
			});
			return { ok: res.ok, data: await res.json().catch(() => ({})) };
		};

		const fallback = () => {
			tell('');
			if (interim) interim.hidden = false;
		};

		button?.addEventListener('click', async () => {
			if (working) return;
			// The same two bounds the function enforces, said here so the answer
			// comes back in the card rather than from the server.
			if (amount > 500000) {
				tell('The largest gift this page can take is ₹5,00,000. Write to us for more.');
				own?.focus();
				return;
			}

			if (amount < 100) {
				tell('The smallest gift this page can take is ₹100.');
				own?.focus();
				return;
			}

			working = true;
			if (button) button.disabled = true;
			tell('Opening the payment window…');

			try {
				const order = await call({
					action: 'create',
					amountPaise: amount * 100,
					pillar:
						card.querySelector<HTMLInputElement>('input[name="area"]:checked')?.value ||
						null,
				});

				if (!order.ok) {
					fallback();
					return;
				}

				await gateway();

				const rzp = new (window as unknown as { Razorpay: new (o: unknown) => {
					open: () => void;
					on: (e: string, h: (r: unknown) => void) => void;
				} }).Razorpay({
					key: order.data.keyId,
					order_id: order.data.orderId,
					amount: order.data.amountPaise,
					currency: 'INR',
					name: 'The Itti Foundation',
					description: order.data.test ? 'Test donation' : 'Donation',
					// Razorpay draws its own window; these are the only two colours
					// of ours it takes.
					theme: { color: '#1c6b77', backdrop_color: 'rgba(15,20,21,0.72)' },
					handler: async (response: Record<string, string>) => {
						tell('Confirming…');
						const done = await call({
							action: 'verify',
							orderId: response.razorpay_order_id,
							paymentId: response.razorpay_payment_id,
							signature: response.razorpay_signature,
						});
						tell(
							done.ok
								? 'Thank you. Your gift has arrived, and an acknowledgement is on its way to you.'
								: 'Your payment went through, but we could not confirm it here. Write to hello@itti.org.in and we will sort it out.',
						);
						if (button) button.disabled = true;
					},
					modal: {
						ondismiss: () => {
							tell('');
							working = false;
							if (button) button.disabled = false;
						},
					},
				});

				rzp.on('payment.failed', () => {
					tell('That payment did not go through. You can try again, or write to us.');
					working = false;
					if (button) button.disabled = false;
				});

				rzp.open();
			} catch (e) {
				console.error('[itti/donate]', e);
				fallback();
			} finally {
				// The modal keeps the click alive until it is dismissed, so the button
				// is released by ondismiss rather than here.
				if (interim && !interim.hidden) {
					working = false;
					if (button) button.disabled = false;
				}
			}
		});

		say();
	}
</script>

<script>
	/**
	 * Sections arrive as they are reached.
	 *
	 * Armed from here rather than from the stylesheet, so a reader without
	 * JavaScript gets the whole page rather than a blank one — the hidden state
	 * only ever exists if something is running that can undo it.
	 *
	 * The observer releases each element once and then stops watching it. A
	 * reveal that runs again on the way back up is a page that will not settle.
	 */
	const revealing = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (revealing.length > 0 && !still && 'IntersectionObserver' in window) {
		for (const el of revealing) el.classList.add('is-armed');

		const watcher = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					// Siblings in the same row follow each other rather than landing
					// together, which reads as one movement instead of three.
					const peers = [...(el.parentElement?.children ?? [])].filter((n) =>
						(n as HTMLElement).dataset?.reveal !== undefined,
					);
					const place = peers.indexOf(el);
					if (peers.length > 1 && place > 0) el.style.setProperty('--delay', `${place * 90}ms`);
					el.classList.add('is-in');
					watcher.unobserve(el);
				}
			},
			// Released a little before the element's top edge arrives, so the
			// movement finishes about when the reader gets there.
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
		);

		for (const el of revealing) watcher.observe(el);
	}
</script>
