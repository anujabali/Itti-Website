<script is:inline>
	// ──────────────────────────────────────────────────────────────────────────
	// Interactive Dialog Handler for Memory Submission & Archival Drawers
	// ──────────────────────────────────────────────────────────────────────────
	document.addEventListener('DOMContentLoaded', () => {
		const memDialog = document.getElementById('memory-dialog');
		const openMemBtn = document.getElementById('open-memory-btn');
		const closeMemTriggers = document.querySelectorAll('[data-close-dialog]');
		const memForm = document.getElementById('memory-form');
		const memSuccess = document.getElementById('mem-success');

		// Open Memory Dialog
		if (openMemBtn && memDialog) {
			openMemBtn.addEventListener('click', () => {
				if (typeof memDialog.showModal === 'function') {
					memDialog.showModal();
				} else {
					memDialog.setAttribute('open', '');
				}
			});
		}

		// Close Memory Dialog
		closeMemTriggers.forEach((btn) => {
			btn.addEventListener('click', () => {
				if (typeof memDialog?.close === 'function') {
					memDialog.close();
				} else {
					memDialog?.removeAttribute('open');
				}
			});
		});

		// Photo / Video file handling (max 25 MB)
		const uploadZone = document.getElementById('memory-upload-zone');
		const mediaInput = document.getElementById('mem-media');
		const uploadPrompt = document.getElementById('mem-upload-prompt');
		const uploadPreview = document.getElementById('mem-upload-preview');
		const uploadThumb = document.getElementById('mem-upload-thumb');
		const filenameEl = document.getElementById('mem-filename');
		const filesizeEl = document.getElementById('mem-filesize');
		const removeFileBtn = document.getElementById('mem-remove-file');
		const uploadError = document.getElementById('mem-upload-error');

		const MAX_SIZE_MB = 25;
		const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;
		let currentObjectUrl = null;

		const formatFileSize = (bytes) => {
			if (bytes < 1024 * 1024) {
				return (bytes / 1024).toFixed(1) + ' KB';
			}
			return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
		};

		const resetMediaInput = () => {
			if (mediaInput) mediaInput.value = '';
			if (currentObjectUrl) {
				URL.revokeObjectURL(currentObjectUrl);
				currentObjectUrl = null;
			}
			if (uploadThumb) uploadThumb.innerHTML = '';
			if (uploadPreview) uploadPreview.hidden = true;
			if (uploadPrompt) uploadPrompt.hidden = false;
			if (uploadError) {
				uploadError.hidden = true;
				uploadError.textContent = '';
			}
			if (uploadZone) uploadZone.classList.remove('has-file', 'has-error');
		};

		const handleFile = (file) => {
			if (!file) return;

			if (uploadError) {
				uploadError.hidden = true;
				uploadError.textContent = '';
			}
			if (uploadZone) uploadZone.classList.remove('has-error');

			// Validate maximum size (25 MB)
			if (file.size > MAX_SIZE_BYTES) {
				if (uploadError) {
					uploadError.textContent = `File size (${formatFileSize(file.size)}) exceeds the ${MAX_SIZE_MB} MB limit. Please choose a smaller photo or video.`;
					uploadError.hidden = false;
				}
				if (uploadZone) uploadZone.classList.add('has-error');
				resetMediaInput();
				return;
			}

			if (currentObjectUrl) {
				URL.revokeObjectURL(currentObjectUrl);
				currentObjectUrl = null;
			}

			if (filenameEl) filenameEl.textContent = file.name;
			if (filesizeEl) filesizeEl.textContent = formatFileSize(file.size);

			if (uploadThumb) {
				uploadThumb.innerHTML = '';
				currentObjectUrl = URL.createObjectURL(file);
				if (file.type.startsWith('image/')) {
					const img = document.createElement('img');
					img.src = currentObjectUrl;
					img.alt = file.name;
					uploadThumb.appendChild(img);
				} else if (file.type.startsWith('video/')) {
					const vid = document.createElement('video');
					vid.src = currentObjectUrl;
					vid.muted = true;
					vid.playsInline = true;
					uploadThumb.appendChild(vid);
				} else {
					uploadThumb.innerHTML =
						'<span class="memory-upload__thumb-icon">&#128196;</span>';
				}
			}

			if (uploadPrompt) uploadPrompt.hidden = true;
			if (uploadPreview) uploadPreview.hidden = false;
			if (uploadZone) {
				uploadZone.classList.remove('has-error');
				uploadZone.classList.add('has-file');
			}
		};

		if (mediaInput) {
			mediaInput.addEventListener('change', () => {
				const file = mediaInput.files?.[0];
				if (file) handleFile(file);
			});
		}

		if (removeFileBtn) {
			removeFileBtn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation();
				resetMediaInput();
			});
		}

		// Drag and drop handling
		if (uploadZone) {
			['dragenter', 'dragover'].forEach((eventName) => {
				uploadZone.addEventListener(eventName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					uploadZone.classList.add('is-dragover');
				});
			});

			['dragleave', 'drop'].forEach((eventName) => {
				uploadZone.addEventListener(eventName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					uploadZone.classList.remove('is-dragover');
				});
			});

			uploadZone.addEventListener('drop', (e) => {
				const dt = e.dataTransfer;
				const file = dt?.files?.[0];
				if (file) {
					if (mediaInput) {
						mediaInput.files = dt.files;
					}
					handleFile(file);
				}
			});
		}

		// Share Memory Submission
		if (memForm && memSuccess) {
			memForm.addEventListener('submit', (event) => {
				event.preventDefault();

				const mediaFile = mediaInput?.files?.[0];

				const said = new FormData(memForm);
				const field = (name) => String(said.get(name) || '').trim();
				const place = field('place');
				// A mailto cannot carry a file, so the note asks for the attachment
				// rather than announcing it. A letter that says "attached" of a file it
				// does not hold leaves the family hunting for something that never came.
				const mediaAttachmentNote = mediaFile
					? `Please attach to this email: ${mediaFile.name} (${formatFileSize(mediaFile.size)})`
					: '';

				const letter = [
					`Name: ${field('name')}`,
					`Email: ${field('email')}`,
					`Connection: ${field('relation')}`,
					`Year or place: ${place}`,
					mediaAttachmentNote,
					'',
					field('story'),
				]
					.filter((line, index) => line !== '' || index === 5)
					.join('\n');

				window.location.href =
					'mailto:hello@itti.org.in?subject=' +
					encodeURIComponent('Memory of Dr. Itti Bali') +
					'&body=' +
					encodeURIComponent(letter);

				memSuccess.removeAttribute('hidden');
			});
		}

		// Archival Drawers Dialog
		const archDialog = document.getElementById('archive-dialog');
		const archTriggers = document.querySelectorAll('[data-open-drawer]');
		const closeArchTriggers = document.querySelectorAll('[data-close-archive]');
		const drawerArticles = document.getElementById('drawer-articles');
		const drawerFilm = document.getElementById('drawer-film');
		const drawerAwards = document.getElementById('drawer-awards');

		const hideAllDrawers = () => {
			drawerArticles?.setAttribute('hidden', '');
			drawerFilm?.setAttribute('hidden', '');
			drawerAwards?.setAttribute('hidden', '');
		};

		const drawers = {
			articles: drawerArticles,
			film: drawerFilm,
			awards: drawerAwards,
		};

		archTriggers.forEach((btn) => {
			btn.addEventListener('click', () => {
				const drawer = drawers[btn.getAttribute('data-open-drawer')];
				if (!drawer) return;

				hideAllDrawers();
				drawer.removeAttribute('hidden');

				// One dialog holds three drawers, so its name has to be whichever one
				// is open. Pointed at a single heading, the film and the honours were
				// both announced as the published articles.
				const title = drawer.querySelector('.legacy-dialog__title');
				if (title && archDialog) {
					if (!title.id) title.id = `${drawer.id}-title`;
					archDialog.setAttribute('aria-labelledby', title.id);
				}

				if (typeof archDialog?.showModal === 'function') {
					archDialog.showModal();
				} else {
					archDialog?.setAttribute('open', '');
				}
			});
		});

		closeArchTriggers.forEach((btn) => {
			btn.addEventListener('click', () => {
				if (typeof archDialog?.close === 'function') {
					archDialog.close();
				} else {
					archDialog?.removeAttribute('open');
				}
			});
		});
	});
</script>
