---
/**
 * Legacy — Dr. Archana "Itti" Bali
 *
 * Route: /our-story/legacy (canonical redirect from /legacy)
 *
 * Implements the exact design format of the website (as seen in the 404/Not Found template):
 * - Deep signature brand teal canvas with radial glow and linear descent
 * - Paper grain overlay texture
 * - The Itti Foundation mark centered in the middle as an ambient watermark
 * - Prominent BOLD display title in Bodoni Moda (font-weight: 700)
 * - The signature cream/paper cards (.way) with subtle left-edge indicator,
 *   crisp dark ink typography, and responsive grid layout
 * - Interactive dialogs for Archival materials and Memory submissions
 * - Founder credentials
 */
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Mark from '../../components/brand/Mark.astro';

interface Milestone {
	id: string;
	when: string;
	where: string;
	title: string;
	description: string;
	major?: boolean;
}

const LIFE_MILESTONES: Milestone[] = [
	{
		id: 'birth',
		when: '8 April',
		where: 'India',
		title: 'Born the youngest of three',
		description:
			'Hardworking, straightforward and warm from the start. She studied at a government school, and the habit of earning her own way began early — it would carry her the rest of the distance.',
		major: true,
	},
	{
		id: 'undergrad',
		when: 'Undergraduate',
		where: 'Indore',
		title: 'A degree she paid for herself',
		description:
			'She earned a degree in Computer Science in Indore, tutoring other students through her college years to fund her own education. Nothing she had was handed to her.',
		major: false,
	},
	{
		id: 'niit',
		when: 'First job',
		where: 'NIIT, Bhopal',
		title: 'Teaching, before conservation',
		description:
			'Her working life began in Bhopal with NIIT — teaching, well before she ever set out to study a forest.',
		major: false,
	},
	{
		id: 'greenpeace',
		when: 'Move to Bombay',
		where: 'Greenpeace',
		title: 'Training people, opening doors',
		description:
			'She moved to Bombay to join Greenpeace, training young volunteers and helping start new branch offices — the first sign of a working life spent building things other people could grow into.',
		major: false,
	},
	{
		id: 'ncbs',
		when: 'Masters in Science',
		where: 'NCBS, Bangalore',
		title: 'The first batch',
		description:
			'She moved to Bangalore for her Master’s at the National Centre for Biological Sciences, in the very first-ever batch of its MSc in Wildlife Biology, under the mentorship of the conservation scientist Dr. Ulhas Karanth.',
		major: true,
	},
	{
		id: 'chikmagalur',
		when: 'Fieldwork',
		where: 'Chikmagalur',
		title: 'Coffee estates and wild ground',
		description:
			'Her Master’s research took her into the coffee estates of Chikmagalur, studying how cultivation and wild country could share the same hillside.',
		major: false,
	},
	{
		id: 'schaller',
		when: 'George Schaller Scholar',
		where: 'Univ. of Alaska Fairbanks',
		title: 'The first Schaller scholar',
		description:
			'She was chosen for the first George Schaller Scholarship ever awarded, to read for a doctorate in human–animal interdependence — the question she had been circling all along: how people and animals live off the same ground.',
		major: true,
	},
	{
		id: 'knee',
		when: 'Days before flight',
		where: 'India to Fairbanks',
		title: 'Two weeks, one knee',
		description:
			'A bike accident tore her ACL days before she was due to leave. Surgery was arranged urgently, and she pushed herself to be travel-ready within a fortnight — managing two connections in a wheelchair to land in Fairbanks on time.',
		major: false,
	},
	{
		id: 'alaska',
		when: 'Seven years',
		where: 'Fairbanks, Alaska',
		title: 'Alaska became home',
		description:
			'Friends, family and colleagues travelled all that way to see her, and she hosted every one of them properly — Denali National Park, moose, glaciers, dog-mushing races, the northern lights, and the summer day that never ends.',
		major: true,
	},
	{
		id: 'voices-project',
		when: 'The Voices Project',
		where: 'Native Alaskan communities',
		title: 'An award-winning film',
		description:
			'Alongside her research, she worked with Native Alaskan communities on the Voices Project, an award-winning documentary — her storytelling turned toward the people whose land and knowledge shaped her own work.',
		major: true,
	},
	{
		id: 'diagnosis',
		when: '8 January 2013',
		where: 'Winter break, India',
		title: 'Three months, they said',
		description:
			'She was home for the winter when the diagnosis came: ovarian cancer. The doctors gave her three months. She chose to fly back to the United States and have surgery at New York Presbyterian Hospital.',
		major: true,
	},
	{
		id: 'resilience',
		when: '2013 – 2014',
		where: 'New York & conferences',
		title: 'Twenty-two months, she said',
		description:
			'Through recurring infections and the side effects of treatment, she kept working. She travelled abroad to present her papers. She completed her doctorate. Against every projection, determination, grit and resilience bought her twenty-two months.',
		major: true,
	},
	{
		id: 'farewell',
		when: '8 September 2014',
		where: 'New York',
		title: 'She called everyone to New York',
		description:
			'When she was told no further treatment was possible, she did what she had always done — she organised. Family, childhood friends and cousins came from across the world, and she took her last breath with them in the room.',
		major: true,
	},
	{
		id: 'posthumous',
		when: '2016',
		where: 'Univ. of Alaska Fairbanks',
		title: 'The degree came on Mother’s Day',
		description:
			'Her doctorate was conferred posthumously and received by our mother. The university held its ceremony, as it happened, on Mother’s Day. It was a kind of closure — but there was more still to be done.',
		major: true,
	},
];

interface CredentialGroup {
	title: string;
	items: {
		field: string;
		detail: string;
	}[];
}

const FOUNDER_GROUPS: CredentialGroup[] = [
	{
		title: 'Expertise & Training',
		items: [
			{
				field: 'Education & training',
				detail:
					'Special Educator and Learning Disabilities teacher; certified teacher mentor for professional development (TISS); certified QPR Suicide Prevention Gatekeeper Instructor.',
			},
			{
				field: 'Waste & sustainability',
				detail:
					'Certified waste management entrepreneur (IPCA–TERI); Master Trainer for sanitation workers on occupational safety and dignity; Climate Reality Leader.',
			},
			{
				field: 'Mental health',
				detail:
					'Conducts the Suicide Prevention Gatekeeper Training (S.P.A.T.); completed community mental health certification in the Atmiyata model.',
			},
		],
	},
	{
		title: 'Leadership & Action',
		items: [
			{
				field: 'Advocacy & leadership',
				detail:
					'Founder, Itti’s Skill School Foundation; Co-founder, Warrior Moms (Mothers for Clean Air); Maharashtra State President, WICCI Water Resource Council.',
			},
			{
				field: 'Youth action',
				detail:
					'Launched Itti’s Youth for Climate Action (IYCA) in 2025, with a school students’ climate action group planned next.',
			},
			{
				field: 'Institutional roles',
				detail:
					'Appointed Member, Anti-Ragging Committee, Viman Nagar Campus, Symbiosis International (Deemed University), 2026.',
			},
		],
	},
	{
		title: 'Research & Recognition',
		items: [
			{
				field: 'Research',
				detail:
					'Co-PI, Minor Research Project with Symbiosis International (SIU): “Use of Menstrual Cups among Young Women — A Comparative Study of Urban and Rural Cohorts.”',
			},
			{
				field: 'Recognition',
				detail:
					'PMC and Punekar News awards; idea selected for a Tech Camp pilot grant; Rotary award.',
			},
		],
	},
];
---

<Base
	title="Dr. Archana “Itti” Bali — Legacy — The Itti Foundation"
	description="From a government school in India to conservation research in Alaska: the life of Dr. Archana “Itti” Bali, and the foundation carrying her work on."
	navTheme="veil"
	band="teal"
>
	<div class="page">
		<!-- The Foundation Mark Ambient Watermark — Centered in the middle as requested -->
		<span class="page__ornament" aria-hidden="true">
			<Mark height="min(75vh, 36rem)" label="" />
		</span>
		<div class="page__grain" aria-hidden="true"></div>

		<!-- Main Narrative Surface in the Exact Site Template Format -->
		<article class="legacy">
			<!-- Header Area matching the 404/Template format with BOLD Heading -->
			<header class="legacy__masthead">
				<p class="legacy__eyebrow">Legacy</p>
				<h1 class="legacy__title">Dr. Archana &ldquo;Itti&rdquo; Bali</h1>
				<p class="legacy__span">8 April <span>&mdash;</span> 8 September 2014</p>
				<p class="legacy__lede">
					Hardworking, straightforward, warm &mdash; the brightest flower in our garden.
					From a government school in India to conservation research in Alaska, this is
					her story, and an invitation to add your own memory to it.
				</p>
			</header>

			<!-- ──────── Section 1: Her Life ──────── -->
			<section class="legacy__section" aria-labelledby="chapter-life-title">
				<div class="section-rule">
					<h2 class="section-rule__title" id="chapter-life-title">Her life</h2>
					<p class="section-rule__desc">
						Who she was, where she went, and how far she carried her work.
					</p>
				</div>

				<div class="timeline" aria-label="Her life timeline">
					{
						LIFE_MILESTONES.map((item) => (
							<article
								class="timeline__entry"
								data-weight={item.major ? 'major' : undefined}
								id={item.id}
							>
								<span class="timeline__node" aria-hidden="true" />
								<div class="way" data-weight={item.major ? 'major' : undefined}>
									<div class="way__meta">
										<span class="way__when">{item.when}</span>
										<span class="way__bullet" aria-hidden="true">
											&middot;
										</span>
										<span class="way__where">{item.where}</span>
									</div>
									<h3 class="way__name">{item.title}</h3>
									<p class="way__note">{item.description}</p>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- ──────── Archival Materials & Share a Memory ──────── -->
			<section class="legacy__section" aria-labelledby="archive-title">
				<div class="section-rule">
					<h2 class="section-rule__title" id="archive-title">Read, watch, remember</h2>
					<p class="section-rule__desc">
						Archival publications, documentary footage, and recollections from friends
						and mentors.
					</p>
				</div>

				<div class="ways ways--three" aria-label="Archival materials">
					<button type="button" class="way way--clickable" data-open-drawer="articles">
						<span class="way__meta"
							>Publications &middot; Western Ghats &amp; Alaska</span
						>
						<h3 class="way__name">Her published articles</h3>
						<p class="way__note">
							Doctoral research, MSc dissertation at NCBS with Dr. Ulhas Karanth, and
							international wildlife colloquia.
						</p>
						<span class="way__go" aria-hidden="true">View citations &rarr;</span>
					</button>

					<button type="button" class="way way--clickable" data-open-drawer="film">
						<span class="way__meta">Documentary &middot; Oral History</span>
						<h3 class="way__name">The Voices Project (film)</h3>
						<p class="way__note">
							Award-winning documentary produced in Alaska, chronicling indigenous
							knowledge and Arctic ecology.
						</p>
						<span class="way__go" aria-hidden="true">Learn about the film &rarr;</span>
					</button>

					<button type="button" class="way way--clickable" data-open-drawer="awards">
						<span class="way__meta">Honours &middot; Distinctions</span>
						<h3 class="way__name">Awards &amp; recognitions</h3>
						<p class="way__note">
							Inaugural George Schaller Scholarship and posthumous Doctorate conferred
							on Mother's Day at UAF.
						</p>
						<span class="way__go" aria-hidden="true">View honours &rarr;</span>
					</button>
				</div>

				<!-- Did you know Itti? Memory card -->
				<div class="way way--feature">
					<div class="way__feature-content">
						<span class="way__meta">Living Memorial &middot; Oral Archive</span>
						<h3 class="way__name">Did you know Itti?</h3>
						<p class="way__note">
							We&rsquo;re gathering memories, photographs and videos from everyone whose
							life she touched &mdash; family, teachers, classmates, colleagues and
							friends &mdash; to keep alongside her story here.
						</p>
					</div>
					<button type="button" class="way__cta-btn" id="open-memory-btn">
						Share a memory &rarr;
					</button>
				</div>
			</section>

			<!-- ──────── Section 2: The Promise ──────── -->
			<section class="legacy__section promise-section" aria-labelledby="promise-title">
				<div class="promise-split">
					<h2 class="promise-split__title" id="promise-title">The promise</h2>
					<div class="promise-split__content">
						<p class="promise-split__quote">
							Her resilience, adaptability, intelligence, storytelling and warmth set
							her apart. Those are the things we want the next generation to take from
							her.
						</p>
						<p class="promise-split__text">
							The Foundation is our humble step to honour our sister &mdash; our guiding
							light, our dost, our best friend. We have a promise to keep: to hold her
							lofty goals in place and keep her legacy of environmental awareness,
							education and entrepreneurship alive and thriving.
						</p>
					</div>
				</div>
			</section>

			<!-- ──────── Section 3: Led by (Split Layout Profile & Credentials) ──────── -->
			<section class="legacy__section" aria-labelledby="founder-title">
				<div class="section-rule">
					<h2 class="section-rule__title" id="founder-title">Led by</h2>
					<p class="section-rule__desc">
						The leadership and lived experience driving the Foundation forward.
					</p>
				</div>

				<div
					class="founder-split"
					aria-label="Founder leadership profile and credentials"
				>
					<!-- Left Side: Profile on Teal Canvas (Sticky on Desktop) -->
					<aside class="founder-profile">
						<span class="founder-profile__role">Founder &amp; Director</span>
						<h3 class="founder-profile__name">Anuja Bali</h3>
						<p class="founder-profile__intro">
							Anuja Bali founded Itti&rsquo;s Skill School Foundation in her
							sister&rsquo;s memory, and leads its practical work across environmental
							stewardship, special education, cancer family support, and community
							mental health.
						</p>
						<div class="founder-badge" aria-label="Foundation seal">
							<span class="founder-badge__icon" aria-hidden="true">✦</span>
							<div class="founder-badge__text">
								<span class="founder-badge__org"
									>Itti&rsquo;s Skill School Foundation</span
								>
								<span class="founder-badge__tag"
									>Living Memorial &middot; Est. 2021</span
								>
							</div>
						</div>
					</aside>

					<!-- Right Side: One Clean Off-White Credentials Panel -->
					<div class="founder-panel">
						{
							FOUNDER_GROUPS.map((group, groupIdx) => (
								<div class="founder-group">
									<p class="founder-group__label" id={`group-${groupIdx}`}>
										{group.title}
									</p>
									<div class="founder-group__items">
										{group.items.map((cred) => (
											<article class="founder-entry">
												<div class="founder-entry__head">
													<span class="founder-entry__bullet" aria-hidden="true">
														✦
													</span>
													<h4 class="founder-entry__title">{cred.field}</h4>
												</div>
												<p class="founder-entry__detail">{cred.detail}</p>
											</article>
										))}
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Footer note matching the template's .lost__foot -->
			<p class="legacy__foot">
				If you followed a link here from somewhere else, write to{' '}
				<a class="legacy__link" href="mailto:hello@itti.org.in">hello@itti.org.in</a>{
					' '
				}
				and we will point you the right way.
			</p>
		</article>

		<!-- ──────── Interactive Archival Drawers Modal ──────── -->
		<dialog
			class="legacy-dialog"
			id="archive-dialog"
			aria-labelledby="archive-modal-title"
		>
			<div class="legacy-dialog__backdrop" data-close-archive></div>
			<div class="legacy-dialog__panel" role="document">
				<button
					type="button"
					class="legacy-dialog__close"
					data-close-archive
					aria-label="Close dialog">&times;</button
				>

				<div id="drawer-articles" class="legacy-dialog__view" hidden>
					<p class="legacy-dialog__eyebrow">Research &middot; Publications</p>
					<h3 class="legacy-dialog__title" id="archive-modal-title">
						Her Published Articles
					</h3>
					<div class="legacy-dialog__body">
						<p>
							Dr. Archana Bali was a pioneer in wildlife ecology and
							human&ndash;wildlife coexistence, examining how human cultivation and wild
							habitats meet.
						</p>
						<ul class="legacy-dialog__list">
							<li>
								<strong>MSc Wildlife Biology Dissertation (NCBS Bangalore):</strong>
								<span
									>Ecology and human coexistence in coffee agro-ecosystems of
									Chikmagalur, under the mentorship of Dr. Ulhas Karanth.</span
								>
							</li>
							<li>
								<strong>Doctoral Dissertation (University of Alaska Fairbanks):</strong>
								<span
									>Human&ndash;animal interdependence, Arctic ecosystems, and caribou
									conservation as the inaugural George Schaller Scholar.</span
								>
							</li>
							<li>
								<strong>International Colloquia (2013&ndash;2014):</strong>
								<span
									>Papers presented across North America and abroad through active
									cancer treatments, demonstrating groundbreaking resilience and rigor.</span
								>
							</li>
						</ul>
					</div>
				</div>

				<div id="drawer-film" class="legacy-dialog__view" hidden>
					<p class="legacy-dialog__eyebrow">Documentary &middot; Oral History</p>
					<h3 class="legacy-dialog__title">The Voices Project (film)</h3>
					<div class="legacy-dialog__body">
						<p>
							Alongside her doctoral research at the University of Alaska Fairbanks, Dr.
							Itti Bali co-created <strong>The Voices Project</strong> &mdash; an award-winning
							documentary produced in close collaboration with Native Alaskan communities.
						</p>
						<p>
							The film documents traditional ecological knowledge, changing Arctic
							ecosystems, and indigenous perspectives on subsistence and respect for
							living beings. Her storytelling celebrated the people whose ancestral
							wisdom shaped her science.
						</p>
					</div>
				</div>

				<div id="drawer-awards" class="legacy-dialog__view" hidden>
					<p class="legacy-dialog__eyebrow">Honours &middot; Distinctions</p>
					<h3 class="legacy-dialog__title">Awards &amp; Recognitions</h3>
					<div class="legacy-dialog__body">
						<ul class="legacy-dialog__list">
							<li>
								<strong>The George Schaller Scholarship:</strong>
								<span
									>The first scholar ever selected for this prestigious award to pursue
									a doctorate in wildlife ecology and conservation at UAF.</span
								>
							</li>
							<li>
								<strong>Posthumous Doctorate of Philosophy (2016):</strong>
								<span
									>Conferred on Mother&rsquo;s Day at the University of Alaska
									Fairbanks, received with enduring pride by her mother.</span
								>
							</li>
							<li>
								<strong>Documentary Festival Honours:</strong>
								<span
									>Festival recognitions and tribal community honors for <em
										>The Voices Project</em
									>.</span
								>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</dialog>

		<!-- ──────── Interactive "Share a Memory" Modal Dialog ──────── -->
		<dialog class="legacy-dialog" id="memory-dialog" aria-labelledby="dialog-mem-title">
			<div class="legacy-dialog__backdrop" data-close-dialog></div>
			<div class="legacy-dialog__panel" role="document">
				<button
					type="button"
					class="legacy-dialog__close"
					data-close-dialog
					aria-label="Close dialog">&times;</button
				>
				<header class="legacy-dialog__head">
					<p class="legacy-dialog__eyebrow">The Itti Foundation Archive</p>
					<h3 class="legacy-dialog__title" id="dialog-mem-title">
						Share a Memory of Itti
					</h3>
					<p class="legacy-dialog__subtitle">
						Your words help keep Dr. Archana &ldquo;Itti&rdquo; Bali&rsquo;s warmth,
						grit and spirit alive. Every memory, story or reflection will be lovingly
						preserved with her archive.
					</p>
				</header>
				<form class="memory-form" id="memory-form">
					<div class="memory-form__field">
						<label for="mem-name">Your Full Name <span class="req">*</span></label>
						<input
							type="text"
							id="mem-name"
							name="name"
							required
							placeholder="e.g. Anuja Bali"
						/>
					</div>
					<div class="memory-form__row">
						<div class="memory-form__field">
							<label for="mem-email"
								>Your Email Address <span class="req">*</span></label
							>
							<input
								type="email"
								id="mem-email"
								name="email"
								required
								placeholder="you@example.com"
							/>
						</div>
						<div class="memory-form__field">
							<label for="mem-rel">Connection to Itti <span class="req">*</span></label>
							<select id="mem-rel" name="relation" required>
								<option value="" disabled selected>Select connection...</option>
								<option value="Family">Family</option>
								<option value="Relative">Relative</option>
								<option value="School Friends">School Friends</option>
								<option value="College Friends">College Friends</option>
								<option value="Alaskan Family">Alaskan Family</option>
								<option value="Colleague - NCBS">Colleague - NCBS</option>
								<option value="Colleague - Greenpeace">Colleague - Greenpeace</option>
								<option value="Colleague - NIIT">Colleague - NIIT</option>
								<option value="Cancer Support Community"
									>Cancer Support Community</option
								>
								<option value="Personal Friend">Personal Friend</option>
								<option value="Other">Other</option>
							</select>
						</div>
					</div>
					<div class="memory-form__field">
						<label for="mem-place">Year or Place <span class="req">*</span></label>
						<input
							type="text"
							id="mem-place"
							name="place"
							required
							placeholder="e.g. 2004, NCBS Bangalore / 2011, Fairbanks"
						/>
					</div>
					<div class="memory-form__field">
						<label for="mem-story">Your Memory or Note <span class="req">*</span></label
						>
						<textarea
							id="mem-story"
							name="story"
							rows="4"
							required
							placeholder="Share a story, conversation, or moment that captured who Itti was to you..."
						></textarea>
					</div>
					<!-- Photo or Video Upload Section with 25 MB Limit -->
					<div class="memory-form__field">
						<label for="mem-media"
							>Photo or Video <span class="opt">(optional)</span></label
						>
						<div class="memory-upload" id="memory-upload-zone">
							<input
								type="file"
								id="mem-media"
								name="media"
								accept="image/*,video/*"
								class="memory-upload__input"
							/>
							<div class="memory-upload__prompt" id="mem-upload-prompt">
								<svg
									class="memory-upload__icon"
									viewBox="0 0 24 24"
									width="24"
									height="24"
