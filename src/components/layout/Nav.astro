---
import Mark from '../brand/Mark.astro';
import Wordmark from '../brand/Wordmark.astro';

/**
 * Site navigation. Stays visible and live for the entire opening arc — the
 * overture is an offering, not a toll gate.
 *
 * Two states, driven by `.is-light`, which the page toggles when the ground
 * behind the bar turns cream. Everything inverts at once: mark, wordmark,
 * links, pill.
 */

const MENUS = [
	{
		label: 'Our Story',
		href: '/our-story',
		groups: [
			{
				title: 'The Foundation',
				links: [
					{ label: 'Mission', href: '/our-story/mission' },
					{ label: 'Legacy', href: '/our-story/legacy' },
					{ label: "Founder's Journey", href: '/our-story/founder' },
				],
			},
			{
				title: 'People & Governance',
				links: [
					{ label: 'Team', href: '/our-story/team' },
					{ label: 'Constitution & Policies', href: '/our-story/constitution' },
					{ label: 'Transparency & Reports', href: '/our-story/transparency' },
				],
			},
		],
	},
	{
		label: 'Commitments',
		href: '/commitments',
		groups: [
			{
				title: 'Our Pillars',
				links: [
					{ label: 'Neurodivergence', href: '/commitments/neurodivergence', accent: 'ochre' },
					{ label: 'Cancer Care', href: '/commitments/cancer-care', accent: 'rose' },
					{ label: 'Conservation', href: '/commitments/conservation', accent: 'sage' },
				],
			},
			{
				title: 'Projects',
				links: [
					{ label: 'Current Projects', href: '/commitments/projects' },
					{ label: 'Past Work', href: '/commitments/past-work' },
					{ label: 'Partners', href: '/commitments/partners' },
				],
			},
		],
	},
	{
		label: 'Marketplace',
		href: '/marketplace',
		groups: [
			{
				title: 'Shop',
				links: [
					{ label: 'All Products', href: '/marketplace#all' },
					{ label: 'Makers', href: '/marketplace#makers' },
					{ label: 'How It Works', href: '/marketplace#how-it-works' },
				],
			},
			{
				title: 'Featured',
				links: [
					{ label: 'New Arrivals', href: '/marketplace#new' },
					{ label: 'Collections', href: '/marketplace#collections' },
				],
			},
		],
	},
	{
		label: 'Events',
		href: '/events',
		groups: [
			{
				title: 'Happening Now',
				links: [
					{ label: 'Upcoming', href: '/events/upcoming' },
					{ label: 'Ongoing Campaigns', href: '/events/campaigns' },
				],
			},
			{
				title: 'Newsroom',
				links: [
					{ label: 'Announcements', href: '/events/announcements' },
					{ label: 'Press', href: '/events/press' },
				],
			},
		],
	},
];
---

<header class="nav" id="site-nav" data-nav>
	<div class="nav__inner">
		<a class="brand" href="/" aria-label="The Itti Foundation — home">
			<Mark class="brand__mark" />
			<span class="brand__word">
				<Wordmark />
			</span>
		</a>

		<nav class="nav__menu" aria-label="Primary">
			<ul class="nav__list">
				{
					MENUS.map((menu, i) => (
						<li class="nav__item" data-menu-item data-menu-index={i}>
							<button
								class="nav__link"
								type="button"
								aria-expanded="false"
								aria-controls="mega-panel"
								data-menu-trigger
							>
								{menu.label}
							</button>
						</li>
					))
				}
			</ul>

			{/* One panel for the whole bar, not one per menu.
			    Four panels each anchored to their own label meant four different
			    places for the same object to appear, at four different widths —
			    the bar behaved differently depending on where you pointed. This
			    one slides along under the labels and resizes to whatever it is
			    holding, so the menu is a single thing that moves rather than four
			    that come and go. */}
			<div class="mega" id="mega-panel" data-mega>
				<div class="mega__frame" data-mega-frame>
					{MENUS.map((menu, i) => (
						<div class="mega__sheet" data-mega-sheet={i} aria-hidden="true">
							<span class="mega__edge" aria-hidden="true" />
							<div class="mega__cols">
								{menu.groups.map((group) => (
									<section class="mega__group">
										<h2 class="mega__title">
											<span class="mega__title-rule" aria-hidden="true" />
											{group.title}
										</h2>
										<ul class="mega__links">
											{group.links.map((link) => (
												<li>
													<a
														class="mega__link"
														href={link.href}
														tabindex="-1"
														style={
															'accent' in link
																? `--accent: var(--${(link as { accent: string }).accent}); --accent-ink: var(--${(link as { accent: string }).accent}-ink)`
																: undefined
														}
													>
														<span>{link.label}</span>
														<span class="mega__link-arrow" aria-hidden="true">
															&rarr;
														</span>
													</a>
												</li>
											))}
										</ul>
									</section>
								))}
							</div>
							<a class="mega__all" href={menu.href} tabindex="-1">
								<span>All of {menu.label}</span>
								<span class="mega__all-arrow" aria-hidden="true">&rarr;</span>
							</a>
						</div>
					))}
				</div>
			</div>
		</nav>

		{
			/*
		  Both states ship in the markup and one is hidden, because a nav built by
		  script is a nav that flashes the wrong thing first. Which one shows is
		  decided by `data-who` on the header, set synchronously below.
		*/
		}
		<!-- Donate does not come and go. Signing in replaces Join Us with the
		     account, and leaves the way to give exactly where it was — for a
		     visitor who has not registered, the bar and the footer are otherwise
		     the only two routes to it. Outlined beside Join Us so the two do not
		     compete, filled once Join Us has gone and it is the only action left. -->
		<a class="pill pill--outline" href="/donate">Donate</a>

		<!-- Signing in belongs to joining, so it sits under it rather than beside
		     it. Join Us stays a plain link that navigates on the first click —
		     making the site's main action a menu trigger would cost it a click,
		     which is a poor trade for a tidier bar. The panel opens on hover, and
		     on focus, which is what makes the link inside it reachable by keyboard
		     at all: focusing Join Us puts focus inside the wrapper, the panel
		     becomes visible, and the next tab lands on it. -->
		<div class="cta" data-signed-out>
			<a class="pill" href="/join">Join Us</a>
			<div class="cta__panel">
				<a class="cta__link" href="/account">Already registered? Log in</a>
			</div>
		</div>
		<a class="who" href="/account" data-who data-accent="teal" data-signed-in hidden>
			<span class="who__name" data-who-name></span>
			<span class="u-visually-hidden">— your account</span>
		</a>

		<button
			class="nav__burger"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-drawer"
			aria-label="Toggle navigation menu"
			data-burger
		>
			<span class="u-visually-hidden">Menu</span>
			<span class="nav__burger-bar"></span>
			<span class="nav__burger-bar"></span>
		</button>
	</div>

	<div
		class="drawer"
		id="mobile-drawer"
		data-drawer
		hidden
		aria-label="Mobile navigation"
	>
		<div class="drawer__inner">
			{
				MENUS.map((menu) => (
					<section class="drawer__group">
						<h2 class="drawer__title">
							<a href={menu.href}>{menu.label}</a>
						</h2>
						<ul class="drawer__links">
							{menu.groups
								.flatMap((g) => g.links)
								.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))}
						</ul>
					</section>
				))
			}
			<a class="drawer__who" href="/account" data-signed-out>Log in</a>
			<a class="pill pill--drawer pill--outline" href="/donate">Donate</a>
			<a class="pill pill--drawer" href="/join" data-signed-out>Join Us</a>
			<a
				class="drawer__who"
				href="/account"
				data-who
				data-accent="teal"
				data-signed-in
				hidden
			>
				<span data-who-name></span>
				<span class="u-visually-hidden">— your account</span>
			</a>
		</div>
	</div>
</header>

{
	/*
  Runs where it stands, before the browser has painted anything below it, so a
  returning visitor never sees "Join Us" flash into their own name.

  It asks storage rather than the network, and deliberately does not import the
  auth client: that would put the whole SDK on every page of the site to render
  one word. The session's own token lives in local storage under a key the
  library names after the project, so its presence is readable here for nothing
  — and checking it is what makes signing out in another tab, or clearing site
  data, take effect here too rather than leaving a stale name in the corner.

  This is a greeting, not a permission. It guards nothing, and `/account` reads
  the real session before it shows anybody a record.
*/
}
<script is:inline>
	(() => {
		const nav = document.getElementById('site-nav');

		const paint = (who, accent) => {
			const name = (who || '').trim().split(/\s+/)[0] || '';
			for (const el of nav.querySelectorAll('[data-who-name]')) el.textContent = name;
			// The colour somebody chose for their account follows them into the
			// bar, so the disc in the corner is theirs and not just a circle.
			for (const el of nav.querySelectorAll('[data-who]'))
				el.dataset.accent = accent || 'teal';
			for (const el of nav.querySelectorAll('[data-signed-in]')) el.hidden = !name;
			for (const el of nav.querySelectorAll('[data-signed-out]')) el.hidden = !!name;
		};

		try {
			let signedIn = false;
			for (const key in localStorage) {
				if (/^sb-.+-auth-token$/.test(key)) {
					signedIn = true;
					break;
				}
			}
			if (!signedIn) {
				localStorage.removeItem('itti.who');
				localStorage.removeItem('itti.accent');
			}
			const who = signedIn ? localStorage.getItem('itti.who') : '';
			if (who) paint(who, localStorage.getItem('itti.accent'));
		} catch {
			// A browser that refuses storage gets the signed-out nav, which is the
			// one already in the markup. Nothing to do.
		}

		// Signing in happens after this has already run and decided. The account
		// page says so when it knows, and the nav catches up in place rather than
		// leaving "Join Us" above a record with the person's own name on it.
		document.addEventListener('itti:who', (event) =>
			paint(event.detail && event.detail.name, event.detail && event.detail.accent),
		);
	})();
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 60;
		color: var(--warm-white);
		/* On the dark arc the whole lockup is one colour; FOUNDATION's teal
		   would sink into a deep-teal ground. */
		--wordmark-name: var(--warm-white);
		--wordmark-sub: rgba(250, 247, 240, 0.82);
		transition: color var(--turn-dur) var(--ease);
	}

	/* On cream the lockup returns to the brand's own two colours. */
	.nav.is-light {
		color: var(--teal);
		--wordmark-name: var(--ink);
		--wordmark-sub: var(--teal);
	}

	/* Over the arc the bar is glass on top of a picture. Past the turn there is
	   real content underneath, and a transparent bar means every section scrolls
	   straight through the lockup. */
	/* Glass rather than a cream lid. The page under it is no longer flat cream —
	   it carries washes of ochre, teal and sage — and an opaque bar over that
	   reads as a different colour sitting on top of it. At 0.66 the ground comes
	   through and the bar takes whatever the page is doing beneath it, which is
	   what the veiled bar does on the dark pages. */
	.nav.is-light .nav__inner {
		background: rgba(251, 248, 240, 0.66);
		border-bottom: 1px solid rgba(44, 39, 33, 0.07);
		-webkit-backdrop-filter: blur(18px) saturate(1.25);
		backdrop-filter: blur(18px) saturate(1.25);
	}

	/* A backdrop filter on a fixed bar is recomputed for every frame the page
	   moves under it, and the arc's way out moves the page for 1700ms. The bar
	   is over the dark arc for all of it, so there is nothing to blur; dropping
	   the filter for the length of the move takes that cost out of the frame. */
	:global(.arc[data-exiting]) ~ * .nav__inner,
	:global(html:has(.arc[data-exiting])) .nav__inner {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	/* A page that is dark the whole way down still has content passing under
	   the bar — a cream card, in the case of the form — so it needs the same
	   ground the light state has, in its own colour. Without it the lockup and
	   the links are white on cream for as long as the card is behind them. */
	:global(body[data-nav-theme='dark']) .nav__inner,
	:global(body[data-nav-theme='veil']) .nav.is-veiled .nav__inner {
		background: var(--veil);
		/* The bar is the same colour as the ground, so this line is the only
		   thing marking where one ends. In teal it does that and carries the
		   signature at the same time. */
		border-bottom: 1px solid color-mix(in srgb, var(--teal) 55%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}

	/* A veiled bar wants no line under it. The dark theme's teal hairline marks
	   the bar off from a page it does not otherwise share a colour with; here it
	   is the same colour family as the ground, and the line only draws attention
	   to the join it is meant to hide. */
	:global(body[data-nav-theme='veil']) .nav.is-veiled .nav__inner {
		border-bottom-color: transparent;
	}

	/* The ground arrives rather than appearing, so the bar does not blink as the
	   first card reaches it.

	   The border is declared here as well, at zero visibility, because border
	   width does not transition with border colour. Without it the un-veiled bar
	   had no bottom border at all, so the width snapped to 1px the instant the
	   ground was added while the colour animated away from `currentColor` —
	   cream on every page that veils. The result was a white hairline flashing
	   under the bar for the length of the fade. */
	:global(body[data-nav-theme='veil']) .nav__inner {
		border-bottom: 1px solid transparent;
		transition:
			background-color 380ms var(--ease),
			border-color 380ms var(--ease);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(body[data-nav-theme='veil']) .nav__inner {
			transition: none;
		}
	}

	.nav__inner {
		/* The panel is placed against the bar rather than against a label, so
		   the bar is what it measures from. */
		position: relative;
		display: flex;
		align-items: center;
		/* Named, so the pair of actions at the end can measure itself against the
		   bar's own spacing rather than repeating the number. */
		--nav-gap: clamp(1rem, 3vw, 3rem);
		gap: var(--nav-gap);
		height: var(--nav-h);
		padding-inline: var(--gutter);
	}

	/* The two actions are a pair. Set at the bar's own spacing they read as two
	   unrelated items that happen to look alike; closed up a little they read as
	   one choice with two answers, and the gap before them still separates them
	   from the menu.

	   `min` keeps this at zero on narrow screens, where the bar's gap is already
	   tighter than the pair wants to be and pulling further would push them into
	   each other. */
	.nav__inner .pill + .cta,
	.nav__inner .cta + .who {
		margin-left: min(0px, calc(1.5rem - var(--nav-gap)));
	}

	.cta {
		position: relative;
		display: flex;
	}

	/* Hidden by visibility rather than by display, so that the moment Join Us
	   takes focus the wrapper counts as focused, the panel becomes visible, and
	   the link inside it enters the tab order. With `display: none` it could
	   never be reached by keyboard at all. */
	.cta__panel {
		position: absolute;
		top: calc(100% + 0.55rem);
		right: 0;
		z-index: 3;
		visibility: hidden;
		opacity: 0;
		translate: 0 -0.35rem;
		transition:
			opacity 200ms var(--ease),
			translate 200ms var(--ease),
			visibility 200ms;
	}

	.cta:hover .cta__panel,
	.cta:focus-within .cta__panel {
		visibility: visible;
		opacity: 1;
		translate: none;
	}

	.cta__link {
		display: block;
		white-space: nowrap;
		padding: 0.6rem 1rem 0.65rem;
		border-radius: 2px;
		background: var(--cream);
		color: var(--teal-deep);
		font-size: 0.875rem;
		box-shadow: 0 10px 26px -14px rgba(10, 47, 53, 0.7);
	}

	.cta__link:hover {
		background: var(--warm-white);
	}

	.nav.is-light .cta__link {
		background: var(--warm-white);
		border: 1px solid rgba(44, 39, 33, 0.1);
		color: var(--teal);
		box-shadow: 0 10px 26px -16px rgba(44, 39, 33, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.cta__panel {
			transition: none;
		}
	}

	/* ── Brand ──────────────────────────────────────────────────────────── */

	.brand {
		display: flex;
		align-items: center;
		margin-right: auto;
		min-width: 0;
		/* Custom properties, so they reach the Mark and Wordmark components by
		   inheritance — a scoped class selector here would not match them. */
		--mark-h: 2.65rem;
		--wordmark-size: 1.4rem;
	}

	/* The gap lives on the wordmark, not the flex row, so it collapses with it
	   and the mark ends up flush left. */
	.brand__word {
		display: grid;
		overflow: hidden;
		white-space: nowrap;
		max-width: 14rem;
		padding-left: 1.1rem;
		opacity: 1;
		transform: none;
		transition:
			max-width 520ms var(--ease),
			padding-left 520ms var(--ease),
			opacity 300ms var(--ease),
			transform 520ms var(--ease);
	}

	/* The wordmark steps aside for the length of the poem. The lines scroll up
	   underneath a fixed, transparent bar, and a 76px display line passing
	   behind THE ITTI / FOUNDATION is a collision, not a layer. It returns at
	   the turn, once the ground is cream and nothing scrolls under it. */
	.nav.is-compact .brand__word {
		max-width: 0;
		padding-left: 0;
		opacity: 0;
		transform: translateX(-0.75rem);
	}

	/* ── Links ──────────────────────────────────────────────────────────── */

	.nav__menu {
		display: contents;
	}

	.nav__list {
		display: flex;
		align-self: stretch;
		gap: clamp(0.75rem, 2.2vw, 2.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Each item is the panel's containing block, and stretches the full height
	   of the bar so the panel hangs from the bar's edge with no dead gap for
	   the pointer to fall through. */
	.nav__item {
		position: relative;
		display: flex;
		align-items: center;
	}

	.nav__link {
		position: relative;
		padding: 0.4rem 0;
		font-size: 0.9375rem;
		letter-spacing: 0.02em;
		opacity: 0.92;
		transition: opacity 250ms var(--ease);
	}

	.nav__link::after {
		content: '';
		position: absolute;
		inset: auto 0 0.1rem;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 380ms var(--ease);
	}

	.nav__link:hover,
	.nav__link[aria-expanded='true'] {
		opacity: 1;
	}

	.nav__link:hover::after,
	.nav__link[aria-expanded='true']::after {
		transform: scaleX(1);
	}

	/* ── Join Us pill — inverts at the turn ─────────────────────────────── */

	.pill {
		flex: none;
		padding: 0.5rem 1.35rem 0.55rem;
		border-radius: 999px;
		background: var(--cream);
		color: var(--teal-deep);
		font-size: 0.9375rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		transition:
			background var(--turn-dur) var(--ease),
			color var(--turn-dur) var(--ease),
			transform 300ms var(--ease);
	}

	.nav.is-light .pill {
		background: var(--teal);
		color: var(--warm-white);
	}

	/* Beside Join Us it is the quieter of the two; alone it takes the full
	   weight, because there is nothing left for it to defer to. */
	.pill--outline {
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--cream) 55%, transparent);
		color: var(--cream);
	}

	.pill--outline:hover {
		background: color-mix(in srgb, var(--cream) 14%, transparent);
	}

	.nav.is-light .pill--outline {
		background: transparent;
		border-color: color-mix(in srgb, var(--teal) 45%, transparent);
		color: var(--teal);
	}

	.nav.is-light .pill--outline:hover {
		background: color-mix(in srgb, var(--teal) 8%, transparent);
	}

	/* Signed in, Join Us is gone and Donate is the only thing being asked. */
	.nav:has([data-signed-in]:not([hidden])) .pill--outline {
		background: var(--cream);
		border-color: var(--cream);
		color: var(--teal-deep);
	}

	.nav.is-light:has([data-signed-in]:not([hidden])) .pill--outline {
		background: var(--teal);
		border-color: var(--teal);
		color: var(--warm-white);
	}


	.pill:hover {
		transform: translateY(-1px);
	}

	/* Somebody who has already registered is not joining again, and until now
	   the only way back to their record was a link in the footer. Set as text
	   rather than a second pill: the pill is for the person who has not
	   arrived yet. */
	.signin {
		flex: none;
		font-size: 0.9375rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		color: var(--cream);
		transition: color var(--turn-dur) var(--ease);
	}

	.nav.is-light .signin {
		color: var(--teal-deep);
	}

	.signin:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	/* ── Who is signed in ───────────────────────────────────────────────── */

	/* ── Who is signed in ───────────────────────────────────────────────── */

	/* One object, not two. A disc showing "T" beside a name reading "Tubhyam"
	   says the same thing twice, and the letter was there out of avatar habit
	   rather than because it earned the space.

	   A pill, then — but outlined where Donate is filled. Two filled pills
	   would read as two calls to action arguing; outlined, this reads as a
	   state sitting beside an action, the way a ghost button sits next to a
	   primary one. The stroke also gives the colour far more room to show than
	   a small ring did, so it needs a hairline rather than the two pixels the
	   ring had come to need. */
	.who {
		flex: none;
		display: inline-flex;
		align-items: center;
		max-width: 12rem;
		padding: 0.45rem 1.05rem 0.5rem;
		border: 1px solid var(--who-ring, currentColor);
		border-radius: 999px;
		font-size: 0.875rem;
		letter-spacing: 0.03em;
		white-space: nowrap;
		color: var(--cream);
		transition:
			background var(--turn-dur) var(--ease),
			color var(--turn-dur) var(--ease),
			border-color var(--turn-dur) var(--ease);
	}

	.nav.is-light .who {
		color: var(--teal-deep);
	}

	.who__name {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* The colour washes in behind the name rather than the shape changing. */
	.who:hover {
		background: color-mix(in srgb, var(--who-ring, currentColor) 14%, transparent);
	}

	/* On the dark bar the accent itself reads; on cream the darker ink does. */
	[data-accent='teal'] {
		--who-ring: #4fa3ad;
	}
	[data-accent='ochre'] {
		--who-ring: var(--ochre);
	}
	[data-accent='rose'] {
		--who-ring: var(--rose);
	}
	[data-accent='sage'] {
		--who-ring: var(--sage);
	}

	.nav.is-light [data-accent='teal'] {
		--who-ring: var(--teal);
	}
	.nav.is-light [data-accent='ochre'] {
		--who-ring: var(--ochre-ink);
	}
	.nav.is-light [data-accent='rose'] {
		--who-ring: var(--rose-ink);
	}
	.nav.is-light [data-accent='sage'] {
		--who-ring: var(--sage-ink);
	}

	.drawer__who {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1rem;
		font-size: 1.0625rem;
		color: inherit;
	}

	/* ── Mega menu ──────────────────────────────────────────────────────── */

	/* One panel for the bar. It is placed against the bar itself rather than
	   against a label, and slides to sit under whichever label is open — so
	   there is one object with one behaviour, wherever you point. */
	.mega {
		position: absolute;
		top: 100%;
		left: var(--gutter);
		/* Transparent bridge between the bar and the card — visual gap without a
		   hover gap. */
		padding-top: 0.5rem;
		opacity: 0;
		translate: var(--mega-x, 0) -0.4rem;
		/* Visibility rather than `display`, so the panel is always laid out and
		   the transition has something to run on. It also keeps the closed panel
		   out of the tab order. */
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 160ms var(--ease),
			translate 200ms var(--ease),
			visibility 0s linear 200ms;
	}

	.nav.is-open .mega {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		translate: var(--mega-x, 0) 0;
		transition:
			opacity 200ms var(--ease),
			translate 420ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s;
	}

	/* The frame is the shape of whatever sheet is showing, and it changes shape
	   rather than being replaced. */
	.mega__frame {
		position: relative;
		width: var(--mega-w, auto);
		height: var(--mega-h, auto);
		border-radius: 10px;
		overflow: hidden;
		/* Solid. A panel you can see the artwork through can never read as
		   crisper than the artwork behind it, and no amount of blur fixes that.
		   The glass belongs on the wall label, which sits still; this one has a
		   moving picture underneath it. */
		background: var(--cream);
		border: 1px solid rgba(44, 39, 33, 0.1);
		color: var(--ink);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.6) inset,
			0 2px 8px rgba(6, 7, 8, 0.14),
			0 30px 60px -24px rgba(6, 7, 8, 0.55);
		transition:
			width 420ms cubic-bezier(0.22, 1, 0.36, 1),
			height 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The sheets are stacked on one another; one is shown at a time and they
	   cross over rather than one leaving before the next arrives. */
	.mega__sheet {
		position: absolute;
		inset: 0 auto auto 0;
		width: max-content;
		min-width: 20rem;
		max-width: min(34rem, calc(100vw - 2 * var(--gutter)));
		padding: 1.35rem 1.5rem 0.6rem;
		opacity: 0;
		translate: 0 0.4rem;
		pointer-events: none;
		transition:
			opacity 180ms var(--ease),
			translate 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.mega__sheet[data-active] {
		opacity: 1;
		translate: none;
		pointer-events: auto;
	}

	.mega__edge {
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		background: linear-gradient(
			90deg,
			var(--ochre) 0%,
			var(--rose) 50%,
			var(--sage) 100%
		);
	}

	/* Side by side rather than stacked. Two groups down a narrow card read as
	   one long list with a line through it; two columns read as a panel. */
	.mega__cols {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 clamp(1.25rem, 3vw, 2.25rem);
	}

	.mega__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.7rem;
		font-family: var(--body);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--teal);
	}

	/* The short rule the plates hang their numerals from. */
	.mega__title-rule {
		flex: none;
		width: 0.9rem;
		height: 1px;
		background: color-mix(in srgb, var(--teal) 55%, transparent);
	}

	.mega__links {
		display: grid;
		margin: 0 -0.55rem;
		padding: 0;
		list-style: none;
	}

	/* The whole row is the target and the whole row lights, which is what the
	   donate page does with its three other ways to help. A link you have to
	   hit exactly is a link that feels unfinished. */
	.mega__link {
		/* Teal unless the link is one of the three bodies of work, which answer
		   in their own colour — the same three the triptych and the giving card
		   are marked with. */
		--accent: var(--teal);
		--accent-ink: var(--teal);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.42rem 0.55rem 0.46rem;
		border-radius: 5px;
		font-family: var(--display);
		font-size: 1.0625rem;
		line-height: 1.25;
		color: var(--ink);
		transition:
			background-color 200ms var(--ease),
			color 200ms var(--ease);
	}

	/* The ink is pulled toward the page's own so every colour clears 4.5 on its
	   own wash. At full strength the three sat at 4.34 to 4.43 — the -ink
	   variants are tuned against plain cream, and a wash of the same hue lifts
	   the ground out from under them. */
	.mega__link:hover,
	.mega__link:focus-visible {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: color-mix(in srgb, var(--accent-ink) 85%, var(--ink));
	}

	.mega__link-arrow {
		flex: none;
		font-size: 0.875rem;
		opacity: 0;
		translate: -0.4rem 0;
		transition:
			opacity 200ms var(--ease),
			translate 260ms var(--ease);
	}

	.mega__link:hover .mega__link-arrow,
	.mega__link:focus-visible .mega__link-arrow {
		opacity: 1;
		translate: 0 0;
	}

	/* The way through to everything, given the foot of the panel and the full
	   width of it. */
	.mega__all {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.9rem -1.5rem 0;
		padding: 0.7rem 1.5rem 0.75rem;
		border-top: 1px solid rgba(44, 39, 33, 0.11);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--teal);
		transition: background-color 200ms var(--ease);
	}

	.mega__all:hover,
	.mega__all:focus-visible {
		background: color-mix(in srgb, var(--teal) 7%, transparent);
	}

	.mega__all-arrow {
		transition: translate 260ms var(--ease);
	}

	.mega__all:hover .mega__all-arrow,
	.mega__all:focus-visible .mega__all-arrow {
		translate: 0.25rem 0;
	}


	/* ── Mobile ─────────────────────────────────────────────────────────── */

	.nav__burger {
		display: none;
		flex: none;
		width: 1.75rem;
		height: 1.25rem;
		flex-direction: column;
		justify-content: center;
		gap: 0.375rem;
	}

	.nav__burger-bar {
		display: block;
		height: 1px;
		background: currentColor;
		transition: transform 320ms var(--ease);
	}

	.nav__burger[aria-expanded='true'] .nav__burger-bar:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}

	.nav__burger[aria-expanded='true'] .nav__burger-bar:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	.drawer {
		position: fixed;
		inset: var(--nav-h) 0 0;
		overflow-y: auto;
		background: var(--cream);
		color: var(--ink);
		opacity: 0;
		transition: opacity 300ms var(--ease);
	}

	.drawer[data-open] {
		opacity: 1;
	}

	.drawer__inner {
		display: grid;
		gap: 2.25rem;
		padding: 2.5rem var(--gutter) 4rem;
	}

	.drawer__title {
		margin-bottom: 0.75rem;
		font-size: 1.75rem;
		color: var(--teal);
	}

	.drawer__links {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 1.0625rem;
		color: var(--ink-soft);
	}

	.pill--drawer {
		justify-self: start;
		background: var(--teal);
		color: var(--warm-white);
		padding: 0.7rem 1.75rem;
	}

	/* Below this the full lockup cannot fit beside the menu button. At 360 it
	   was setting THE ITT / FOUNDATI — a clipped wordmark reads as a fault, and
	   it was taking the room the actions needed. The mark is the identity; the
	   name is a courtesy the bar cannot afford at this width, and it is at the
	   top of every page the bar sits on anyway. */
	@media (max-width: 30rem) {
		.brand__word {
			display: none;
		}

		.brand {
			--mark-h: 2rem;
		}
	}

	/* Between a phone and a laptop it fits, but not at the size it is set on a
	   wide screen. */
	@media (min-width: 30.0625rem) and (max-width: 60rem) {
		.brand {
			--mark-h: 2.1rem;
			--wordmark-size: 0.86rem;
		}
	}

	@media (max-width: 60rem) {
		/* The menu's wrapper, not just its list: a zero-width flex item still
		   draws the gaps either side of it, which is 32px the bar does not have
		   at 360. */
		.nav__menu,
		.nav__inner > .pill {
			display: none;
		}

		.nav__burger {
			display: flex;
		}

		/* The action and the menu button are a pair at this width, the way the
		   two pills are on a wide bar. Closed up, the action sits further from
		   the lockup and nearer the edge it belongs to. */
		.cta + .nav__burger,
		.who + .nav__burger {
			margin-left: calc(var(--nav-gap) * -0.45);
		}

		.brand {
			margin-right: auto;
			/* Lets the lockup give way rather than push the bar wider than the
			   screen. */
			min-width: 0;
		}

		/* On mobile the drawer is cream, so the bar must read as light while
		   it is open regardless of what is behind the page. */
		.nav:has(.drawer[data-open]) {
			color: var(--teal);
			--wordmark-name: var(--ink);
			--wordmark-sub: var(--teal);
		}

		.nav:has(.drawer[data-open]) .nav__inner {
			background: var(--cream);
		}

		.nav:has(.drawer[data-open]) .brand__word {
			max-width: 14rem;
			padding-left: 1.1rem;
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-nav]');
	if (nav) {
		const items = [...nav.querySelectorAll<HTMLElement>('[data-menu-item]')];
		const menu = nav.querySelector<HTMLElement>('[data-mega]');
		const frame = nav.querySelector<HTMLElement>('[data-mega-frame]');
		const sheets = [...nav.querySelectorAll<HTMLElement>('[data-mega-sheet]')];
		const inner = nav.querySelector<HTMLElement>('.nav__inner');
		let openTimer: number | undefined;
		let openIndex = -1;

		/** Links inside a sheet nobody is looking at are not tab stops. */
		const reach = (sheet: HTMLElement, on: boolean) => {
			sheet.toggleAttribute('data-active', on);
			sheet.setAttribute('aria-hidden', String(!on));
			for (const a of sheet.querySelectorAll<HTMLAnchorElement>('a')) {
				if (on) a.removeAttribute('tabindex');
				else a.setAttribute('tabindex', '-1');
			}
		};

		const closeAll = () => {
			openIndex = -1;
			nav.classList.remove('is-open');
			for (const item of items) {
				item.querySelector('[data-menu-trigger]')!.setAttribute('aria-expanded', 'false');
			}
			for (const sheet of sheets) reach(sheet, false);
		};

		/**
		 * One panel, moved and resized rather than replaced.
		 *
		 * The frame is given the size of the sheet that is about to show and
		 * slides to sit under the label that asked for it, so crossing the bar is
		 * a single object changing shape. Both are custom properties, so the
		 * transitions are declared in the stylesheet with everything else.
		 */
		const open = (item: HTMLElement) => {
			const index = Number(item.dataset.menuIndex ?? -1);
			const sheet = sheets[index];
			if (!menu || !frame || !sheet || !inner) return;
			if (index === openIndex) return;

			for (const other of sheets) if (other !== sheet) reach(other, false);
			reach(sheet, true);

			// Sized from the sheet itself rather than from a number written here,
			// so a menu that gains a link still fits.
			frame.style.setProperty('--mega-w', `${sheet.offsetWidth}px`);
			frame.style.setProperty('--mega-h', `${sheet.offsetHeight}px`);

			// Under its own label, less the sheet's padding, so the first link in
			// the panel sits on the same vertical as the label above it. Clamped
			// to the gutter at both ends: a panel that runs off the screen is
			// worse than one that stops short of its label.
			const bar = inner.getBoundingClientRect();
			const label = item.getBoundingClientRect();
			const pad = parseFloat(getComputedStyle(sheet).paddingLeft) || 0;
			const gutter = parseFloat(getComputedStyle(inner).paddingLeft) || 0;
			const room = bar.width - gutter * 2 - sheet.offsetWidth;
			const wanted = label.left - bar.left - gutter - pad;
			menu.style.setProperty('--mega-x', `${Math.max(0, Math.min(wanted, room))}px`);

			openIndex = index;
			nav.classList.add('is-open');
			for (const other of items) {
				other
					.querySelector('[data-menu-trigger]')!
					.setAttribute('aria-expanded', String(other === item));
			}
		};

		for (const item of items) {
			const trigger = item.querySelector<HTMLButtonElement>('[data-menu-trigger]')!;

			item.addEventListener('pointerenter', () => {
				window.clearTimeout(openTimer);
				open(item);
			});

			item.addEventListener('pointerleave', () => {
				openTimer = window.setTimeout(closeAll, 220);
			});

			trigger.addEventListener('click', () => {
				const isOpen = trigger.getAttribute('aria-expanded') === 'true';
				isOpen ? closeAll() : open(item);
			});

			trigger.addEventListener('focus', () => open(item));
		}

		// The panel is a sibling of the labels now, so leaving it has to be
		// watched on its own rather than on the item that opened it.
		menu?.addEventListener('pointerenter', () => window.clearTimeout(openTimer));
		menu?.addEventListener('pointerleave', () => {
			openTimer = window.setTimeout(closeAll, 220);
		});

		// A sheet measured before its fonts load is a sheet measured at the wrong
		// size, and the frame would keep that size until something reopened it.
		const remeasure = () => {
			if (openIndex < 0) return;
			const sheet = sheets[openIndex];
			frame?.style.setProperty('--mega-w', `${sheet.offsetWidth}px`);
			frame?.style.setProperty('--mega-h', `${sheet.offsetHeight}px`);
		};
		window.addEventListener('resize', () => {
			closeAll();
			remeasure();
		});
		document.fonts?.ready.then(remeasure);

		nav.addEventListener('focusout', (event) => {
			if (!nav.contains(event.relatedTarget as Node)) closeAll();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeAll();
		});

		// Mobile drawer.
		const burger = nav.querySelector<HTMLButtonElement>('[data-burger]');
		const drawer = nav.querySelector<HTMLElement>('[data-drawer]');
		burger?.addEventListener('click', () => {
			const isOpen = burger.getAttribute('aria-expanded') === 'true';
			burger.setAttribute('aria-expanded', String(!isOpen));
			if (!drawer) return;
			if (isOpen) {
				drawer.removeAttribute('data-open');
				drawer.hidden = true;
				document.body.style.removeProperty('overflow');
			} else {
				drawer.hidden = false;
				requestAnimationFrame(() => drawer.setAttribute('data-open', ''));
				document.body.style.overflow = 'hidden';
			}
		});
	}
</script>
