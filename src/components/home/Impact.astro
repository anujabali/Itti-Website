---
/**
 * Impact — the proof behind the poetry, and the reason a foundation page is
 * trusted at all.
 *
 * Set as a table of measures rather than four cards: a rule over the row, a
 * hairline between each figure, the numeral in the colour of the work it
 * counts. Four boxes would be four things; ruled columns are one statement
 * read across.
 *
 * No captions. A sentence under each number was a sentence somebody had to
 * invent, and the labels say what the figures are without help.
 */

const FIGURES = [
	{ value: '14', plus: true, label: 'Countries reached', accent: 'sage' },
	{ value: '10,000', plus: true, label: 'Students impacted', accent: 'ochre' },
	{ value: '1,000', plus: true, label: 'Cancer network', accent: 'rose' },
	{ value: '3', plus: true, label: 'Years of community action', accent: 'teal' },
];
---

<section class="impact" id="impact" aria-labelledby="impact-heading">
	<div class="impact__head">
		<p class="impact__eyebrow">
			<span class="impact__eyebrow-rule" aria-hidden="true"></span>
			Impact
		</p>
		<h2 class="impact__title" id="impact-heading">Change created together</h2>
	</div>

	<dl class="impact__row">
		{
			FIGURES.map((figure) => (
				<div
					class="figure"
					style={`--accent: var(--${figure.accent}); --accent-ink: var(--${figure.accent}-ink)`}
				>
					<dt class="figure__value">
						{figure.value}
						{figure.plus && (
							<span class="figure__plus" aria-hidden="true">
								+
							</span>
						)}
					</dt>
					<dd class="figure__label">{figure.label}</dd>
				</div>
			))
		}
	</dl>
</section>

<style>
	.impact {
		padding: clamp(3.5rem, 9vh, 6rem) var(--gutter);
	}

	/* The same measure as the table under it, so the heading and the first
	   numeral start on one line down the left. */
	.impact__head {
		display: grid;
		gap: 0.9rem;
		max-width: 76rem;
		margin: 0 auto clamp(2.5rem, 6vh, 4rem);
	}

	.impact__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--teal);
	}

	.impact__eyebrow-rule {
		display: block;
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	.impact__title {
		margin: 0;
		font-family: var(--face-bodoni);
		font-size: clamp(2rem, 4.4vw, 3.25rem);
		font-weight: var(--display-weight);
		line-height: 1.06;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: balance;
	}

	/* Four measures, each under a rule in the colour of the work it counts.

	   The hairlines between columns had to go. A grid line is a promise that
	   what sits either side of it is the same shape, and these are not: "3" is
	   two glyphs and "10,000" is six, so every column was a different amount of
	   ink against the same ruled box and the row read as lopsided. A rule over
	   each figure makes four marks instead of one grid, and uneven widths stop
	   being a fault. It also puts the colour in the structure rather than only
	   in the numeral. */
	.impact__row {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(2rem, 4vw, 3.25rem);
		max-width: 76rem;
		margin: 0 auto;
	}

	.figure {
		display: grid;
		align-content: start;
		gap: clamp(0.7rem, 1.6vh, 1rem);
		padding-top: clamp(1.1rem, 2.4vh, 1.5rem);
		border-top: 3px solid var(--accent);
	}

	/* Lining, tabular figures so the four sit on one baseline grid. */
	.figure__value {
		display: flex;
		align-items: flex-start;
		gap: 0.03em;
		margin: 0;
		font-family: var(--face-bodoni);
		font-size: clamp(2.5rem, 5.2vw, 3.5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.02em;
		color: var(--accent-ink, var(--teal));
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* The plus is the whole claim — every one of these is a floor, not a count.
	   It was set at less than half the numeral and faded, which on a page read
	   at arm's length is a mark nobody sees. Two thirds, full strength, tucked
	   against the last digit. */
	.figure__plus {
		font-size: 0.66em;
		line-height: 1;
		padding-top: 0.06em;
	}

	.figure__label {
		margin: 0;
		max-width: 16ch;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		line-height: 1.5;
		text-transform: uppercase;
		color: var(--ink);
	}

	@media (min-width: 34rem) {
		.impact__row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 62rem) {
		.impact__row {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
