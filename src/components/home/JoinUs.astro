---
/**
 * Join Us — the pathways hub, the newsletter and the way to reach a person,
 * combined into one band so the page has a single ending rather than three.
 *
 * Donate is deliberately dominant; the other three are equal to each other and
 * quieter than it. The form posts nowhere yet — wiring it up needs a provider
 * decision, and a privacy line that means something.
 */

const PATHS = [
	{ label: 'Become a member', line: 'N.A.', href: '/join/member' },
	{ label: 'Volunteer & partner', line: 'N.A.', href: '/join/volunteer' },
	// The fourth pathway DECISIONS lists. It points at the form below rather
	// than a page of its own, which is also what fills the row of three.
	{ label: 'Subscribe', line: 'N.A.', href: '#subscribe-email' },
];
---

<section class="join" aria-labelledby="join-heading">
	<div class="join__lead">
		<p class="join__eyebrow">Join us</p>
		<h2 class="join__title" id="join-heading">N.A.</h2>
		<p class="join__line">N.A.</p>
	</div>

	<div class="join__paths">
		<a class="path path--primary" href="/join/donate">
			<span class="path__primary-text">
				<span class="path__label">Donate</span>
				<span class="path__line">N.A.</span>
			</span>
			<span class="path__cta" aria-hidden="true">&rarr;</span>
		</a>

		{
			PATHS.map((path) => (
				<a class="path" href={path.href}>
					<span class="path__label">{path.label}</span>
					<span class="path__line">{path.line}</span>
					<span class="path__cta" aria-hidden="true">
						&rarr;
					</span>
				</a>
			))
		}
	</div>

	<div class="join__base">
		<form class="subscribe" data-subscribe>
			<label class="subscribe__label" for="subscribe-email">N.A.</label>
			<div class="subscribe__row">
				<input
					class="subscribe__input"
					id="subscribe-email"
					name="email"
					type="email"
					autocomplete="email"
					placeholder="you@example.com"
					required
				/>
				<button class="subscribe__button" type="submit">Subscribe</button>
			</div>
			<p class="subscribe__note" data-subscribe-note aria-live="polite">
				Not yet connected — this form does not send anywhere.
			</p>
		</form>

		<address class="contact">
			<p class="contact__eyebrow">Contact</p>
			<p class="contact__line">
				N.A.
			</p>
			<p class="contact__line contact__line--muted">N.A.</p>
		</address>
	</div>
</section>

<style>
	.join {
		display: grid;
		gap: clamp(2.5rem, 6vh, 4rem);
		padding: clamp(4rem, 10vh, 7rem) var(--gutter);
		background: var(--cream-deep);
		border-top: 1px solid rgba(44, 39, 33, 0.12);
	}

	.join__eyebrow {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.join__title {
		margin-top: 0.9rem;
		max-width: 26rem;
		font-size: clamp(1.875rem, 3.8vw, 2.75rem);
		line-height: 1.12;
	}

	.join__line {
		margin-top: 1rem;
		max-width: 34rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	/* Donate takes the full first row; the rest share the second. The hierarchy
	   is in the layout, not in a louder colour. */
	/* Exactly three columns, not auto-fit: auto-fit sizes columns to the
	   available width and then leaves the surplus empty, so three cards stopped
	   two-thirds of the way across a wide screen. */
	.join__paths {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 60rem) {
		.join__paths {
			grid-template-columns: 1fr;
		}
	}

	.path {
		display: grid;
		gap: 0.6rem;
		padding: 1.5rem 1.6rem 1.4rem;
		border: 1px solid rgba(44, 39, 33, 0.14);
		border-radius: 0.875rem;
		background: var(--cream);
		transition:
			border-color 250ms var(--ease),
			transform 250ms var(--ease);
	}

	.path:hover {
		border-color: var(--teal);
		transform: translateY(-2px);
	}

	/* A band rather than a slab: full width, but only as tall as it needs to be,
	   with the label and the arrow on the same optical line. */
	.path--primary {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.4rem 1.75rem;
		background: var(--teal);
		border-color: transparent;
		color: var(--cream);
	}

	.path__primary-text {
		display: grid;
		gap: 0.35rem;
	}

	.path--primary .path__cta {
		font-size: 1.75rem;
		opacity: 0.8;
	}

	.path__label {
		font-family: var(--display);
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		line-height: 1.1;
	}

	.path--primary .path__label {
		font-size: clamp(1.75rem, 3.2vw, 2.375rem);
	}

	.path__line {
		max-width: 30rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.path--primary .path__line {
		color: rgba(251, 248, 240, 0.85);
	}

	.path__cta {
		font-size: 1.125rem;
		opacity: 0.6;
	}

	/* ── Subscribe and contact ──────────────────────────────────────────── */

	.join__base {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
		gap: clamp(2rem, 5vw, 4rem);
		padding-top: clamp(2rem, 4vh, 3rem);
		border-top: 1px solid rgba(44, 39, 33, 0.14);
	}

	.subscribe__label {
		display: block;
		max-width: 26rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--ink);
	}

	.subscribe__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.subscribe__input {
		flex: 1 1 14rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid rgba(44, 39, 33, 0.2);
		border-radius: 0.5rem;
		background: var(--cream);
		font: inherit;
		font-size: 1rem;
		color: var(--ink);
	}

	.subscribe__input:focus-visible {
		outline: 1.5px solid var(--teal);
		outline-offset: 1px;
	}

	.subscribe__button {
		padding: 0.7rem 1.4rem;
		border-radius: 0.5rem;
		background: var(--teal);
		color: var(--cream);
		font-size: 1rem;
	}

	.subscribe__note {
		margin-top: 0.7rem;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.contact {
		font-style: normal;
	}

	.contact__eyebrow {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.contact__line {
		margin-top: 0.8rem;
		font-family: var(--display);
		font-size: 1.25rem;
		color: var(--teal);
	}

	.contact__line--muted {
		font-family: var(--body);
		font-size: 0.9375rem;
		color: var(--ink-soft);
	}
</style>

<script>
	// Placeholder handling, so the form cannot silently pretend to work.
	const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const note = form.querySelector<HTMLElement>('[data-subscribe-note]');
		if (note) note.textContent = 'Not yet connected — no provider is wired up.';
	});
</script>
