---
/**
 * Join Us — the pathways, the newsletter and the way to reach a person, in one
 * band so the page has a single ending rather than three.
 *
 * Set as a ruled list rather than cards. Four bordered rectangles were four
 * objects competing for the same attention, and the one that mattered had to
 * shout in teal to be heard over the other three. A list gives the hierarchy
 * away for free: Donate is first, set largest, in its own colour, and the rest
 * follow it down the page in the order somebody is likely to want them.
 *
 * Donate points at the donate page. It pointed at the registration form for as
 * long as there was no donate page to point at, and stayed there after there
 * was — which left the most prominent word on the home page sending people to
 * fill in a form instead. The bar's own Donate pill only appears once somebody
 * has signed in, so this and the footer are the whole of the way there for
 * everybody else.
 *
 * The form posts nowhere yet. It says so, on the form, rather than accepting an
 * address and dropping it.
 */

const PATHS = [
	{
		label: 'Donate',
		line: 'Every contribution turns care and ideas into work that reaches somebody.',
		href: '/donate',
		lead: true,
	},
	{
		label: 'Become a member',
		line: 'Join a community committed to inclusion, learning and lasting change.',
		href: '/join',
	},
	{
		label: 'Volunteer & partner',
		line: 'Share your time, skills or resources to help our work reach further.',
		href: '/join',
	},
];
---

<section class="join" id="join" aria-labelledby="join-heading">
	<div class="join__head">
		<p class="join__eyebrow">
			<span class="join__eyebrow-rule" aria-hidden="true"></span>
			Join us
		</p>
		<h2 class="join__title" id="join-heading">
			Your action can become someone’s turning point
		</h2>
		<p class="join__line">
			Give, volunteer, partner with us or stay connected, and you are part of a
			community creating kinder, healthier and more sustainable futures.
		</p>
	</div>

	{/* A ruled list. The first row is the one being asked for, and says so in
	    size and colour rather than in a filled rectangle. */}
	<ul class="paths">
		{
			PATHS.map((path) => (
				<li class:list={['paths__item', path.lead && 'paths__item--lead']}>
					<a class="path" href={path.href}>
						<span class="path__label">{path.label}</span>
						<span class="path__line">{path.line}</span>
						<span class="path__arrow" aria-hidden="true">
							&rarr;
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="join__base">
		<form class="subscribe" data-subscribe>
			<h3 class="subscribe__heading">Stay connected</h3>
			<p class="subscribe__desc">
				Stories from the community, what is coming up, and simple ways to take part.
			</p>

			{/* One ruled line, the way every field on the registration form is set.
			    A boxed input beside a filled button was the only place on this page
			    that looked like a different website. */}
			<div class="subscribe__row">
				<label class="u-visually-hidden" for="subscribe-email">Email address</label>
				<input
					class="subscribe__input"
					id="subscribe-email"
					name="email"
					type="email"
					autocomplete="email"
					placeholder="you@example.com"
					required
				/>
				<button class="subscribe__button" type="submit">
					Subscribe
					<span class="subscribe__arrow" aria-hidden="true">&rarr;</span>
				</button>
			</div>

			<p class="subscribe__note" data-subscribe-note aria-live="polite">
				Not yet connected — this form does not send anywhere.
			</p>
		</form>

		<address class="contact">
			<p class="contact__eyebrow">
				<span class="contact__eyebrow-rule" aria-hidden="true"></span>
				Contact
			</p>
			<h3 class="contact__heading">Let’s create change together</h3>
			<p class="contact__desc">
				For collaborations, volunteering, workshops or anything else, write to us.
			</p>
			<a class="contact__link" href="mailto:hello@itti.org.in">
				hello@itti.org.in
				<span class="contact__arrow" aria-hidden="true">&rarr;</span>
			</a>
		</address>
	</div>
</section>

<style>
	.join {
		display: grid;
		gap: clamp(2.5rem, 6vh, 4rem);
		padding: clamp(4rem, 10vh, 7rem) var(--gutter);
		background: var(--cream-deep);
		border-top: 1px solid rgba(44, 39, 33, 0.12);
	}

	/* ── The head ─────────────────────────────────────────────────────────── */

	.join__head {
		display: grid;
		gap: 0.9rem;
		max-width: 76rem;
		width: 100%;
		margin-inline: auto;
	}

	.join__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--teal);
	}

	.join__eyebrow-rule {
		display: block;
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	.join__title {
		margin: 0;
		max-width: 22ch;
		font-family: var(--face-bodoni);
		font-size: clamp(2rem, 4.4vw, 3.25rem);
		font-weight: var(--display-weight);
		line-height: 1.06;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	.join__line {
		margin: 0.35rem 0 0;
		max-width: 46ch;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	/* ── The paths ────────────────────────────────────────────────────────── */

	.paths {
		max-width: 76rem;
		width: 100%;
		margin-inline: auto;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(44, 39, 33, 0.16);
	}

	.paths__item {
		border-bottom: 1px solid rgba(44, 39, 33, 0.12);
	}

	/* A row of the list, and the whole row is the target. The grid keeps the
	   arrow against the right edge at any width, so the three read as one column
	   of actions rather than three lines of different lengths. */
	.path {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 0.35rem clamp(1.25rem, 4vw, 3rem);
		padding: clamp(1.35rem, 3.2vh, 2rem) 0;
		transition: transform 380ms var(--ease);
	}

	.path__label {
		grid-column: 1;
		font-family: var(--face-bodoni);
		font-size: clamp(1.375rem, 2.6vw, 1.875rem);
		line-height: 1.15;
		color: var(--ink);
	}

	.path__line {
		grid-column: 1;
		max-width: 56ch;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.path__arrow {
		grid-column: 2;
		grid-row: 1 / -1;
		align-self: center;
		font-size: 1.125rem;
		color: var(--teal);
		transition: translate 340ms var(--ease);
	}

	/* Once there is room, the row is read across rather than down: what it is,
	   what it means, and the way in — three things on one line, which is what
	   keeps the middle of a wide row from being empty. */
	@media (min-width: 58rem) {
		.path {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.15fr) auto;
			align-items: center;
			gap: clamp(1.5rem, 4vw, 3.5rem);
		}

		.path__label {
			grid-row: 1;
		}

		.path__line {
			grid-column: 2;
			grid-row: 1;
			margin: 0;
		}

		.path__arrow {
			grid-column: 3;
			grid-row: 1;
		}
	}

	/* Donate. Larger, in the brand's own colour, and given a marker in the
	   gutter — enough that it is plainly the first thing asked, without a filled
	   rectangle around it. */
	.paths__item--lead .path__label {
		font-size: clamp(1.75rem, 3.6vw, 2.6rem);
		color: var(--teal);
	}

	.paths__item--lead .path__line {
		font-size: 1rem;
		color: var(--ink);
	}

	.paths__item--lead .path__arrow {
		font-size: 1.4rem;
	}

	.path:hover,
	.path:focus-visible {
		transform: translateX(0.4rem);
	}

	.path:hover .path__arrow,
	.path:focus-visible .path__arrow {
		translate: 0.45rem 0;
	}

	/* ── The foot ─────────────────────────────────────────────────────────── */

	.join__base {
		display: grid;
		gap: clamp(2.5rem, 6vh, 3.5rem);
		max-width: 76rem;
		width: 100%;
		margin-inline: auto;
	}

	.subscribe,
	.contact {
		display: grid;
		gap: 0.75rem;
		align-content: start;
		font-style: normal;
	}

	.subscribe__heading,
	.contact__heading {
		margin: 0;
		font-family: var(--face-bodoni);
		font-size: clamp(1.25rem, 2.2vw, 1.625rem);
		line-height: 1.2;
		color: var(--ink);
	}

	.subscribe__desc,
	.contact__desc {
		margin: 0;
		max-width: 44ch;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.contact__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--teal);
	}

	.contact__eyebrow-rule {
		display: block;
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	.contact__link {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.35rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid color-mix(in srgb, var(--teal) 40%, transparent);
		font-size: 1.0625rem;
		color: var(--teal);
	}

	.contact__arrow {
		transition: translate 320ms var(--ease);
	}

	.contact__link:hover .contact__arrow,
	.contact__link:focus-visible .contact__arrow {
		translate: 0.3rem 0;
	}

	/* A ruled field, like every field on the registration form. */
	.subscribe__row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.4rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid rgba(44, 39, 33, 0.3);
		transition: border-color 260ms var(--ease);
	}

	.subscribe__row:focus-within {
		border-bottom-color: var(--teal);
	}

	.subscribe__input {
		flex: 1 1 auto;
		min-width: 0;
		border: 0;
		border-radius: 0;
		background: none;
		padding: 0.25rem 0;
		font: inherit;
		font-size: 1.0625rem;
		color: var(--ink);
	}

	.subscribe__input::placeholder {
		color: var(--ink-faint);
	}

	.subscribe__input:focus {
		outline: none;
	}

	.subscribe__button {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--teal);
		cursor: pointer;
	}

	.subscribe__arrow {
		transition: translate 320ms var(--ease);
	}

	.subscribe__button:hover .subscribe__arrow,
	.subscribe__button:focus-visible .subscribe__arrow {
		translate: 0.3rem 0;
	}

	.subscribe__note {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	@media (min-width: 58rem) {
		.join__base {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			gap: clamp(3rem, 7vw, 6rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.path,
		.path:hover,
		.path__arrow,
		.contact__arrow,
		.subscribe__arrow {
			transition: none;
			transform: none;
			translate: none;
		}
	}
</style>

<script>
	// Placeholder handling, so the form cannot silently pretend to work.
	const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const note = form.querySelector<HTMLElement>('[data-subscribe-note]');
		if (note) note.textContent = 'Not yet connected — no provider is wired up.';
	});
</script>
