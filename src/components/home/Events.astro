---
/**
 * Events — three or four, upcoming or ongoing. One of these is the same event
 * carried in the Featured band above, which is deliberate: the band is the
 * invitation, this is the schedule.
 *
 * Content is PLACEHOLDER. Dates carry a machine-readable `datetime`.
 */

const EVENTS = [
	{
		datetime: '2026-09-12',
		day: 'N.A.',
		month: 'N.A.',
		status: 'N.A.',
		title: 'N.A.',
		place: 'N.A.',
		line: 'N.A.',
		href: '/events/founding-day',
	},
	{
		datetime: '2026-10-04',
		day: 'N.A.',
		month: 'N.A.',
		status: 'N.A.',
		title: 'N.A.',
		place: 'N.A.',
		line: 'N.A.',
		href: '/events/assessment-clinic',
	},
	{
		datetime: '2026-07-01',
		day: 'N.A.',
		month: 'N.A.',
		status: 'N.A.',
		title: 'N.A.',
		place: 'N.A.',
		line: 'N.A.',
		href: '/events/restoration-season',
	},
];
---

<section class="events" aria-labelledby="events-heading">
	<div class="events__head">
		<p class="events__eyebrow">Events</p>
		<h2 class="events__title" id="events-heading">N.A.</h2>
		<a class="events__all" href="/events">N.A. &rarr;</a>
	</div>

	<ul class="events__list">
		{
			EVENTS.map((event) => (
				<li class="event">
					<a class="event__link" href={event.href}>
						<time class="event__date" datetime={event.datetime}>
							<span class="event__day">{event.day}</span>
							<span class="event__month">{event.month}</span>
						</time>

						<div class="event__body">
							<p class="event__status">{event.status}</p>
							<h3 class="event__name">{event.title}</h3>
							<p class="event__line">{event.line}</p>
							<p class="event__place">{event.place}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.events {
		padding: clamp(4rem, 10vh, 7rem) var(--gutter);
	}

	.events__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 1rem 2rem;
	}

	.events__eyebrow {
		flex: 100%;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.events__title {
		font-size: clamp(1.75rem, 3.4vw, 2.5rem);
		line-height: 1.12;
	}

	.events__all {
		margin-left: auto;
		font-family: var(--display);
		font-size: 1.0625rem;
		color: var(--teal);
	}

	.events__all:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.events__list {
		margin: clamp(2.5rem, 5vh, 3.5rem) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(44, 39, 33, 0.14);
	}

	.event {
		border-bottom: 1px solid rgba(44, 39, 33, 0.14);
	}

	.event__link {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: clamp(1.25rem, 4vw, 3rem);
		padding: clamp(1.5rem, 3vh, 2.25rem) 0;
		transition: opacity 250ms var(--ease);
	}

	.event__link:hover {
		opacity: 0.72;
	}

	.event__date {
		display: grid;
		gap: 0.2rem;
		align-content: start;
		text-align: center;
		padding-top: 0.35rem;
	}

	.event__day {
		font-family: var(--display);
		font-size: 2rem;
		line-height: 1;
		color: var(--teal);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.event__month {
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.event__status {
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.event__name {
		margin-top: 0.5rem;
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		line-height: 1.15;
	}

	.event__line {
		margin-top: 0.6rem;
		max-width: 38rem;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.event__place {
		margin-top: 0.7rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	@media (max-width: 40rem) {
		.event__link {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.event__date {
			display: flex;
			gap: 0.5rem;
			align-items: baseline;
			text-align: left;
			padding-top: 0;
		}

		.event__day {
			font-size: 1.5rem;
		}
	}
</style>
