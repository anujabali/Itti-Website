---
/**
 * The Itti Foundation — Form 1: Basic Information / Get Started Overlay
 *
 * Appears as an elegant, accessible modal overlay on top of the live website,
 * adhering directly to the project's design tokens, typography, and Supabase identity schema.
 *
 * Folder: src/components/forms/form-1/
 */
import Mark from '../../brand/Mark.astro';
import { INDIAN_CITIES } from './cities';

interface Props {
	/** If true, starts visible on page load. Defaults to true for instant evaluation. */
	initiallyOpen?: boolean;
}

const { initiallyOpen = false } = Astro.props;
---

<div
	class="f1-overlay"
	id="form1-modal"
	role="dialog"
	aria-modal="true"
	aria-labelledby="f1-heading"
	data-form1-overlay
	data-initially-open={initiallyOpen ? 'true' : 'false'}
	hidden
>
	<!-- Backdrop scrim with subtle blur -->
	<div class="f1-backdrop" data-f1-backdrop aria-hidden="true"></div>

	<!-- Scrollable viewport frame -->
	<div class="f1-scroller" data-f1-scroller>
		<div class="f1-card" data-f1-card>
			<!-- Top utility bar: brand mark and close button -->
			<div class="f1-topbar">
				<div class="f1-brand" aria-hidden="true">
					<Mark height="1.6rem" />
					<span class="f1-brand__label">The Itti Foundation &middot; Intake</span>
				</div>
				<button
					class="f1-close"
					type="button"
					aria-label="Close Get Started form"
					data-f1-close
				>
					<span class="f1-close__icon" aria-hidden="true">&times;</span>
				</button>
			</div>

			<!-- Main Form Content -->
			<form class="f1-form" id="form1-element" novalidate data-f1-form>
				<!-- Header section -->
				<header class="f1-header">
					<p class="f1-eyebrow">Form 1 &middot; Intake Step 1 of 2</p>
					<h1 class="f1-title" id="f1-heading">Let's Get Started</h1>
					<p class="f1-subtitle">
						Tell us a little about yourself so we can connect you with the right Itti
						Foundation program.
					</p>
				</header>

				<!-- Global error banner (hidden by default) -->
				<div class="f1-alert" id="f1-global-alert" role="alert" hidden>
					<span class="f1-alert__icon" aria-hidden="true">!</span>
					<span class="f1-alert__text" data-f1-global-error></span>
				</div>

				<!-- ════════════ SECTION 1: ABOUT YOU ════════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">01</span>
						<span class="f1-section__text">About You</span>
					</legend>

					<!-- 1. Full Name * -->
					<div class="f1-field" data-field="fullName">
						<label class="f1-label" for="f1-fullName">
							Full Name <span class="f1-req" aria-hidden="true">*</span>
						</label>
						<input
							class="f1-input"
							id="f1-fullName"
							name="fullName"
							type="text"
							placeholder="Enter your full name"
							autocomplete="name"
							maxlength="120"
							required
						/>
						<p class="f1-error" data-error="fullName" role="alert"></p>
					</div>

					<!-- Contact Method Group (Phone OR Email rule) -->
					<div class="f1-contact-group">
						<div class="f1-contact-note">
							<span class="f1-contact-note__badge">Contact Method</span>
							<span
								>Please provide at least <strong>one</strong> of phone number or email address.</span
							>
						</div>

						<div class="f1-grid f1-grid--2col">
							<!-- 2. Phone Number -->
							<div class="f1-field" data-field="phone">
								<label class="f1-label" for="f1-phone"> Phone Number </label>
								<div class="f1-input-affix">
									<input
										class="f1-input"
										id="f1-phone"
										name="phone"
										type="tel"
										placeholder="+91 XXXXX XXXXX"
										autocomplete="tel"
									/>
								</div>
								<p class="f1-error" data-error="phone" role="alert"></p>
							</div>

							<!-- 3. Email Address -->
							<div class="f1-field" data-field="email">
								<label class="f1-label" for="f1-email"> Email Address </label>
								<input
									class="f1-input"
									id="f1-email"
									name="email"
									type="email"
									placeholder="name@example.com"
									autocomplete="email"
								/>
								<p class="f1-error" data-error="email" role="alert"></p>
							</div>
						</div>
						<p class="f1-error f1-error--contact" data-error="contact" role="alert"></p>
					</div>

					<!-- 4. Date of Birth & 5. Gender (2 Column Grid) -->
					<div class="f1-grid f1-grid--2col">
						<!-- 4. Date of Birth -->
						<div class="f1-field" data-field="dateOfBirth">
							<label class="f1-label" for="f1-dob"> Date of Birth </label>
							<input
								class="f1-input f1-input--date"
								id="f1-dob"
								name="dateOfBirth"
								type="date"
								autocomplete="bday"
							/>
							<p class="f1-hint">
								Used only to compute age and provide age-appropriate care.
							</p>
							<p class="f1-error" data-error="dateOfBirth" role="alert"></p>
						</div>

						<!-- 5. Gender (Optional) -->
						<div class="f1-field" data-field="gender">
							<label class="f1-label" for="f1-gender">
								Gender <span class="f1-opt">(Optional)</span>
							</label>
							<div class="f1-select-wrap">
								<select class="f1-select" id="f1-gender" name="gender">
									<option value="">Select gender</option>
									<option value="woman">Female</option>
									<option value="man">Male</option>
									<option value="non_binary">Non-binary / Other</option>
									<option value="undisclosed">Prefer not to say</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 6. City * (Searchable Autocomplete) -->
					<div class="f1-field f1-autocomplete" data-field="city" data-f1-autocomplete>
						<label class="f1-label" for="f1-city-input">
							City <span class="f1-req" aria-hidden="true">*</span>
						</label>
						<div class="f1-autocomplete__box">
							<input
								class="f1-input"
								id="f1-city-input"
								type="text"
								placeholder="Search your city (e.g. Pune, Mumbai, Nagpur)"
								autocomplete="off"
								data-city-input
								required
							/>
							<span
								class="f1-autocomplete__clear"
								data-city-clear
								title="Clear city"
								hidden>&times;</span
							>
						</div>
						<!-- Hidden inputs for canonical city & state -->
						<input type="hidden" name="city" id="f1-city-hidden" data-city-val />
						<input type="hidden" name="state" id="f1-state-hidden" data-state-val />

						<!-- Autocomplete suggestions dropdown -->
						<ul
							class="f1-suggestions"
							id="f1-city-list"
							role="listbox"
							aria-label="City suggestions"
							data-city-suggestions
							hidden
						>
						</ul>
						<p class="f1-error" data-error="city" role="alert"></p>
					</div>

					<!-- 7. Pincode (Optional - revealed naturally after city is selected) -->
					<div
						class="f1-field f1-pincode-reveal"
						id="f1-pincode-container"
						data-field="pincode"
						data-pincode-container
					>
						<label class="f1-label" for="f1-pincode">
							Pincode <span class="f1-opt">(Optional)</span>
						</label>
						<input
							class="f1-input"
							id="f1-pincode"
							name="pincode"
							type="text"
							inputmode="numeric"
							pattern="[1-9][0-9]{5}"
							maxlength="6"
							placeholder="Enter your 6-digit pincode"
						/>
						<p class="f1-hint">
							Assists us with local clinic and volunteer network serviceability.
						</p>
						<p class="f1-error" data-error="pincode" role="alert"></p>
					</div>

					<!-- 8. Preferred Language (Optional) -->
					<div class="f1-field" data-field="preferredLanguage">
						<label class="f1-label" for="f1-language">
							Preferred Language <span class="f1-opt">(Optional)</span>
						</label>
						<div class="f1-select-wrap">
							<select class="f1-select" id="f1-language" name="preferredLanguage">
								<option value="">Select language</option>
								<option value="en">English</option>
								<option value="hi">Hindi</option>
								<option value="mr">Marathi</option>
								<option value="other">Other</option>
							</select>
						</div>
					</div>
				</fieldset>

				<!-- ════════ SECTION 2: CONNECTION WITH ITTI FOUNDATION ════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">02</span>
						<span class="f1-section__text">Your Connection with Itti Foundation</span>
					</legend>

					<!-- 9. I am joining as * -->
					<div class="f1-field" data-field="role">
						<label class="f1-label f1-label--standalone">
							I am joining as <span class="f1-req" aria-hidden="true">*</span>
						</label>

						<div class="f1-choice-grid">
							<label class="f1-choice-card">
								<input type="radio" name="role" value="patient" required />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Patient / Beneficiary</span>
									<span class="f1-choice-card__desc"
										>I am seeking support or guidance for myself</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="caregiver" />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Caregiver / Family Member</span>
									<span class="f1-choice-card__desc"
										>I am supporting a child, parent, spouse, or loved one</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="supporter" />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Volunteer / Supporter</span>
									<span class="f1-choice-card__desc"
										>I want to contribute time, expertise, or resources</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="supporter" data-role-other />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Other</span>
									<span class="f1-choice-card__desc"
										>General community member or interested partner</span
									>
								</span>
							</label>
						</div>
						<p class="f1-error" data-error="role" role="alert"></p>
					</div>
				</fieldset>

				<!-- ════════ SECTION 3: AREA OF INTEREST ════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">03</span>
						<span class="f1-section__text">Area of Interest</span>
					</legend>

					<!-- 10. Which area would you like to connect with? * -->
					<div class="f1-field" data-field="pillar">
						<label class="f1-label f1-label--standalone">
							Which area would you like to connect with? <span
								class="f1-req"
								aria-hidden="true">*</span
							>
						</label>

						<div class="f1-pillar-grid">
							<!-- Neurodivergence -->
							<label class="f1-pillar-card" style="--card-accent: var(--ochre);">
								<input type="radio" name="pillar" value="neurodivergence" required />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar I</span>
									<span class="f1-pillar-card__title">Neurodivergence</span>
									<span class="f1-pillar-card__motto">"A mind met, not mended."</span>
								</div>
							</label>

							<!-- Cancer Care -->
							<label class="f1-pillar-card" style="--card-accent: var(--rose);">
								<input type="radio" name="pillar" value="cancer_care" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar II</span>
									<span class="f1-pillar-card__title">Cancer Care</span>
									<span class="f1-pillar-card__motto"
										>"A cancer caught, not carried."</span
									>
								</div>
							</label>

							<!-- CLAW -->
							<label class="f1-pillar-card" style="--card-accent: var(--sage);">
								<input type="radio" name="pillar" value="claw" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar III</span>
									<span class="f1-pillar-card__title">CLAW</span>
									<span class="f1-pillar-card__motto"
										>"A forest saved, not mourned."</span
									>
								</div>
							</label>

							<!-- I'm not sure yet (maps to 'other' in DB) -->
							<label class="f1-pillar-card" style="--card-accent: var(--teal);">
								<input type="radio" name="pillar" value="other" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">General</span>
									<span class="f1-pillar-card__title">I'm not sure yet</span>
									<span class="f1-pillar-card__motto"
										>Help guide me to the right team</span
									>
								</div>
							</label>
						</div>
						<p class="f1-error" data-error="pillar" role="alert"></p>
					</div>
				</fieldset>

				<!-- ════════ SUBMIT / CONTINUE CTA ════════ -->
				<footer class="f1-footer">
					<div class="f1-footer__action">
						<button class="f1-submit-btn" type="submit" data-f1-submit>
							<span>Continue</span>
							<span class="f1-submit-btn__arrow" aria-hidden="true">&rarr;</span>
						</button>
					</div>
					<p class="f1-footer__disclaimer">
						Your information is handled with care under the Itti Foundation Privacy
						Charter. Step 1 creates your foundational intake profile.
					</p>
				</footer>
			</form>

			<!-- ════════ SUCCESS / HANDOFF CONFIRMATION SCREEN ════════ -->
			<div class="f1-success" data-f1-success hidden>
				<div class="f1-success__icon" aria-hidden="true">&#10003;</div>
				<h2 class="f1-success__title">Step 1 Complete</h2>
				<p class="f1-success__name" data-success-name></p>
				<p class="f1-success__message">
					Your basic profile has been formatted according to the Itti Foundation intake
					schema and safely preserved for the health intake step.
				</p>

				<div class="f1-success__summary" data-success-summary>
					<!-- Generated details injected here -->
				</div>

				<div class="f1-success__actions">
					<button class="f1-submit-btn" type="button" data-f1-close-success>
						<span>Done &amp; Return to Website</span>
					</button>
					<button class="f1-btn-secondary" type="button" data-f1-reset>
						<span>Edit / Start Over</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Reopen Trigger Pill for convenience when overlay is dismissed -->
<button
	class="f1-reopen-pill"
	type="button"
	data-f1-reopen
	title="Open Get Started form"
>
	<span class="f1-reopen-pill__dot" aria-hidden="true"></span>
	<span>Get Started Form</span>
</button>

<style>
	/* ── Scrim & Overlay Container ────────────────────────────────────────── */
	.f1-overlay {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: grid;
		place-items: center;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 320ms var(--ease),
			visibility 320ms var(--ease);
	}

	.f1-overlay.is-active {
		opacity: 1;
		visibility: visible;
	}

	.f1-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 12, 13, 0.74);
		-webkit-backdrop-filter: blur(10px) saturate(120%);
		backdrop-filter: blur(10px) saturate(120%);
		cursor: pointer;
	}

	.f1-scroller {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 3.5vh, 2.75rem) var(--gutter);
		overflow-y: auto;
		overflow-x: hidden;
		-webkit-overflow-scrolling: touch;
	}

	/* ── Main Modal Card ──────────────────────────────────────────────────── */
	.f1-card {
		position: relative;
		width: min(45rem, 100%);
		margin: auto;
		background: #e8e0d1;
		color: var(--ink);
		border: 1px solid rgba(44, 39, 33, 0.12);
		border-radius: 1.25rem;
		box-shadow:
			0 4px 16px rgba(6, 7, 8, 0.18),
			0 28px 72px -16px rgba(6, 7, 8, 0.55);
		padding: clamp(1.75rem, 4.5vw, 3rem);
		transform: scale(0.97) translateY(12px);
		transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.f1-overlay.is-active .f1-card {
		transform: none;
	}

	/* ── Topbar (Brand & Close) ────────────────────────────────────────────── */
	.f1-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(44, 39, 33, 0.1);
		margin-bottom: 1.75rem;
	}

	.f1-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--teal);
	}

	.f1-brand__label {
		font-family: var(--body);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.f1-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		background: rgba(44, 39, 33, 0.06);
		color: var(--ink-soft);
		font-size: 1.5rem;
		line-height: 1;
		transition:
			background 200ms var(--ease),
			color 200ms var(--ease),
			transform 200ms var(--ease);
	}

	.f1-close:hover {
		background: var(--teal);
		color: var(--warm-white);
		transform: scale(1.05);
	}

	/* ── Header ───────────────────────────────────────────────────────────── */
	.f1-header {
		margin-bottom: 2.25rem;
	}

	.f1-eyebrow {
		font-family: var(--body);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--teal);
		margin-bottom: 0.5rem;
	}

	.f1-title {
		font-family: var(--face-bodoni);
		font-size: clamp(1.875rem, 3.4vw, 2.5rem);
		font-weight: 450;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.f1-subtitle {
		margin-top: 0.65rem;
		font-size: 1.0625rem;
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 38rem;
	}

	/* ── Global Alert ─────────────────────────────────────────────────────── */
	.f1-alert {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1.1rem;
		border-radius: 0.6rem;
		background: #fdf2f2;
		border: 1px solid #f2b8b5;
		color: #9c2727;
		margin-bottom: 1.75rem;
		font-size: 0.9375rem;
	}

	.f1-alert__icon {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: #9c2727;
		color: #fff;
		font-size: 0.75rem;
		font-weight: bold;
		flex: none;
	}

	/* ── Fieldsets & Sections ─────────────────────────────────────────────── */
	.f1-section {
		border: none;
		margin: 0 0 2.25rem 0;
		padding: 0;
	}

	.f1-section + .f1-section {
		padding-top: 1.75rem;
		border-top: 1px solid rgba(44, 39, 33, 0.1);
	}

	.f1-section__legend {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--body);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--teal);
		margin-bottom: 1.5rem;
	}

	.f1-section__num {
		font-family: var(--face-bodoni);
		font-size: 1.0625rem;
		opacity: 0.75;
	}

	/* ── Grid Layouts ─────────────────────────────────────────────────────── */
	.f1-grid {
		display: grid;
		gap: 1.25rem;
	}

	.f1-grid--2col {
		grid-template-columns: 1fr 1fr;
	}

	@media (max-width: 44rem) {
		.f1-grid--2col {
			grid-template-columns: 1fr;
		}
	}

	/* ── Form Controls & Fields ───────────────────────────────────────────── */
	.f1-field {
		display: grid;
		gap: 0.45rem;
		margin-bottom: 1.25rem;
	}

	.f1-label {
		display: block;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--ink);
	}

	.f1-label--standalone {
		margin-bottom: 0.75rem;
	}

	.f1-req {
		color: var(--rose);
		font-weight: bold;
		margin-left: 0.15rem;
	}

	.f1-opt {
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--ink-faint);
		margin-left: 0.25rem;
	}

	.f1-input,
	.f1-select {
