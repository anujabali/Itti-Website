---
/**
 * The Itti Foundation — Form 1: basic information.
 *
 * Presented as a card floating over a dark ground, which is where the overlay
 * look comes from — but it is the content of its own page, not a dialog thrown
 * over another one. It used to mount on the homepage and open on load, which
 * put a registration form in front of the opening arc before a visitor had
 * been told anything.
 *
 * Folder: src/components/forms/form-1/
 */
---

<section class="f1-overlay" id="form1-modal" aria-labelledby="f1-heading" data-form1-overlay>
	<div class="f1-scroller" data-f1-scroller>
		<div class="f1-card" data-f1-card>
			<div class="f1-topbar">
				<a class="f1-back" href="/">
					<span class="f1-back__arrow" aria-hidden="true">&larr;</span>
					<span>Back to the site</span>
				</a>
			</div>

			<!-- Main Form Content -->
			<form class="f1-form" id="form1-element" novalidate data-f1-form>
				<!-- Header section -->
				<header class="f1-header">
					<p class="f1-eyebrow">Step one of two</p>
					<h1 class="f1-title" id="f1-heading">Tell us who you are.</h1>
					<p class="f1-subtitle">
						Enough to reach you, and enough to point you to the right part of the
						foundation. Nothing here goes anywhere else.
					</p>
				</header>

				<!-- Global error banner (hidden by default) -->
				<div class="f1-alert" id="f1-global-alert" role="alert" hidden>
					<span class="f1-alert__icon" aria-hidden="true">!</span>
					<span class="f1-alert__text" data-f1-global-error></span>
				</div>

				<!-- ════════════ SECTION 1: ABOUT YOU ════════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">01</span>
						<span class="f1-section__text">About you</span>
					</legend>

					<!-- 1. Full Name * -->
					<div class="f1-field" data-field="fullName">
						<label class="f1-label" for="f1-fullName">
							Full Name
						</label>
						<input
							class="f1-input"
							id="f1-fullName"
							name="fullName"
							type="text"
							placeholder="Enter your full name"
							autocomplete="name"
							maxlength="120"
							required
						/>
						<p class="f1-error" data-error="fullName" role="alert"></p>
					</div>

					<!-- Contact Method Group (Phone OR Email rule) -->
					<div class="f1-contact-group">
						<p class="f1-contact-note">
							A phone number or an email address &mdash; either one is enough.
						</p>

						<div class="f1-grid f1-grid--2col">
							<!-- 2. Phone Number -->
							<div class="f1-field" data-field="phone">
								<label class="f1-label" for="f1-phone"> Phone Number </label>
								<div class="f1-phone-group" data-phone-group>
									<div class="f1-country" data-country-picker>
										<button class="f1-country__button" type="button" data-country-button aria-haspopup="listbox" aria-expanded="false">
											<span data-country-flag>🇮🇳</span>
											<span data-country-name>India</span>
											<span data-country-dial>+91</span>
											<span aria-hidden="true">▾</span>
										</button>
										<div class="f1-country__menu" data-country-menu hidden>
											<input class="f1-input f1-country__search" type="search" placeholder="Search country or code" autocomplete="off" data-country-search aria-label="Search country" />
											<ul class="f1-country__list" data-country-list role="listbox"></ul>
										</div>
									</div>
									<input
										class="f1-input f1-phone-input"
										id="f1-phone"
										name="phone"
										type="tel"
										placeholder="00000 00000"
										inputmode="tel"
										autocomplete="tel-national"
										data-phone-input
									/>
								</div>
								<input type="hidden" name="countryIso2" data-country-iso value="IN" />
								<p class="f1-error" data-error="phone" role="alert"></p>
							</div>

							<!-- 3. Email Address -->
							<div class="f1-field" data-field="email">
								<label class="f1-label" for="f1-email"> Email Address </label>
								<input
									class="f1-input"
									id="f1-email"
									name="email"
									type="email"
									placeholder="name@example.com"
									autocomplete="email"
								/>
								<p class="f1-error" data-error="email" role="alert"></p>
							</div>
						</div>
						<p class="f1-error f1-error--contact" data-error="contact" role="alert"></p>
					</div>

					<!-- 4. Date of Birth & 5. Gender (2 Column Grid) -->
					<div class="f1-grid f1-grid--2col">
						<!-- 4. Date of Birth -->
						<div class="f1-field" data-field="dateOfBirth">
							<label class="f1-label" for="f1-dob"> Date of Birth</label>
							<input
								class="f1-input f1-input--date"
								id="f1-dob"
								name="dateOfBirth"
								required
								type="date"
								autocomplete="bday"
							/>
							<p class="f1-error" data-error="dateOfBirth" role="alert"></p>
						</div>

						<!-- 5. Gender (Required) -->
						<div class="f1-field" data-field="gender">
							<label class="f1-label" for="f1-gender">
								Gender
							</label>
							<div class="f1-select-wrap">
								<select class="f1-select" id="f1-gender" name="gender" required>
									<option value="">Select gender</option>
									<option value="woman">Female</option>
									<option value="man">Male</option>
									<option value="non_binary">Non-binary</option>
									<option value="self_described">Prefer to self-describe</option>
									<option value="undisclosed">Prefer not to say</option>
								</select>
							</div>
							<input
								class="f1-input f1-input--follow"
								name="genderSelfDescribed"
								type="text"
								maxlength="60"
								placeholder="How would you describe it?"
								aria-label="Describe your gender"
								data-gender-self
								hidden
							/>
							<p class="f1-error" data-error="gender" role="alert"></p>
						</div>
					</div>

					<!-- 6. City * (Searchable Autocomplete) -->
					<div class="f1-field f1-autocomplete" data-field="city" data-f1-autocomplete>
						<label class="f1-label" for="f1-city-input">
							City
						</label>
						<div class="f1-autocomplete__box">
							<input
								class="f1-input"
								id="f1-city-input"
								type="text"
								placeholder="Search your city"
								data-city-free
								autocomplete="off"
								data-city-input
								required
							/>
							<span
								class="f1-autocomplete__clear"
								data-city-clear
								title="Clear city"
								hidden>&times;</span
							>
						</div>
						<!-- Hidden inputs for canonical city & state -->
						<input type="hidden" name="city" id="f1-city-hidden" data-city-val />
						<input type="hidden" name="state" id="f1-state-hidden" data-state-val />

						<!-- Autocomplete suggestions dropdown -->
						<ul
							class="f1-suggestions"
							id="f1-city-list"
							role="listbox"
							aria-label="City suggestions"
							data-city-suggestions
							hidden
						>
						</ul>
						<p class="f1-error" data-error="city" role="alert"></p>
					</div>

					<!-- 7. Pincode (Required) -->
					<div class="f1-field" data-field="pincode">
						<label class="f1-label" for="f1-pincode">
							<span data-pincode-label>Pincode</span>
						</label>
						<input
							class="f1-input"
							id="f1-pincode"
							name="pincode"
							type="text"
							inputmode="numeric"
							pattern="[1-9][0-9]{5}"
							maxlength="6"
							placeholder="Enter your 6-digit pincode"
							required
							autocomplete="postal-code"
							data-pincode-field
							data-pincode-input
						/>
						<p class="f1-hint" data-pincode-status></p>
						<p class="f1-error" data-error="pincode" role="alert"></p>
					</div>

					<!-- 8. Preferred Language (Optional) -->
					<div class="f1-field" data-field="preferredLanguage">
						<label class="f1-label" for="f1-language">
							Preferred Language <span class="f1-opt">(Optional)</span>
						</label>
						<div class="f1-select-wrap">
							<select class="f1-select" id="f1-language" name="preferredLanguage">
								<option value="">Select language</option>
								<option value="en">English</option>
								<option value="hi">Hindi</option>
								<option value="mr">Marathi</option>
								<option value="gu">Gujarati</option>
								<option value="bn">Bengali</option>
								<option value="ta">Tamil</option>
								<option value="te">Telugu</option>
								<option value="kn">Kannada</option>
								<option value="ml">Malayalam</option>
								<option value="pa">Punjabi</option>
								<option value="ur">Urdu</option>
								<option value="or">Odia</option>
								<option value="as">Assamese</option>
								<option value="other">Other</option>
							</select>
						</div>
						<div class="f1-reveal" data-language-other-container hidden>
							<label class="f1-label" for="f1-language-other">Other Language</label>
							<input class="f1-input" id="f1-language-other" name="languageOther" type="text" placeholder="Type your language" autocomplete="off" autocapitalize="words" spellcheck="true" data-language-other />
						</div>
					</div>
				</fieldset>

				<!-- ════════ SECTION 2: CONNECTION WITH ITTI FOUNDATION ════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">02</span>
						<span class="f1-section__text">Your connection</span>
					</legend>

					<!-- 9. I am joining as * -->
					<div class="f1-field" data-field="role">
						<label class="f1-label f1-label--standalone">
							I am joining as
						</label>

						<div class="f1-choice-grid">
							<label class="f1-choice-card">
								<input type="radio" name="role" value="patient" required />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Patient / Beneficiary</span>
									<span class="f1-choice-card__desc"
										>I am seeking support or guidance for myself</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="caregiver" />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Caregiver / Family Member</span>
									<span class="f1-choice-card__desc"
										>I am supporting a child, parent, spouse, or loved one</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="supporter" />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Volunteer / Supporter</span>
									<span class="f1-choice-card__desc"
										>I want to contribute time, expertise, or resources</span
									>
								</span>
							</label>

							<label class="f1-choice-card">
								<input type="radio" name="role" value="other" />
								<span class="f1-choice-card__indicator"></span>
								<span class="f1-choice-card__body">
									<span class="f1-choice-card__title">Other</span>
									<span class="f1-choice-card__desc"
										>General community member or interested partner</span
									>
								</span>
							</label>
						</div>
						<p class="f1-error" data-error="role" role="alert"></p>
					</div>
				</fieldset>

				<!-- ════════ SECTION 3: AREA OF INTEREST ════════ -->
				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">03</span>
						<span class="f1-section__text">Area of interest</span>
					</legend>

					<!-- 10. Which area would you like to connect with? * -->
					<div class="f1-field" data-field="pillar">
						<label class="f1-label f1-label--standalone">
							Which area would you like to connect with?
						</label>

						<div class="f1-pillar-grid">
							<!-- Neurodivergence -->
							<label class="f1-pillar-card" style="--card-accent: var(--ochre);">
								<input type="radio" name="pillar" value="neurodivergence" required />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar I</span>
									<span class="f1-pillar-card__title">Neurodivergence</span>
									<span class="f1-pillar-card__motto">"A mind met, not mended."</span>
								</div>
							</label>

							<!-- Cancer Care -->
							<label class="f1-pillar-card" style="--card-accent: var(--rose);">
								<input type="radio" name="pillar" value="cancer_care" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar II</span>
									<span class="f1-pillar-card__title">Cancer Care</span>
									<span class="f1-pillar-card__motto"
										>"A cancer caught, not carried."</span
									>
								</div>
							</label>

							<!-- CLAW -->
							<label class="f1-pillar-card" style="--card-accent: var(--sage);">
								<input type="radio" name="pillar" value="claw" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">Pillar III</span>
									<span class="f1-pillar-card__title">CLAW</span>
									<span class="f1-pillar-card__motto"
										>"A forest saved, not mourned."</span
									>
								</div>
							</label>

							<!-- I'm not sure yet (maps to 'other' in DB) -->
							<label class="f1-pillar-card" style="--card-accent: var(--teal);">
								<input type="radio" name="pillar" value="other" />
								<div class="f1-pillar-card__inner">
									<span class="f1-pillar-card__tag">General</span>
									<span class="f1-pillar-card__title">I'm not sure yet</span>
									<span class="f1-pillar-card__motto"
										>Help guide me to the right team</span
									>
								</div>
							</label>
						</div>
						<p class="f1-error" data-error="pillar" role="alert"></p>
					</div>

				</fieldset>

				<fieldset class="f1-section">
					<legend class="f1-section__legend">
						<span class="f1-section__num">04</span>
						<span class="f1-section__text">Staying in touch</span>
					</legend>

										<div class="f1-field" data-field="consent">
						<label class="f1-label f1-label--standalone">
							How may we contact you?
						</label>
						<p class="f1-hint">
							Optional, and you can change your mind at any time. We will always
							reply to what you send us either way.
						</p>

						<div class="f1-consent-grid">
							<label class="f1-consent" data-consent-needs="phone">
								<input type="checkbox" name="consentWhatsapp" value="yes" />
								<span class="f1-consent__indicator" aria-hidden="true"></span>
								<span class="f1-consent__text">WhatsApp</span>
							</label>

							<label class="f1-consent" data-consent-needs="phone">
								<input type="checkbox" name="consentSms" value="yes" />
								<span class="f1-consent__indicator" aria-hidden="true"></span>
								<span class="f1-consent__text">SMS</span>
							</label>

							<label class="f1-consent" data-consent-needs="email">
								<input type="checkbox" name="consentEmail" value="yes" />
								<span class="f1-consent__indicator" aria-hidden="true"></span>
								<span class="f1-consent__text">Email</span>
							</label>
						</div>
					</div>
				</fieldset>

				<!-- ════════ SUBMIT / CONTINUE CTA ════════ -->
				<footer class="f1-footer">
					<div class="f1-footer__action">
						<button class="f1-submit-btn" type="submit" data-f1-submit>
							<span>Continue</span>
							<span class="f1-submit-btn__arrow" aria-hidden="true">&rarr;</span>
						</button>
					</div>
					<p class="f1-footer__disclaimer">
						We keep these details to reach you and to route you well. We do not sell
						them, and we do not pass them on.
					</p>
				</footer>
			</form>

			<!-- ════════ SUCCESS / HANDOFF CONFIRMATION SCREEN ════════ -->
			<div class="f1-success" data-f1-success hidden>
				<div class="f1-success__icon" aria-hidden="true">&#10003;</div>
				<h2 class="f1-success__title">Step 1 Complete</h2>
				<p class="f1-success__name" data-success-name></p>
				<p class="f1-success__message">
					Your basic profile has been formatted according to the Itti Foundation intake
					schema and safely preserved for the health intake step.
				</p>

				<div class="f1-success__summary" data-success-summary>
					<!-- Generated details injected here -->
				</div>

				<div class="f1-success__actions">
					<a class="f1-submit-btn" href="/">
						<span>Back to the site</span>
					</a>
					<button class="f1-btn-secondary" type="button" data-f1-reset>
						<span>Register someone else</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* ── Scrim & Overlay Container ────────────────────────────────────────── */
	.f1-overlay {
		/* The form is the page, on a plain dark ground. */
		position: relative;
		display: block;
		min-height: 100svh;
		padding: calc(var(--nav-h) + clamp(1.5rem, 5vh, 3.5rem)) var(--gutter)
			clamp(3rem, 9vh, 6rem);
		background: var(--ink-deep);
	}

	.f1-scroller {
		display: block;
	}

	/* ── Main Modal Card ──────────────────────────────────────────────────── */
	.f1-card {
		position: relative;
		width: min(44rem, 100%);
		margin-inline: auto;
		background: var(--cream-deep);
		color: var(--ink);
		border: 1px solid rgba(44, 39, 33, 0.12);
		border-radius: 0.5rem;
		box-shadow:
			0 2px 8px rgba(4, 12, 14, 0.3),
			0 18px 40px -12px rgba(4, 12, 14, 0.55),
			0 60px 120px -40px rgba(4, 12, 14, 0.78);
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
		animation: f1-rise 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes f1-rise {
		from {
			opacity: 0;
			transform: translateY(14px) scale(0.985);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.f1-card {
			animation: none;
		}
	}

	/* ── Topbar (Brand & Close) ────────────────────────────────────────────── */
	.f1-topbar {
		margin-bottom: 1.25rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid rgba(44, 39, 33, 0.1);
	}

	.f1-back {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--ink-faint);
		transition: color 200ms var(--ease);
	}

	.f1-back:hover {
		color: var(--teal);
	}

	.f1-back__arrow {
		transition: transform 200ms var(--ease);
	}

	.f1-back:hover .f1-back__arrow {
		transform: translateX(-3px);
	}

	/* ── Header ───────────────────────────────────────────────────────────── */
	.f1-header {
		margin-bottom: 2.25rem;
	}

	.f1-eyebrow {
		font-family: var(--body);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--teal);
		margin-bottom: 0.5rem;
	}

	.f1-title {
		font-family: var(--face-bodoni);
		font-size: clamp(1.875rem, 3.4vw, 2.5rem);
		font-weight: 450;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.f1-subtitle {
		margin-top: 0.65rem;
		font-size: 1.0625rem;
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 38rem;
	}

	/* ── Global Alert ─────────────────────────────────────────────────────── */
	.f1-alert {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1.1rem;
		border-radius: 0.3rem;
		background: color-mix(in srgb, var(--danger) 7%, var(--warm-white));
		border: 1px solid color-mix(in srgb, var(--danger) 32%, transparent);
		color: var(--danger);
		margin-bottom: 1.75rem;
		font-size: 0.9375rem;
	}

	.f1-alert__icon {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: var(--danger);
		color: var(--warm-white);
		font-size: 0.75rem;
		font-weight: bold;
		flex: none;
	}

	/* ── Fieldsets & Sections ─────────────────────────────────────────────── */
	.f1-section {
		border: none;
		margin: 0 0 2.25rem 0;
		padding: 0;
	}

	.f1-section + .f1-section {
		padding-top: 1.75rem;
		border-top: 1px solid rgba(44, 39, 33, 0.1);
	}

	.f1-section__legend {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--body);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--teal);
		margin-bottom: 1.5rem;
	}

	.f1-section__num {
		font-family: var(--face-bodoni);
		font-size: 1.0625rem;
		opacity: 0.75;
	}

	/* ── Grid Layouts ─────────────────────────────────────────────────────── */
	.f1-grid {
		display: grid;
		gap: 1.25rem;
	}

	.f1-grid--2col {
