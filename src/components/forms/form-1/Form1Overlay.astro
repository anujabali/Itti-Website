</style>

<script>
	import { searchCities } from './cities';
	import { validateForm1 } from './validation';
	import { persistForm1Data } from './schema';
	import { registerMember } from '../../../lib/services/registration';
	import type { Form1Data, Form1Field, Form1Errors } from './types';

	const modal = document.getElementById('form1-modal');
	const form = document.getElementById('form1-element') as HTMLFormElement | null;
	const cityInput = document.querySelector<HTMLInputElement>('[data-city-input]');
	const cityClear = document.querySelector<HTMLElement>('[data-city-clear]');
	const cityHidden = document.getElementById(
		'f1-city-hidden',
	) as HTMLInputElement | null;
	const stateHidden = document.getElementById(
		'f1-state-hidden',
	) as HTMLInputElement | null;
	const suggestionsList = document.querySelector<HTMLUListElement>(
		'[data-city-suggestions]',
	);
	const pincodeContainer = document.querySelector<HTMLElement>(
		'[data-pincode-container]',
	);
	const reopenBtn = document.querySelector<HTMLButtonElement>('[data-f1-reopen]');
	const globalAlert = document.getElementById('f1-global-alert');
	const globalAlertText = document.querySelector<HTMLElement>('[data-f1-global-error]');
	const successView = document.querySelector<HTMLElement>('[data-f1-success]');

	if (modal && form) {
		// ── Open / Close Management ──────────────────────────────────────────
		const openModal = () => {
			modal.hidden = false;
			requestAnimationFrame(() => modal.classList.add('is-active'));
			document.body.style.overflow = 'hidden';
			const firstInput = form.querySelector<HTMLInputElement>(
				'input:not([type="hidden"])',
			);
			firstInput?.focus();
		};

		const closeModal = () => {
			modal.classList.remove('is-active');
			setTimeout(() => {
				modal.hidden = true;
				document.body.style.removeProperty('overflow');
			}, 320);
		};

		// Check initially-open attribute or URL hash
		const shouldOpen =
			modal.getAttribute('data-initially-open') === 'true' ||
			window.location.hash === '#get-started' ||
			window.location.hash === '#join';

		if (shouldOpen) {
			openModal();
		}

		// Close listeners
		modal.querySelectorAll('[data-f1-close]').forEach((btn) => {
			btn.addEventListener('click', closeModal);
		});

		modal.querySelector('[data-f1-backdrop]')?.addEventListener('click', closeModal);

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.hidden) {
				closeModal();
			}
		});

		// Re-open pill
		reopenBtn?.addEventListener('click', () => {
			openModal();
		});

		// Wire any existing 'Join Us' buttons across the site to open Form 1
		document.querySelectorAll('a[href="/join"], a[href="#join"]').forEach((el) => {
			el.addEventListener('click', (ev) => {
				ev.preventDefault();
				openModal();
			});
		});

		// ── Form State & Live Validation ──────────────────────────────────────
		const getFormData = (): Form1Data => {
			const data = new FormData(form);
			return {
				fullName: (data.get('fullName') as string) || '',
				phone: (data.get('phone') as string) || '',
				email: (data.get('email') as string) || '',
				dateOfBirth: (data.get('dateOfBirth') as string) || '',
				gender: (data.get('gender') as any) || '',
				city: (data.get('city') as string) || '',
				state: (data.get('state') as string) || '',
				pincode: (data.get('pincode') as string) || '',
				preferredLanguage: (data.get('preferredLanguage') as any) || '',
				role: (data.get('role') as any) || '',
				pillar: (data.get('pillar') as any) || '',
			};
		};

		const renderErrors = (errors: Form1Errors) => {
			// Clear existing error states
			form.querySelectorAll('.f1-error').forEach((el) => {
				el.textContent = '';
				el.classList.remove('is-visible');
			});
			form.querySelectorAll('.has-error').forEach((el) => {
				el.classList.remove('has-error');
			});

			if (globalAlert && globalAlertText) {
				const errorCount = Object.keys(errors).length;
				if (errorCount > 0) {
					globalAlert.hidden = false;
					globalAlertText.textContent = `Please correct the ${errorCount} highlighted field${errorCount > 1 ? 's' : ''} to continue.`;
				} else {
					globalAlert.hidden = true;
				}
			}

			// Render field-specific errors
			for (const [key, msg] of Object.entries(errors)) {
				const errorEl = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
				if (errorEl && msg) {
					errorEl.textContent = msg;
					errorEl.classList.add('is-visible');
				}

				// Highlight input if applicable
				const fieldContainer = form.querySelector<HTMLElement>(`[data-field="${key}"]`);
				const inputEl = fieldContainer?.querySelector<HTMLElement>('input, select');
				inputEl?.classList.add('has-error');
			}
		};

		// ── City Autocomplete Implementation ──────────────────────────────────
		let activeSuggestionIndex = -1;

		const updatePincodeVisibility = (hasCity: boolean) => {
			if (pincodeContainer) {
				pincodeContainer.classList.toggle('is-revealed', hasCity);
			}
		};

		const selectCity = (city: string, state: string) => {
			if (cityInput && cityHidden && stateHidden) {
				cityInput.value = `${city}, ${state}`;
				cityHidden.value = city;
				stateHidden.value = state;
				if (cityClear) cityClear.hidden = false;
				closeSuggestions();
				updatePincodeVisibility(true);

				// Clear city error if present
				const cityError = form.querySelector('[data-error="city"]');
				cityError?.classList.remove('is-visible');
				cityInput.classList.remove('has-error');

				// Focus pincode smoothly
				setTimeout(() => {
					document.getElementById('f1-pincode')?.focus();
				}, 150);
			}
		};

		const clearCity = () => {
			if (cityInput && cityHidden && stateHidden) {
				cityInput.value = '';
				cityHidden.value = '';
				stateHidden.value = '';
				if (cityClear) cityClear.hidden = true;
				closeSuggestions();
				updatePincodeVisibility(false);
				const pinInput = document.getElementById(
					'f1-pincode',
				) as HTMLInputElement | null;
				if (pinInput) pinInput.value = '';
				cityInput.focus();
			}
		};

		const closeSuggestions = () => {
			if (suggestionsList) {
				suggestionsList.hidden = true;
				suggestionsList.innerHTML = '';
				activeSuggestionIndex = -1;
			}
		};

		const renderSuggestions = (query: string) => {
			if (!suggestionsList) return;
			const matches = searchCities(query);

			if (matches.length === 0) {
				suggestionsList.innerHTML = `
					<li class="f1-suggestion-item" style="color: var(--ink-faint); font-style: italic; cursor: default;">
						No matching Indian city found. You can type your city and select it.
					</li>
				`;
				suggestionsList.hidden = false;
				return;
			}

			suggestionsList.innerHTML = '';
			matches.forEach((item, index) => {
				const li = document.createElement('li');
				li.className = 'f1-suggestion-item';
				li.setAttribute('role', 'option');
				li.setAttribute('data-index', String(index));
				li.innerHTML = `
					<span class="f1-suggestion-item__city">${item.city}</span>
					<span class="f1-suggestion-item__state">${item.state}</span>
				`;
				li.addEventListener('mousedown', (e) => {
					e.preventDefault();
					selectCity(item.city, item.state);
				});
				suggestionsList.appendChild(li);
			});
			suggestionsList.hidden = false;
		};

		cityInput?.addEventListener('input', () => {
			const val = cityInput.value.trim();
			if (cityClear) cityClear.hidden = val.length === 0;

			if (val.length >= 1) {
				renderSuggestions(val);
			} else {
				closeSuggestions();
				updatePincodeVisibility(false);
				if (cityHidden) cityHidden.value = '';
				if (stateHidden) stateHidden.value = '';
			}
		});

		cityClear?.addEventListener('click', clearCity);

		cityInput?.addEventListener('keydown', (e) => {
			if (!suggestionsList || suggestionsList.hidden) return;
			const items = [
				...suggestionsList.querySelectorAll<HTMLElement>(
					'.f1-suggestion-item[data-index]',
				),
			];
			if (!items.length) return;

			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activeSuggestionIndex = (activeSuggestionIndex + 1) % items.length;
				items.forEach((item, i) =>
					item.classList.toggle('is-selected', i === activeSuggestionIndex),
				);
				items[activeSuggestionIndex]?.scrollIntoView({ block: 'nearest' });
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activeSuggestionIndex =
					(activeSuggestionIndex - 1 + items.length) % items.length;
				items.forEach((item, i) =>
					item.classList.toggle('is-selected', i === activeSuggestionIndex),
				);
				items[activeSuggestionIndex]?.scrollIntoView({ block: 'nearest' });
			} else if (e.key === 'Enter') {
				if (activeSuggestionIndex >= 0 && items[activeSuggestionIndex]) {
					e.preventDefault();
					items[activeSuggestionIndex].click();
				}
			} else if (e.key === 'Escape') {
				closeSuggestions();
			}
		});

		cityInput?.addEventListener('blur', () => {
			setTimeout(closeSuggestions, 200);
		});

		// ── Live clearing of errors on user input ──────────────────────────────
		form.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			if (!target) return;
			const name = target.name as Form1Field;
			if (name) {
				const errorEl = form.querySelector(`[data-error="${name}"]`);
				errorEl?.classList.remove('is-visible');
				target.classList.remove('has-error');

				if (name === 'phone' || name === 'email') {
					form.querySelector('[data-error="contact"]')?.classList.remove('is-visible');
				}
			}
		});

		// ── Form Submission Handler ──────────────────────────────────────────
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const data = getFormData();
			const { isValid, errors } = validateForm1(data);

			if (!isValid) {
				renderErrors(errors);
				// Scroll to first error
				const firstErrorField = form.querySelector('.has-error, .is-visible');
				firstErrorField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}

			// Clear errors
			renderErrors({});

			// Map & persist to safe browser session storage (matches Supabase schema)
			const payload = persistForm1Data(data);

			// Map and save directly to Supabase database
			const dbRole =
				data.role === 'supporter' ? 'volunteer' : (data.role as any) || 'other';

			registerMember({
				fullName: data.fullName,
				city: data.city,
				role: dbRole,
				email: data.email || undefined,
				phone: data.phone || undefined,
				dateOfBirth: data.dateOfBirth || undefined,
				gender: data.gender ? (data.gender as any) : undefined,
				pincode: data.pincode || undefined,
				preferredLanguage: data.preferredLanguage || undefined,
				selectedPillar: data.pillar ? (data.pillar as any) : undefined,
				consentWhatsapp: true,
			}).catch((err) => {
				console.error('[@itti/supabase] Error submitting to database:', err);
			});

			// Dispatch event for modular external integration
			window.dispatchEvent(
				new CustomEvent('itti:form1-complete', {
					detail: payload,
				}),
			);

			// Render Success / Next Step screen
			form.hidden = true;
			if (successView) {
				successView.hidden = false;
				const nameEl = successView.querySelector('[data-success-name]');
				if (nameEl) nameEl.textContent = payload.full_name;

				const summaryEl = successView.querySelector('[data-success-summary]');
				if (summaryEl) {
					summaryEl.innerHTML = `
						<div><strong>Name:</strong> ${payload.full_name}</div>
						<div><strong>Contact:</strong> ${payload.phone || payload.email || 'None'}</div>
						<div><strong>Location:</strong> ${payload.meta.city}, ${payload.meta.state} ${payload.pincode ? '(' + payload.pincode + ')' : ''}</div>
						<div><strong>Role:</strong> ${payload.role || 'Not specified'}</div>
						<div><strong>Area of Interest:</strong> ${payload.meta.selected_pillar.replace('_', ' ').toUpperCase()}</div>
					`;
				}
				successView.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});

		// Success screen actions
		modal
			.querySelector('[data-f1-close-success]')
			?.addEventListener('click', closeModal);
		modal.querySelector('[data-f1-reset]')?.addEventListener('click', () => {
			if (successView) successView.hidden = true;
			form.hidden = false;
			form.reset();
			clearCity();
			renderErrors({});
		});
	}
</script>
