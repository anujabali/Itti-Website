</style>

<script>
	import { searchCities } from './cities';
	import { validateForm1 } from './validation';
	import { persistForm1Data, clearForm1Data } from './schema';
	import { COUNTRIES, findCountry, searchCountries, detectCountryFromInternationalNumber } from './countries';
	import { lookupPincode } from './pincode';
	import { registerMember } from '../../../lib/services/registration';
	import type { Form1Data, Form1Field, Form1Errors } from './types';

	const modal = document.getElementById('form1-modal');
	const form = document.getElementById('form1-element') as HTMLFormElement | null;
	const cityInput = document.querySelector<HTMLInputElement>('[data-city-input]');
	const cityClear = document.querySelector<HTMLElement>('[data-city-clear]');
	const cityHidden = document.getElementById(
		'f1-city-hidden',
	) as HTMLInputElement | null;
	const stateHidden = document.getElementById(
		'f1-state-hidden',
	) as HTMLInputElement | null;
	const suggestionsList = document.querySelector<HTMLUListElement>(
		'[data-city-suggestions]',
	);
	const pincodeInput = document.querySelector<HTMLInputElement>('[data-pincode-input]');
	const pincodeStatus = document.querySelector<HTMLElement>('[data-pincode-status]');
	const phoneInput = document.querySelector<HTMLInputElement>('[data-phone-input]');
	const countryButton = document.querySelector<HTMLButtonElement>('[data-country-button]');
	const countryMenu = document.querySelector<HTMLElement>('[data-country-menu]');
	const countrySearch = document.querySelector<HTMLInputElement>('[data-country-search]');
	const countryList = document.querySelector<HTMLUListElement>('[data-country-list]');
	const countryIso = document.querySelector<HTMLInputElement>('[data-country-iso]');
	const countryFlag = document.querySelector<HTMLElement>('[data-country-flag]');
	const countryName = document.querySelector<HTMLElement>('[data-country-name]');
	const countryDial = document.querySelector<HTMLElement>('[data-country-dial]');
	const languageSelect = document.getElementById('f1-language') as HTMLSelectElement | null;
	const languageOtherContainer = document.querySelector<HTMLElement>('[data-language-other-container]');
	const languageOther = document.querySelector<HTMLInputElement>('[data-language-other]');
	const globalAlert = document.getElementById('f1-global-alert');
	const globalAlertText = document.querySelector<HTMLElement>('[data-f1-global-error]');
	const successView = document.querySelector<HTMLElement>('[data-f1-success]');

	if (modal && form) {
		// No open/close, no focus trap, no scroll lock: the form is the page.
		// It used to intercept every `a[href="/join"]` on the site and open over
		// whatever the visitor was reading, which is why the link never took
		// anyone here.

		// ── Form State & Live Validation ──────────────────────────────────────
		const getFormData = (): Form1Data => {
			const data = new FormData(form);
			return {
				fullName: (data.get('fullName') as string) || '',
				phone: (() => {
					const raw = ((data.get('phone') as string) || '').trim();
					const country = findCountry((data.get('countryIso2') as string) || 'IN');
					if (!raw) return '';
					if (raw.startsWith('+') || raw.startsWith('00')) return raw.replace(/^00/, '+');
					return `${country.dialCode}${raw.replace(/\D/g, '')}`;
				})(),
				countryIso2: (data.get('countryIso2') as string) || 'IN',
				email: (data.get('email') as string) || '',
				dateOfBirth: (data.get('dateOfBirth') as string) || '',
				gender: (data.get('gender') as any) || '',
				genderSelfDescribed: (data.get('genderSelfDescribed') as string) || '',
				// The hidden input holds a chosen suggestion; outside India there are
				// no suggestions to choose, so fall back to what was typed.
				city:
					((data.get('city') as string) || '').trim() ||
					(cityInput?.value || '').trim(),
				state: (data.get('state') as string) || '',
				pincode: (data.get('pincode') as string) || '',
				preferredLanguage: (data.get('preferredLanguage') as any) || '',
				languageOther: (data.get('languageOther') as string) || '',
				role: (data.get('role') as any) || '',
				pillar: (data.get('pillar') as any) || '',
				consentWhatsapp: data.get('consentWhatsapp') === 'yes',
				consentSms: data.get('consentSms') === 'yes',
				consentEmail: data.get('consentEmail') === 'yes',
			};
		};

		const renderErrors = (errors: Form1Errors) => {
			// Clear existing error states
			form.querySelectorAll('.f1-error').forEach((el) => {
				el.textContent = '';
				el.classList.remove('is-visible');
			});
			form.querySelectorAll('.has-error').forEach((el) => {
				el.classList.remove('has-error');
			});

			if (globalAlert && globalAlertText) {
				const errorCount = Object.keys(errors).length;
				if (errorCount > 0) {
					globalAlert.hidden = false;
					globalAlertText.textContent = `Please correct the ${errorCount} highlighted field${errorCount > 1 ? 's' : ''} to continue.`;
				} else {
					globalAlert.hidden = true;
				}
			}

			// Render field-specific errors
			for (const [key, msg] of Object.entries(errors)) {
				const errorEl = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
				if (errorEl && msg) {
					errorEl.textContent = msg;
					errorEl.classList.add('is-visible');
				}

				// Highlight input if applicable
				const fieldContainer = form.querySelector<HTMLElement>(`[data-field="${key}"]`);
				const inputEl = fieldContainer?.querySelector<HTMLElement>('input, select');
				inputEl?.classList.add('has-error');
			}
		};

		// ── Country + phone selector ───────────────────────────────────────────
		let selectedCountry = findCountry(countryIso?.value || 'IN');

		const pincodeField = document.querySelector<HTMLInputElement>('[data-pincode-field]');
		const pincodeLabel = document.querySelector<HTMLElement>('[data-pincode-label]');

		// `pincode` is validated as a six-digit Indian PIN, in the browser and
		// again in the database. Outside India it is a postal code we do not
		// hold a format for, so we stop asking rather than ask for something
		// nobody can supply.
		const syncPostalCode = () => {
			const isIndia = selectedCountry.iso2 === 'IN';
			if (pincodeLabel) {
				pincodeLabel.textContent = isIndia ? 'Pincode' : 'Postal code (optional)';
			}
			if (pincodeField) {
				pincodeField.required = isIndia;
				pincodeField.placeholder = isIndia
					? 'Enter your 6-digit pincode'
					: 'Optional';
				if (!isIndia) {
					pincodeField.value = '';
					if (pincodeStatus) pincodeStatus.textContent = '';
				}
			}
			if (cityInput) {
				cityInput.placeholder = isIndia
					? 'Search your city'
					: 'Enter your city';
			}
		};

		const setCountry = (country: typeof selectedCountry) => {
			selectedCountry = country;
			syncPostalCode();
			if (countryIso) countryIso.value = country.iso2;
			if (countryFlag) countryFlag.textContent = country.flag;
			if (countryName) countryName.textContent = country.name;
			if (countryDial) countryDial.textContent = country.dialCode;
			if (countryButton) countryButton.setAttribute('aria-expanded', 'false');
			if (countryMenu) countryMenu.hidden = true;
		};

		syncPostalCode();

		const renderCountries = (query = '') => {
			if (!countryList) return;
			countryList.innerHTML = '';
			const matches = searchCountries(query).slice(0, 40);
			matches.forEach((country) => {
				const li = document.createElement('li');
				li.className = 'f1-country__item';
				li.setAttribute('role', 'option');
				li.textContent = `${country.flag}  ${country.name} (${country.dialCode})`;
				li.addEventListener('mousedown', (event) => {
					event.preventDefault();
					setCountry(country);
				});
				countryList.appendChild(li);
			});
			if (!matches.length) {
				const empty = document.createElement('li');
				empty.className = 'f1-country__empty';
				empty.textContent = 'No country found';
				countryList.appendChild(empty);
			}
		};

		renderCountries();
		setCountry(selectedCountry);

		countryButton?.addEventListener('click', () => {
			const opening = !!countryMenu?.hidden;
			if (countryMenu) countryMenu.hidden = !opening;
			countryButton.setAttribute('aria-expanded', String(opening));
			if (opening) {
				renderCountries(countrySearch?.value || '');
				setTimeout(() => countrySearch?.focus(), 0);
			}
		});

		countrySearch?.addEventListener('input', () => renderCountries(countrySearch.value));
		document.addEventListener('click', (event) => {
			if (!countryMenu || !countryButton) return;
			const target = event.target as Node;
			if (!countryMenu.contains(target) && !countryButton.contains(target)) {
				countryMenu.hidden = true;
				countryButton.setAttribute('aria-expanded', 'false');
			}
		});

		phoneInput?.addEventListener('input', () => {
			const value = phoneInput.value.trim();
			const detected = detectCountryFromInternationalNumber(value);
			if (detected && detected.iso2 !== selectedCountry.iso2) setCountry(detected);
		});

		// ── City autocomplete + pincode lookup ───────────────────────────────
		let activeSuggestionIndex = -1;

		const closeSuggestions = () => {
			if (suggestionsList) {
				suggestionsList.hidden = true;
				suggestionsList.innerHTML = '';
				activeSuggestionIndex = -1;
			}
		};

		const selectCity = (city: string, state: string) => {
			if (cityInput && cityHidden && stateHidden) {
				cityInput.value = state ? `${city}, ${state}` : city;
				cityHidden.value = city;
				stateHidden.value = state;
				if (cityClear) cityClear.hidden = false;
				closeSuggestions();
				const cityError = form.querySelector('[data-error="city"]');
				cityError?.classList.remove('is-visible');
				cityInput.classList.remove('has-error');
				setTimeout(() => pincodeInput?.focus(), 150);
			}
		};

		const clearCity = () => {
			if (cityInput && cityHidden && stateHidden) {
				cityInput.value = '';
				cityHidden.value = '';
				stateHidden.value = '';
				if (cityClear) cityClear.hidden = true;
				closeSuggestions();
				cityInput.focus();
			}
		};

		const renderSuggestions = (query: string) => {
			if (!suggestionsList) return;
			const matches = searchCities(query);
			if (matches.length === 0) {
				suggestionsList.innerHTML = `<li class="f1-suggestion-item" style="color: var(--ink-faint); font-style: italic; cursor: default;">No matching Indian city found. You can type your city.</li>`;
				suggestionsList.hidden = false;
				return;
			}
			suggestionsList.innerHTML = '';
			matches.forEach((item, index) => {
				const li = document.createElement('li');
				li.className = 'f1-suggestion-item';
				li.setAttribute('role', 'option');
				li.setAttribute('data-index', String(index));
				li.innerHTML = `<span class="f1-suggestion-item__city">${item.city}</span><span class="f1-suggestion-item__state">${item.state}</span>`;
				li.addEventListener('mousedown', (e) => {
					e.preventDefault();
					selectCity(item.city, item.state);
				});
				suggestionsList.appendChild(li);
			});
			suggestionsList.hidden = false;
		};

		cityInput?.addEventListener('input', () => {
			const val = cityInput.value.trim();
			if (cityClear) cityClear.hidden = val.length === 0;
			if (cityHidden) cityHidden.value = '';
			if (stateHidden) stateHidden.value = '';
			if (val.length >= 1) renderSuggestions(val);
			else closeSuggestions();
		});
		cityClear?.addEventListener('click', clearCity);

		cityInput?.addEventListener('keydown', (e) => {
			if (!suggestionsList || suggestionsList.hidden) return;
			const items = [...suggestionsList.querySelectorAll<HTMLElement>('.f1-suggestion-item[data-index]')];
			if (!items.length) return;
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activeSuggestionIndex = (activeSuggestionIndex + 1) % items.length;
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activeSuggestionIndex = (activeSuggestionIndex - 1 + items.length) % items.length;
			} else if (e.key === 'Enter' && activeSuggestionIndex >= 0) {
				e.preventDefault();
				items[activeSuggestionIndex]?.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
				return;
			} else if (e.key === 'Escape') {
				closeSuggestions();
				return;
			} else return;
			items.forEach((item, i) => item.classList.toggle('is-selected', i === activeSuggestionIndex));
			items[activeSuggestionIndex]?.scrollIntoView({ block: 'nearest' });
		});
		cityInput?.addEventListener('blur', () => setTimeout(closeSuggestions, 200));

		let pincodeTimer: ReturnType<typeof setTimeout> | undefined;
		let pincodeRequest = 0;
		pincodeInput?.addEventListener('input', () => {
			pincodeInput.value = pincodeInput.value.replace(/\D/g, '').slice(0, 6);
			if (pincodeStatus) pincodeStatus.textContent = '';
			if (pincodeTimer) clearTimeout(pincodeTimer);
			if (pincodeInput.value.length !== 6) return;

			const requestId = ++pincodeRequest;
			pincodeTimer = setTimeout(async () => {
				if (pincodeStatus) pincodeStatus.textContent = 'Finding your area…';
				const result = await lookupPincode(pincodeInput.value);
				if (requestId !== pincodeRequest) return;
				if (!result) {
					if (pincodeStatus) pincodeStatus.textContent = 'We could not find that pincode. Please check it or enter your city manually.';
					return;
				}
				// Fill the city only if it is still empty. Someone who has already
				// chosen "Mumbai" should not have it silently rewritten to whichever
				// district the postal API returns.
				const cityAlreadyGiven = Boolean((cityInput?.value || '').trim());
				if (cityInput && cityHidden && stateHidden && !cityAlreadyGiven) {
					cityInput.value = result.city;
					cityHidden.value = result.city;
					stateHidden.value = result.state;
					if (cityClear) cityClear.hidden = false;
				} else if (stateHidden && !stateHidden.value) {
					stateHidden.value = result.state;
				}

				if (pincodeStatus) {
					const place = [result.city, result.state].filter(Boolean).join(', ');
					pincodeStatus.textContent = cityAlreadyGiven
						? `Pincode matches ${place}.`
						: `Location detected: ${place}`;
				}
				form.querySelector('[data-error="pincode"]')?.classList.remove('is-visible');
				pincodeInput.classList.remove('has-error');
				cityInput?.classList.remove('has-error');
			}, 450);
		});

		// ── Self-described gender ─────────────────────────────────────────────
		const genderSelect = document.getElementById('f1-gender') as HTMLSelectElement | null;
		const genderSelf = document.querySelector<HTMLInputElement>('[data-gender-self]');

		const syncGenderSelf = () => {
			const show = genderSelect?.value === 'self_described';
			if (genderSelf) {
				genderSelf.hidden = !show;
				if (!show) genderSelf.value = '';
			}
		};
		genderSelect?.addEventListener('change', syncGenderSelf);
		syncGenderSelf();

		// ── Other language ────────────────────────────────────────────────────
		const syncOtherLanguage = () => {
			const show = languageSelect?.value === 'other';
			if (languageOtherContainer) languageOtherContainer.hidden = !show;
			if (languageOther) {
				languageOther.required = !!show;
				if (!show) languageOther.value = '';
			}
		};
		languageSelect?.addEventListener('change', syncOtherLanguage);
		syncOtherLanguage();

		// Browser spellcheck can underline misspellings, but it does not reliably
		// autocorrect free-form language names. Add a small, conservative
		// autocorrection layer for common typos and supported language names.
		const languageCorrections: Record<string, string> = {
			anglish: 'English',
			englsh: 'English',
			engish: 'English',
			hindii: 'Hindi',
			hind: 'Hindi',
			marathii: 'Marathi',
			gujrati: 'Gujarati',
			gujarathi: 'Gujarati',
			bengali: 'Bengali',
			telgu: 'Telugu',
			teluguu: 'Telugu',
			kannada: 'Kannada',
			malayalam: 'Malayalam',
			punjabi: 'Punjabi',
			panjabi: 'Punjabi',
			urdu: 'Urdu',
			odia: 'Odia',
			oriya: 'Odia',
			assamese: 'Assamese',
		};

		const normaliseLanguageKey = (value: string) =>
			value.trim().toLowerCase().replace(/\s+/g, ' ');

		const correctLanguageInput = () => {
			if (!languageOther || languageSelect?.value !== 'other') return;
			const original = languageOther.value;
			const key = normaliseLanguageKey(original);
			const correction = languageCorrections[key];
			if (correction && original !== correction) {
				languageOther.value = correction;
				languageOther.setSelectionRange(correction.length, correction.length);
			}
		};

		languageOther?.addEventListener('input', correctLanguageInput);
		languageOther?.addEventListener('blur', correctLanguageInput);

		// ── Live clearing of errors on user input ──────────────────────────────
		form.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			if (!target) return;
			const name = target.name as Form1Field;
			if (name) {
				const errorEl = form.querySelector(`[data-error="${name}"]`);
				errorEl?.classList.remove('is-visible');
				target.classList.remove('has-error');

				if (name === 'phone' || name === 'email') {
					form.querySelector('[data-error="contact"]')?.classList.remove('is-visible');
				}
			}
		});

		// ── Form Submission Handler ──────────────────────────────────────────
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = getFormData();
			const { isValid, errors } = validateForm1(data);

			if (!isValid) {
				renderErrors(errors);
				// Scroll to first error
				const firstErrorField = form.querySelector('.has-error, .is-visible');
				firstErrorField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}

			// Clear errors
			renderErrors({});

			// Disable submit button while saving
			const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const originalBtnHtml = submitBtn ? submitBtn.innerHTML : 'Continue';
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.innerHTML = `<span>Saving...</span>`;
			}

			// Map & persist to safe browser session storage (matches Supabase schema)
			const payload = persistForm1Data(data);

			// The form says "supporter"; the schema's enum says "volunteer".
			const dbRole = data.role === 'supporter' ? 'volunteer' : data.role || 'other';

			try {
				const result = await registerMember({
					fullName: data.fullName,
					city: data.city,
					role: dbRole,
					email: data.email || undefined,
					phone: data.phone || undefined,
					dateOfBirth: data.dateOfBirth || undefined,
					gender: data.gender ? (data.gender as any) : undefined,
					genderSelfDescribed: data.genderSelfDescribed || undefined,
					pincode: data.pincode || undefined,
					// "other" is the select's own bookkeeping, not an answer. Send what
					// they actually typed, or `preferred_language` stores the word
					// "other" and the language is lost.
					preferredLanguage:
						(data.preferredLanguage === 'other'
							? data.languageOther?.trim()
							: data.preferredLanguage) || undefined,
					selectedPillar: data.pillar ? (data.pillar as any) : undefined,
					consentWhatsapp: data.consentWhatsapp,
					consentSms: data.consentSms,
					consentEmail: data.consentEmail,
				});

				if (!result.success) {
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.innerHTML = originalBtnHtml;
					}

					// The service names the field it rejected. Matching on the text of
					// the message instead meant that rewording a message silently
					// broke the highlighting — and the duplicate-contact message is
					// deliberately vague about which field matched, so there is no
					// field name in it to find.
					const fieldErrors: Form1Errors = {};
					for (const [key, message] of Object.entries(result.errors || {})) {
						if (form.querySelector(`[data-error="${key}"]`)) {
							fieldErrors[key as keyof Form1Errors] = message;
						}
					}

					if (Object.keys(fieldErrors).length > 0) {
						renderErrors(fieldErrors);
					}

					if (globalAlert && globalAlertText) {
						globalAlert.hidden = false;
						globalAlertText.textContent =
							result.message || 'Registration failed. Please check your details.';
						globalAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
					}
					return;
				}
			} catch (err: any) {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.innerHTML = originalBtnHtml;
				}
				if (globalAlert && globalAlertText) {
					globalAlert.hidden = false;
					globalAlertText.textContent =
						err?.message || 'Network error occurred while connecting to database. Please try again.';
					globalAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
				return;
			}

			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.innerHTML = originalBtnHtml;
			}

			// The record is on the server now, so the copy in this browser is just
			// personal data left lying on a possibly shared device.
			clearForm1Data();

			// Dispatch event for modular external integration
			window.dispatchEvent(
				new CustomEvent('itti:form1-complete', {
					detail: payload,
				}),
			);

			// Render Success / Next Step screen
			form.hidden = true;
			if (successView) {
				successView.hidden = false;
				const nameEl = successView.querySelector('[data-success-name]');
				if (nameEl) nameEl.textContent = payload.full_name;

				const summaryEl = successView.querySelector('[data-success-summary]');
				if (summaryEl) {
					// textContent, not innerHTML: `full_name` and `city` are free text
					// the visitor typed, and a name containing markup would otherwise
					// be parsed as markup.
					const rows: Array<[string, string]> = [
						['Name', payload.full_name],
						['Contact', payload.phone || payload.email || 'None'],
						[
							'Location',
							[payload.meta.city, payload.meta.state].filter(Boolean).join(', ') +
								(payload.pincode ? ` (${payload.pincode})` : ''),
						],
						['Role', payload.role || 'Not specified'],
						['Area of interest', payload.meta.selected_pillar.replace(/_/g, ' ')],
					];

					summaryEl.replaceChildren(
						...rows.map(([label, value]) => {
							const row = document.createElement('div');
							const strong = document.createElement('strong');
							strong.textContent = `${label}: `;
							row.append(strong, document.createTextNode(value));
							return row;
						}),
					);
				}

				successView.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});

		// A caregiver registering more than one person should not have to reload.
		modal.querySelector('[data-f1-reset]')?.addEventListener('click', () => {
			if (successView) successView.hidden = true;
			form.hidden = false;
			form.reset();
			clearCity();
			renderErrors({});
		});
	}
</script>
