// Cloudflare, for a site that is only files.
//
// Written by hand rather than generated. `wrangler pages project create`
// detects Astro and offers to install its Cloudflare adapter, which converts
// the site to server-side rendering — a worker in front of every page, for a
// site that has no server-side anything. It also stops `_headers` being read,
// because the assets then go through the worker instead of the CDN, which
// silently took the Content-Security-Policy off every response.
//
// So: no `main`, no adapter, no runtime. `dist` is uploaded as it is built,
// `_headers` is honoured, and an address that matches nothing gets the 404 the
// site already writes in its own voice.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "itti-web",
	"compatibility_date": "2026-09-09",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// The domain is attached here rather than clicked into the dashboard, so it
	// moves with the repository like the build settings did. Both hostnames are
	// custom domains rather than routes: a route needs a worker in front of an
	// existing origin, and there is no origin — the worker is the whole site.
	// Adding routes turns the workers.dev hostname off unless it is asked for
	// back. It is worth keeping: it is how the site can be checked on Cloudflare
	// while the domain still points somewhere else, and it stays a way in if the
	// custom domain is ever the thing that is broken.
	"workers_dev": true,
	"routes": [
		{ "pattern": "itti.org.in", "custom_domain": true },
		{ "pattern": "www.itti.org.in", "custom_domain": true }
	],
	"observability": { "enabled": true }
}
